<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KeePassModern.Controls"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeePassModern.Views.SettingsWindow"
        Title="偏好设置"
        Width="920" Height="720" MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="48"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">


    <Grid ColumnDefinitions="220,1,*">
        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}">
            <Grid RowDefinitions="48,Auto,*">
                <Border Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar"
                        PointerPressed="TitleBar_PointerPressed">
                    <StackPanel x:Name="DesktopSettingsChrome" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BackButton" Classes="subtle" Width="48" Height="48" MinWidth="0" Padding="0" CornerRadius="0"
                                Click="Back_Click" AutomationProperties.Name="返回" ToolTip.Tip="返回">
                            <PathIcon Data="{StaticResource IconBack}" Width="16" Height="16" />
                        </Button>
                        <controls:BrandLogo Width="20" Height="20" />
                        <TextBlock Text="KeePassModern" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="1" Text="{DynamicResource Str_SettingsTitle}" FontSize="28" FontWeight="SemiBold" Margin="20,20,16,24" />

                <StackPanel Grid.Row="2" Spacing="4" Margin="10,0">
                    <Button x:Name="NavAppearance" Classes="navItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="40" Click="NavClick" Tag="0">
                        <Grid ColumnDefinitions="6, 26, *">
                            <Border x:Name="Ind0" Grid.Column="0" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Left" />
                            <PathIcon Grid.Column="1" Data="{StaticResource IconSettings}" Width="16" Height="16" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_NavAppearance}" FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="NavSecurity" Classes="navItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="40" Click="NavClick" Tag="1">
                        <Grid ColumnDefinitions="6, 26, *">
                            <Border x:Name="Ind1" Grid.Column="0" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Left" IsVisible="False" />
                            <PathIcon Grid.Column="1" Data="{StaticResource IconShield}" Width="16" Height="16" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_NavSecurity}" FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="NavAutoType" Classes="navItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="40" Click="NavClick" Tag="2">
                        <Grid ColumnDefinitions="6, 26, *">
                            <Border x:Name="Ind2" Grid.Column="0" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Left" IsVisible="False" />
                            <PathIcon Grid.Column="1" Data="{StaticResource IconKey}" Width="16" Height="16" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_NavAutoType}" FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="NavData" Classes="navItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="40" Click="NavClick" Tag="3">
                        <Grid ColumnDefinitions="6, 26, *">
                            <Border x:Name="Ind3" Grid.Column="0" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Left" IsVisible="False" />
                            <PathIcon Grid.Column="1" Data="{StaticResource IconExport}" Width="16" Height="16" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_NavData}" FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Button x:Name="NavAbout" Classes="navItem" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="40" Click="NavClick" Tag="4">
                        <Grid ColumnDefinitions="6, 26, *">
                            <Border x:Name="Ind4" Grid.Column="0" Width="3" Height="16" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}" HorizontalAlignment="Left" IsVisible="False" />
                            <PathIcon Grid.Column="1" Data="{StaticResource IconVault}" Width="16" Height="16" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_NavAbout}" FontSize="14" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 垂直分割线直通顶部 -->
        <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

        <!-- 右侧内容区 -->
        <Grid Grid.Column="2" RowDefinitions="48,*" Background="{DynamicResource ListPaneBackgroundBrush}">
            <!-- 顶部拖动区 -->
            <Border Grid.Row="0" Background="Transparent"
                    chrome:WindowDecorationProperties.ElementRole="TitleBar"
                    PointerPressed="TitleBar_PointerPressed" />

            <ScrollViewer Grid.Row="1" Padding="28,20,28,28">
                <Panel>
                    <StackPanel x:Name="PageAppearance" Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="外观" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="调整主题、强调色和条目列表的显示密度。" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="主题与颜色" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <Border Classes="fluentCard" Padding="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="应用主题" FontWeight="SemiBold" />
                                    <TextBlock Text="用于应用的窗口、菜单和对话框。" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="ThemeCombo" Grid.Column="1" Width="156" VerticalAlignment="Center"
                                          AutomationProperties.Name="应用主题" SelectionChanged="ThemeCombo_Changed">
                                    <ComboBoxItem Content="跟随系统" Tag="Default" />
                                    <ComboBoxItem Content="浅色" Tag="Light" />
                                    <ComboBoxItem Content="深色" Tag="Dark" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Classes="fluentCard" Padding="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="跟随系统强调色" FontWeight="SemiBold" />
                                    <TextBlock Text="开启后使用操作系统的强调色。" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="FollowSystemAccentCheck" OnContent="" OffContent=""
                                              AutomationProperties.Name="跟随系统强调色" IsCheckedChanged="FollowSystemAccent_Changed" />
                            </Grid>
                        </Border>
                        <Border Classes="fluentCard" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="应用强调色" FontWeight="SemiBold" />
                                <UniformGrid Columns="7" Rows="1">
                                    <Button Classes="subtle" Padding="4,6" Click="AccentPreset_Click" Tag="Emerald">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <Border x:Name="RingEmerald" Width="28" Height="28" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                <Border CornerRadius="4" Background="#508252" />
                                            </Border>
                                            <TextBlock Text="#508252" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle" Padding="4,6" Click="AccentPreset_Click" Tag="ClassicBlue">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <Border x:Name="RingClassicBlue" Width="28" Height="28" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                <Border CornerRadius="4" Background="#3B82F6" />
                                            </Border>
                                            <TextBlock Text="经典蓝" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle" Padding="4,6" Click="AccentPreset_Click" Tag="Indigo">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <Border x:Name="RingIndigo" Width="28" Height="28" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                <Border CornerRadius="4" Background="#6366F1" />
                                            </Border>
                                            <TextBlock Text="极光靛" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle" Padding="4,6" Click="AccentPreset_Click" Tag="Amber">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <Border x:Name="RingAmber" Width="28" Height="28" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                <Border CornerRadius="4" Background="#D97706" />
                                            </Border>
                                            <TextBlock Text="琥珀金" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle" Padding="4,6" Click="AccentPreset_Click" Tag="Rose">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <Border x:Name="RingRose" Width="28" Height="28" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                <Border CornerRadius="4" Background="#E11D48" />
                                            </Border>
                                            <TextBlock Text="玫瑰红" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="subtle" Padding="4,6" Click="AccentPreset_Click" Tag="Slate">
                                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                                            <Border x:Name="RingSlate" Width="28" Height="28" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                                <Border CornerRadius="4" Background="#64748B" />
                                            </Border>
                                            <TextBlock Text="石墨灰" FontSize="11" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,6,0,0">
                                        <ColorPicker x:Name="CustomAccentPicker" Color="#508252" Width="32" Height="28" ColorChanged="CustomAccent_Changed" />
                                        <TextBlock Text="自定义" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="布局" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <Border Classes="fluentCard" Padding="16">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="条目列表密度" FontWeight="SemiBold" />
                                    <TextBlock Text="改变列表行高和摘要间距。" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <ComboBox x:Name="DensityCombo" Grid.Column="1" Width="156" VerticalAlignment="Center"
                                          AutomationProperties.Name="条目列表密度" SelectionChanged="DensityCombo_Changed">
                                    <ComboBoxItem Content="紧凑" Tag="Compact" />
                                    <ComboBoxItem Content="标准" Tag="Normal" />
                                    <ComboBoxItem Content="宽松" Tag="Comfortable" />
                                </ComboBox>
                            </Grid>
                        </Border>
                        <Border Classes="fluentCard" Padding="16">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="界面语言 / Display Language" FontSize="13.5" FontWeight="SemiBold" />
                                    <TextBlock Text="切换简体中文或英文界面，立即生效无需重启" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="LanguageCombo" Width="170" Height="32" VerticalAlignment="Center" SelectionChanged="LanguageCombo_Changed">
                                    <ComboBoxItem Content="简体中文 (zh-CN)" Tag="zh-CN" />
                                    <ComboBoxItem Content="English (en-US)" Tag="en-US" />
                                </ComboBox>
                            </Grid>
                        </Border>

                    </StackPanel>

                    <!-- ========== 页面 1：安全与锁定 ========== -->
                    <StackPanel x:Name="PageSecurity" Spacing="16" IsVisible="False">
                        <TextBlock Text="安全与自动锁定" FontSize="20" FontWeight="SemiBold" />
                        <Border Classes="fluentCard" Padding="18">
                            <StackPanel Spacing="14">
                                <Grid ColumnDefinitions="*, 120">
                                    <StackPanel>
                                        <TextBlock Text="安全剪贴板自动清空时间（秒）" FontWeight="Medium" />
                                        <TextBlock Text="复制密码或验证码后，倒计时结束自动清零剪贴板" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <NumericUpDown Grid.Column="1" x:Name="ClipClearNumeric" Minimum="5" Maximum="120" Value="15" ValueChanged="SecurityChanged" />
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel>
                                        <TextBlock Text="启用无操作自动锁定" FontWeight="Medium" />
                                        <TextBlock Text="长时间无鼠标或键盘操作时自动锁定全部已打开的密码库" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" x:Name="AutoLockEnabledSwitch" OnContent="" OffContent="" VerticalAlignment="Center" IsCheckedChanged="AutoLockEnabled_Changed" />
                                </Grid>
                                <Grid ColumnDefinitions="*, 120">
                                    <StackPanel>
                                        <TextBlock Text="空闲自动锁定时间（分钟）" FontWeight="Medium" />
                                        <TextBlock Text="超过指定空闲时间后自动锁定并清零内存敏感数据" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <NumericUpDown Grid.Column="1" x:Name="AutoLockNumeric" Minimum="1" Maximum="120" Value="10" ValueChanged="SecurityChanged" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 页面 2：自动输入热键 ========== -->
                    <StackPanel x:Name="PageAutoType" Spacing="16" IsVisible="False">
                        <TextBlock Text="自动输入与快捷键" FontSize="20" FontWeight="SemiBold" />
                        <Border Classes="fluentCard" Padding="18">
                            <StackPanel Spacing="10">
                                <TextBlock Text="应用内全局快捷键" FontWeight="SemiBold" />
                                <TextBlock Text="• 搜索密码库：⌘K / Ctrl+K" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="• 新建密码条目：⌘N / Ctrl+N" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="• 保存当前密码库：⌘S / Ctrl+S" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="• 立即锁定密码库：⌘L / Ctrl+L" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 页面 3：同步与导入导出 ========== -->
                    <StackPanel x:Name="PageData" Spacing="16" IsVisible="False">
                        <TextBlock Text="同步与导入导出" FontSize="20" FontWeight="SemiBold" />
                        <Border Classes="fluentCard" Padding="18">
                            <StackPanel Spacing="12">
                                <TextBlock Text="数据迁移与纸质应急备份" FontWeight="SemiBold" />
                                <TextBlock Text="支持 Chrome / Firefox / Bitwarden / 1Password 通用 CSV 导入，以及导出可打印 HTML 应急表。" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Content="导入 CSV" Click="ImportCsv_Click" />
                                    <Button Content="导出 CSV" Click="ExportCsv_Click" />
                                    <Button Classes="accent" Content="生成 HTML 应急表" Click="ExportEmergency_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ========== 页面 4：关于与更新 ========== -->
                    <StackPanel x:Name="PageAbout" Spacing="16" IsVisible="False">
                        <TextBlock Text="关于 KeePassModern" FontSize="20" FontWeight="SemiBold" />
                        <Border Classes="fluentCard" Padding="20">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <controls:BrandLogo Width="48" Height="48" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="AboutVersionText" Text="KeePassModern 1.0.0" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="基于 Avalonia 12 + .NET 10 + NativeAOT 构建" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="完全兼容 KeePass KDBX 3.1 / 4.0 / 4.1 密码库格式，采用纯托管零反射密码学引擎（Argon2id / Argon2d / AES-256 / ChaCha20 / Twofish）与 Microsoft Fluent 2 设计语言。" FontSize="13" LineHeight="20" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                                    <Button Classes="accent" Height="32" Content="检查更新" Click="CheckUpdate_Click" />
                                    <Button Height="32" Content="访问 GitHub 仓库" Click="OpenGitHub_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Panel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
