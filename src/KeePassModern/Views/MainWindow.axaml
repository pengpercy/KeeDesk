<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeePassModern.ViewModels"
        xmlns:controls="using:KeePassModern.Controls"
        xmlns:helpers="using:KeePassModern.Helpers"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeePassModern.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="KeePassModern"
        Icon="/Assets/Branding/app_ico.ico"
        Width="1280" Height="820"
        MinWidth="720" MinHeight="640"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="48"
        DragDrop.AllowDrop="True"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <!-- macOS 原生顶部菜单栏（文件 / 条目 / 工具 / 视图） -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="文件">
                <NativeMenu>
                    <NativeMenuItem Header="打开其他密码库（新标签页）..." Gesture="Cmd+O" Command="{Binding OpenAnotherVaultCommand}" />
                    <NativeMenuItem Header="新建密码库..." Gesture="Shift+Cmd+N" Command="{Binding CreateNewVaultCommand}" />
                    <NativeMenuItem Header="保存密码库" Gesture="Cmd+S" Command="{Binding SaveVaultCommand}" />
                    <NativeMenuItem Header="另存为..." Gesture="Shift+Cmd+S" Command="{Binding SaveVaultAsCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="密码库设置与主密钥..." Command="{Binding OpenDatabaseSettingsAsyncCommandCommand}" />
                    <NativeMenuItem Header="密码库维护工具..." Command="{Binding OpenDatabaseMaintenanceAsyncCommandCommand}" />
                    <NativeMenuItem Header="合并 / 同步其他密码库..." Command="{Binding MergeDatabaseCommand}" />
                    <NativeMenuItem Header="生成密钥文件 (.keyx)..." Command="{Binding GenerateKeyFileCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="导入 CSV (通用/Chrome/Bitwarden/1Password)..." Command="{Binding ImportCsvCommand}" />
                    <NativeMenuItem Header="导入 KeePass 2.x XML..." Command="{Binding ImportKeePassXmlCommand}" />
                    <NativeMenuItem Header="导出 CSV..." Command="{Binding ExportCsvCommand}" />
                    <NativeMenuItem Header="导出 KeePass 2.x XML..." Command="{Binding ExportKeePassXmlCommand}" />
                    <NativeMenuItem Header="生成 HTML 应急表..." Command="{Binding ExportEmergencySheetCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="关闭当前密码库标签页" Command="{Binding CloseVaultTabCommand}" />
                    <NativeMenuItem Header="锁定全部密码库" Gesture="Cmd+L" Command="{Binding LockVaultCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="条目">
                <NativeMenu>
                    <NativeMenuItem Header="新建" Gesture="Cmd+N" Command="{Binding AddEntryCommand}" />
                    <NativeMenuItem Header="编辑选中条目" Gesture="Cmd+E" Command="{Binding EditSelectedEntryCommand}" />
                    <NativeMenuItem Header="克隆选中条目" Gesture="Cmd+D" Command="{Binding DuplicateEntryCommand}" />
                    <NativeMenuItem Header="收藏 / 取消收藏" Command="{Binding ToggleFavoriteSelectedCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="复制用户名" Gesture="Cmd+B" Command="{Binding CopyUserNameCommand}" />
                    <NativeMenuItem Header="复制密码" Gesture="Shift+Cmd+C" Command="{Binding CopyPasswordCommand}" />
                    <NativeMenuItem Header="复制动态验证码" Gesture="Shift+Cmd+T" Command="{Binding CopyTotpCommand}" />
                    <NativeMenuItem Header="在浏览器打开网址" Gesture="Cmd+U" Command="{Binding OpenEntryUrlCommand}" />
                    <NativeMenuItem Header="执行自动输入 (Auto-Type)" Command="{Binding PerformAutoTypeCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="还原选中条目" Command="{Binding RestoreSelectedEntryCommand}" />
                    <NativeMenuItem Header="删除 / 移入回收站" Command="{Binding DeleteSelectedEntryCommand}" />
                    <NativeMenuItem Header="清空回收站" Command="{Binding EmptyRecycleBinCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="工具">
                <NativeMenu>
                    <NativeMenuItem Header="新建根分组..." Command="{Binding AddRootGroupCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="强密码生成器" Gesture="Cmd+G" Command="{Binding OpenPasswordGeneratorCommandCommand}" />
                    <NativeMenuItem Header="安全审计仪表盘" Command="{Binding SelectSectionCommand}" CommandParameter="SecurityAudit" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="查找">
                <NativeMenu>
                    <NativeMenuItem Header="快速搜索" Gesture="Cmd+K" Command="{Binding FocusSearchCommand}" />
                    <NativeMenuItem Header="高级查找（支持正则）..." Gesture="Cmd+F" Command="{Binding OpenAdvancedSearchAsyncCommandCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="已过期条目" Command="{Binding ShowQuickFilterCommand}" CommandParameter="Expired" />
                    <NativeMenuItem Header="7 天内即将过期" Command="{Binding ShowQuickFilterCommand}" CommandParameter="Expiring7" />
                    <NativeMenuItem Header="30 天内即将过期" Command="{Binding ShowQuickFilterCommand}" CommandParameter="Expiring30" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="最近修改的条目" Command="{Binding ShowQuickFilterCommand}" CommandParameter="LastModified" />
                    <NativeMenuItem Header="大体积 / 含附件条目" Command="{Binding ShowQuickFilterCommand}" CommandParameter="Large" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="视图">
                <NativeMenu>
                    <NativeMenuItem Header="搜索密码库" Gesture="Cmd+K" Command="{Binding FocusSearchCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="全部条目" Command="{Binding SelectSectionCommand}" CommandParameter="AllEntries" />
                    <NativeMenuItem Header="收藏夹" Command="{Binding SelectSectionCommand}" CommandParameter="Favorites" />
                    <NativeMenuItem Header="动态验证码 (2FA)" Command="{Binding SelectSectionCommand}" CommandParameter="TotpOnly" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="切换界面密度（紧凑 / 标准 / 宽松）" Command="{Binding CycleDensityCommand}" />
                    <NativeMenuItem Header="切换排序方式" Command="{Binding ToggleSortOrderCommand}" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Resources>
        <DataTemplate x:Key="VaultPickerTemplate" x:DataType="vm:MainWindowViewModel">
            <StackPanel MinWidth="192" Spacing="4">
                <ListBox ItemsSource="{Binding OpenVaults}" SelectionChanged="VaultPicker_SelectionChanged"
                         Background="Transparent" MaxHeight="240" AutomationProperties.Name="切换密码库">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:VaultTabSession">
                            <Grid ColumnDefinitions="20,*" Margin="4,0">
                                <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" IsVisible="{Binding IsActive}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Separator />
                <Button Classes="subtle" Command="{Binding OpenAnotherVaultCommand}" Content="打开其他密码库" HorizontalAlignment="Stretch" />
                <Button Classes="subtle" Command="{Binding CloseVaultTabCommand}" Content="关闭当前密码库" HorizontalAlignment="Stretch" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SearchSuggestionTemplate" x:DataType="vm:EntryItemViewModel">
            <StackPanel Spacing="2" Margin="4,2">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding UserName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AuditFindingTemplate" x:DataType="vm:EntryItemViewModel">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,7">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UserName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding GroupPath}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="subtle" Content="打开条目"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).JumpToAuditEntryCommand}"
                            CommandParameter="{Binding}" Click="AuditEntry_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 解锁丝滑转场过渡样式（纯 GPU Opacity + Transform 60/120fps 合成） -->
    <Window.Styles>
        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Window).mica">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.desktopTitleSurface">
            <Setter Property="Background" Value="{DynamicResource TitleBarBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Window).mica Border.desktopTitleSurface">
            <Setter Property="Background" Value="{DynamicResource MicaTintBrush}" />
        </Style>
        <Style Selector="Border#WorkspaceSidebar">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Window).mica Border#WorkspaceSidebar">
            <Setter Property="Background" Value="{DynamicResource MicaTintBrush}" />
        </Style>
        <Style Selector="Grid#UnlockStage">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="IsEnabled" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.30" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid#UnlockStage.hidden">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(1.035)" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>

        <Style Selector="Grid#WorkspaceStage">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateY(10px) scale(0.985)" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.32" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.36" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid#WorkspaceStage.visible">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="translateY(0px) scale(1)" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="IsEnabled" Value="True" />
        </Style>

        <Style Selector="Expander.unlockOptions /template/ ToggleButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.recentList ListBoxItem:selected Border.entryIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.chromeBack">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="47" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.vaultPicker">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBackgroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Border.vaultTab.active">
            <Setter Property="Background" Value="{DynamicResource ListPaneBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector=":is(Control).compactOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window).compactChrome :is(Control).compactOnly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(Window).compactChrome StackPanel#DesktopVaultTabs, :is(Window).compactChrome :is(Control).wideOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Control).compactExpandedOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window).compactChrome:not(.rail) :is(Control).compactExpandedOnly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(Control).railOnly, :is(Window).rail :is(Control).expandedOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window).rail :is(Control).railOnly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(Window).rail Border#WorkspaceSidebar Button.navItem">
            <Setter Property="Padding" Value="5,0" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Height="48" IsVisible="{Binding IsWindowsOrLinux}" Classes="desktopTitleSurface"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="WorkspaceBackButton" Classes="subtle chromeBack" IsVisible="False" Click="WorkspaceBack_Click"
                            ToolTip.Tip="返回" AutomationProperties.Name="返回">
                        <PathIcon Data="{StaticResource IconBack}" Width="16" Height="16" />
                    </Button>
                    <controls:BrandLogo Width="20" Height="20" Margin="16,0,0,0" />
                    <TextBlock Text="KeePassModern" FontSize="14" Margin="4,0,0,0" IsVisible="{Binding !IsUnlocked}" VerticalAlignment="Center" />
                    <Panel IsVisible="{Binding IsUnlocked}">
                    <StackPanel x:Name="DesktopVaultTabs" Classes="wideOnly" Orientation="Horizontal" Spacing="4">
                        <Button Classes="subtle chromeCommand" Click="ToggleSidebar_Click" ToolTip.Tip="切换导航栏" AutomationProperties.Name="切换导航栏">
                            <PathIcon Data="{StaticResource IconPanel}" Width="16" Height="16" />
                        </Button>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="292">
                            <ItemsControl ItemsSource="{Binding OpenVaults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VaultTabSession">
                                        <Border Classes="vaultTab" Classes.active="{Binding IsActive}" Width="144">
                                            <Grid ColumnDefinitions="*,28">
                                                <Button Classes="subtle" Padding="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SwitchVaultTabCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding DisplayName}">
                                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                                        <PathIcon Data="{StaticResource IconVault}" Width="16" Height="16" />
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1" Classes="subtle" Width="28" MinWidth="0" Padding="0"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseVaultTabCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="关闭密码库" AutomationProperties.Name="关闭密码库">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Classes="subtle chromeCommand" Command="{Binding OpenAnotherVaultCommand}" ToolTip.Tip="打开其他密码库" AutomationProperties.Name="打开其他密码库">
                            <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="DesktopVaultPicker" Classes="subtle vaultPicker compactOnly" MaxWidth="144"
                            ToolTip.Tip="切换密码库" AutomationProperties.Name="切换密码库">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VaultPickerTemplate}" />
                            </Flyout>
                        </Button.Flyout>
                        <Grid ColumnDefinitions="16,*,16" ColumnSpacing="6">
                            <PathIcon Data="{StaticResource IconVault}" Width="16" Height="16" />
                            <TextBlock Grid.Column="1" Text="{Binding VaultDisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="16" Height="16" />
                        </Grid>
                    </Button>
                    </Panel>
                </StackPanel>
                <Border x:Name="DesktopSearchSlot" Grid.Column="1" Width="360" VerticalAlignment="Center" IsVisible="{Binding IsUnlocked}">
                    <Grid>
                        <TextBox x:Name="WinGlobalSearchBox" Text="{Binding SearchQuery}" PlaceholderText="搜索当前密码库"
                                 AutomationProperties.Name="搜索当前密码库" Padding="34,0,58,0" Height="32" KeyDown="Search_KeyDown" GotFocus="Search_FocusChanged" LostFocus="Search_FocusChanged" TextChanged="Search_TextChanged" />
                        <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Foreground="{DynamicResource SecondaryTextBrush}"
                                  HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <Border Background="{DynamicResource SidebarItemHoverBackgroundBrush}" CornerRadius="3" Padding="6,2"
                                IsVisible="{Binding !HasSearchQuery}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False">
                            <TextBlock Text="{Binding SearchShortcutHint}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <Button Classes="subtle chromeCommand" HorizontalAlignment="Right" IsVisible="{Binding HasSearchQuery}"
                                Click="ClearSearch_Click" ToolTip.Tip="清除搜索" AutomationProperties.Name="清除搜索"><PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" /></Button>
                        <Popup x:Name="WinSearchPopup" PlacementTarget="{Binding #WinGlobalSearchBox}" Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="4" ShouldUseOverlayLayer="True">
                            <Border Width="{Binding #WinGlobalSearchBox.Bounds.Width}" Background="{DynamicResource DetailBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="当前密码库中的匹配" Margin="8,4" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ListBox x:Name="WinSearchSuggestions" MaxHeight="228" Background="Transparent"
                                             ItemTemplate="{StaticResource SearchSuggestionTemplate}" Tapped="SearchSuggestion_Tapped"
                                             KeyDown="Search_KeyDown" LostFocus="Search_FocusChanged" AutomationProperties.Name="搜索建议" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <StackPanel x:Name="DesktopCommands" Grid.Column="2" IsVisible="{Binding IsUnlocked}" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,192,0">
                    <Button Classes="subtle chromeCommand" AutomationProperties.Name="密码生成器" ToolTip.Tip="密码生成器" Command="{Binding OpenPasswordGeneratorCommandCommand}" ><PathIcon Data="{StaticResource IconGenerator}" Width="16" Height="16" /></Button>
                    <Button Classes="subtle chromeCommand" AutomationProperties.Name="锁定密码库 (Ctrl+L)" ToolTip.Tip="锁定密码库 (Ctrl+L)" Command="{Binding LockVaultCommand}" ><PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- ==================== 解锁 / 欢迎页（带丝滑淡出+微缩放转场动画） ==================== -->
            <Grid x:Name="UnlockStage" Classes.hidden="{Binding IsUnlocked}" ColumnDefinitions="Auto,1,*">
                <Border x:Name="UnlockSidebar" Grid.Column="0" Width="272" Background="{DynamicResource SidebarBackgroundBrush}">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <!-- macOS 顶部 48px 交通灯安全拖动区 -->
                        <Border Grid.Row="0" Height="48" IsVisible="{Binding IsMacOS}" Background="Transparent"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                                PointerPressed="TitleBar_PointerPressed" />

                        <StackPanel Grid.Row="1" Margin="20,22,20,6" Spacing="12">
                            <TextBlock Text="密码库" FontSize="24" FontWeight="SemiBold" />
                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                <Button Command="{Binding BrowseVaultFileCommand}" Padding="8,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" />
                                        <TextBlock Text="打开文件" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="subtle" Command="{Binding CreateNewVaultCommand}" Padding="8,0" Content="新建密码库" />
                            </WrapPanel>
                            <Border Height="1" Margin="0,4,0,0" Background="{DynamicResource DividerBrush}" />
                            <TextBlock Text="最近打开" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>

                        <!-- 最近打开的密码库列表（悬停右侧显示移除图标，支持右键移除/清空） -->
                        <ListBox Grid.Row="2" Classes="entryList workspaceList recentList" ItemsSource="{Binding RecentVaults}" SelectedItem="{Binding SelectedRecentVault}"
                                 IsVisible="{Binding HasRecentVaults}" MaxHeight="264" Background="Transparent" BorderThickness="0" Padding="12,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="entryCard" Height="52">
                                        <Border.ContextMenu>
                                            <helpers:GlassContextMenu>
                                                <MenuItem Header="从最近列表移除"
                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentVaultCommand}"
                                                          CommandParameter="{Binding}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="清空全部最近记录"
                                                          Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearRecentVaultsCommand}">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </helpers:GlassContextMenu>
                                        </Border.ContextMenu>
                                        <Grid ColumnDefinitions="6,28,*,Auto">
                                            <Border Grid.Column="0" Classes="entryIndicator" Width="3" Height="24" CornerRadius="2"
                                                    Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <PathIcon Grid.Column="1" Data="{StaticResource IconVault}" Width="16" Height="16" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2" Margin="4,0,6,0">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FileName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Classes="subtle recentRemoveBtn" Width="26" Height="26" MinHeight="26" Padding="0" Margin="0,0,8,0"
                                                    VerticalAlignment="Center" ToolTip.Tip="从最近列表移除（不删除本地文件）"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentVaultCommand}"
                                                    CommandParameter="{Binding}">
                                                <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2" Margin="20,8,20,12" IsVisible="{Binding !HasRecentVaults}"
                                   Text="暂无最近打开的密码库" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <StackPanel Grid.Row="3" VerticalAlignment="Top" Spacing="4" Margin="12,12,12,0">
                            <Button Classes="subtle" HorizontalAlignment="Left" Command="{Binding OpenDemoVaultCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconBook}" Width="16" Height="16" />
                                    <TextBlock Text="打开演示密码库" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="可拖入 .kdbx 文件打开。" Margin="8,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Row="4" Spacing="8" Margin="12,0,12,12">
                            <Border Height="1" Background="{DynamicResource DividerBrush}" />
                            <Button Classes="subtle" HorizontalAlignment="Left" Command="{Binding OpenSettingsCommandCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" />
                                    <TextBlock Text="{DynamicResource Str_SettingsTitle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 直通顶部的 1px 垂直分割线 -->
                <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

                <!-- 右侧纯净解锁主表单区 -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource ListPaneBackgroundBrush}">
                    <!-- 右侧顶部透明拖动区 -->
                    <Border Grid.Row="0" Height="48" IsVisible="{Binding IsMacOS}" Background="Transparent"
                            chrome:WindowDecorationProperties.ElementRole="TitleBar"
                            PointerPressed="TitleBar_PointerPressed" />

                    <ScrollViewer Grid.Row="1" Padding="24,60,24,24">
                    <StackPanel MaxWidth="400" Spacing="12">
                        <Border Width="44" Height="44" CornerRadius="8" HorizontalAlignment="Left"
                                Background="{DynamicResource BadgePillBackgroundBrush}">
                            <PathIcon Data="{StaticResource IconLock}" Width="20" Height="20" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <StackPanel Spacing="2" Margin="0,0,0,8">
                            <TextBlock Text="{Binding UnlockVaultHeading}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding UnlockVaultFileName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>

                        <!-- 主密码（解锁失败时触发 macOS 风格水平微颤动画） -->
                        <StackPanel x:Name="UnlockPasswordContainer" Spacing="4">
                            <TextBlock Text="主密码" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox x:Name="UnlockPasswordBox" Text="{Binding UnlockMasterPassword}" Height="32" PasswordChar="•"
                                     AutomationProperties.Name="主密码" PlaceholderText="输入主密码" KeyDown="UnlockPassword_KeyDown" IsEnabled="{Binding !IsUnlocking}" />
                            <TextBlock Text="{Binding UnlockError}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                       AutomationProperties.LiveSetting="Polite"
                                       IsVisible="{Binding UnlockError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- 密钥文件（可选，支持浏览、一键生成 XML v2.0 .keyx、清除） -->
                        <Expander Classes="unlockOptions" Header="使用密钥文件" HorizontalAlignment="Stretch" IsExpanded="{Binding HasUnlockKeyFile, Mode=OneWay}">
                            <Grid ColumnDefinitions="*,6,Auto,Auto">
                                <Button Grid.Column="0" Height="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,0"
                                        Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                        Command="{Binding BrowseKeyFileCommand}">
                                    <Grid ColumnDefinitions="*, Auto" HorizontalAlignment="Stretch">
                                        <TextBlock Grid.Column="0" Text="{Binding UnlockKeyFileDisplay}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconKey}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                                <Button Grid.Column="2" Classes="subtle" Width="36" Height="32" Padding="0"
                                        ToolTip.Tip="生成新的 XML v2.0 密钥文件 (.keyx)"
                                        Command="{Binding GenerateKeyFileCommand}">
                                    <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Button>
                                <Button Grid.Column="3" Classes="subtle" Width="32" Height="32" Padding="0"
                                        ToolTip.Tip="清除已选密钥文件"
                                        IsVisible="{Binding HasUnlockKeyFile}"
                                        Command="{Binding ClearKeyFileCommand}">
                                    <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Button>
                            </Grid>
                        </Expander>

                        <!-- Windows 专属：使用当前 Windows 用户账户（DPAPI，100% 互通原版 KeePass 2.x） -->
                        <CheckBox Content="使用 Windows 用户账户（DPAPI）" FontSize="14"
                                  IsVisible="{Binding IsWindows}"
                                  IsChecked="{Binding UnlockUseWindowsUserAccount}" />

                        <!-- macOS 专属：启用 Touch ID 快速解锁（主密码安全托管于 macOS 钥匙串） -->
                        <CheckBox Content="启用 Touch ID 快速解锁" FontSize="14" ToolTip.Tip="解锁凭据由 macOS 钥匙串保管"
                                  IsVisible="{Binding CanEnableTouchId}"
                                  IsChecked="{Binding RememberForTouchId}" />

                        <!-- 通栏解锁主按钮 + Touch ID 快速解锁 + 丝滑解密进度条 -->
                        <StackPanel Spacing="8" Margin="0,4,0,0">
                            <Button Classes="accent" Height="32" HorizontalAlignment="Stretch" Command="{Binding UnlockVaultCommand}" IsEnabled="{Binding !IsUnlocking}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconUnlock}" Width="14" Height="14" />
                                    <TextBlock Text="解锁密码库" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding !IsUnlocking}" />
                                    <TextBlock Text="正在解密密码库..." FontSize="14" FontWeight="SemiBold" IsVisible="{Binding IsUnlocking}" />
                                </StackPanel>
                            </Button>
                            <Button Height="32" HorizontalAlignment="Stretch"
                                    Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                    IsVisible="{Binding CanUnlockWithTouchId}" IsEnabled="{Binding !IsUnlocking}"
                                    Command="{Binding UnlockWithTouchIdCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="{StaticResource IconShield}" Width="14" Height="14" Foreground="{DynamicResource BrandEmeraldBrush}" />
                                    <TextBlock Text="使用 Touch ID" FontSize="14" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                            <ProgressBar IsIndeterminate="True" Height="3" CornerRadius="2" HorizontalAlignment="Stretch"
                                         Foreground="{DynamicResource AccentButtonBackgroundBrush}"
                                         IsVisible="{Binding IsUnlocking}" />
                        </StackPanel>

                        <TextBlock Text="在此设备上解锁，文件保存在本地。" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ==================== 三栏主工作台（带丝滑淡入+微上浮缩放转场动画） ==================== -->
            <Grid x:Name="WorkspaceStage" Classes.visible="{Binding IsUnlocked}" ColumnDefinitions="Auto, 1, *">
                <Border x:Name="WorkspaceSidebar" Grid.Column="0" Width="240">
                    <Grid RowDefinitions="Auto, *, Auto, 1, Auto">
                        <Border Height="48" IsVisible="{Binding IsMacOS}" Background="Transparent"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="TitleBar_PointerPressed">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="{Binding MacTrafficLightsPadding}" />
                                <Border Grid.Column="1" Margin="4,0,16,0" VerticalAlignment="Center">
                                    <Button x:Name="MacVaultPicker" Classes="subtle vaultPicker" MaxWidth="132" IsVisible="{Binding IsUnlocked}"
                                            ToolTip.Tip="切换密码库" AutomationProperties.Name="切换密码库">
                                        <Button.Flyout>
                                            <Flyout Placement="BottomEdgeAlignedLeft">
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource VaultPickerTemplate}" />
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid ColumnDefinitions="16,*,16" ColumnSpacing="6">
                                            <PathIcon Data="{StaticResource IconVault}" Width="16" Height="16" />
                                            <TextBlock Grid.Column="1" Text="{Binding VaultDisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="16" Height="16" />
                                        </Grid>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" Padding="8,12">
                            <StackPanel Spacing="0">
                                <Button Classes="subtle chromeCommand compactExpandedOnly" HorizontalAlignment="Left"
                                        Click="ToggleSidebar_Click" ToolTip.Tip="切换导航栏" AutomationProperties.Name="切换导航栏">
                                    <PathIcon Data="{StaticResource IconPanel}" Width="16" Height="16" />
                                </Button>
                                <Button Classes="navItem" Classes.active="{Binding IsAllEntriesSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        Command="{Binding SelectSectionCommand}" CommandParameter="AllEntries" ToolTip.Tip="{DynamicResource Str_AllEntries}" AutomationProperties.Name="{DynamicResource Str_AllEntries}">
                                    <Grid ColumnDefinitions="6, 26, *, Auto">
                                        <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsAllEntriesSelected}" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconVault}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{DynamicResource Str_AllEntries}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" />
                                        <TextBlock Classes="expandedOnly" Grid.Column="3" Text="{Binding AllCount}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Button>

                                <Button Classes="navItem" Classes.active="{Binding IsFavoritesSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        Command="{Binding SelectSectionCommand}" CommandParameter="Favorites" ToolTip.Tip="{DynamicResource Str_Favorites}" AutomationProperties.Name="{DynamicResource Str_Favorites}">
                                    <Grid ColumnDefinitions="6, 26, *, Auto">
                                        <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsFavoritesSelected}" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconStar}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{DynamicResource Str_Favorites}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" />
                                        <TextBlock Classes="expandedOnly" Grid.Column="3" Text="{Binding FavoritesCount}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Button>

                                <Button Classes="navItem" Classes.active="{Binding IsTotpSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        Command="{Binding SelectSectionCommand}" CommandParameter="TotpOnly" ToolTip.Tip="{DynamicResource Str_Totp2Fa}" AutomationProperties.Name="{DynamicResource Str_Totp2Fa}">
                                    <Grid ColumnDefinitions="6, 26, *, Auto">
                                        <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsTotpSelected}" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconClock}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{DynamicResource Str_Totp2Fa}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" />
                                        <TextBlock Classes="expandedOnly" Grid.Column="3" Text="{Binding TotpCount}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Button>

                                <Button Classes="navItem" Classes.active="{Binding IsAuditSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        Command="{Binding SelectSectionCommand}" CommandParameter="SecurityAudit" ToolTip.Tip="{DynamicResource Str_SecurityAudit}" AutomationProperties.Name="{DynamicResource Str_SecurityAudit}">
                                    <Grid ColumnDefinitions="6, 26, *, Auto">
                                        <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsAuditSelected}" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconShield}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{DynamicResource Str_SecurityAudit}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <Button Classes="subtle chromeCommand railOnly" Click="ToggleSidebar_Click"
                                        HorizontalAlignment="Left" ToolTip.Tip="展开密码库分组" AutomationProperties.Name="展开密码库分组">
                                    <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16" />
                                </Button>
                                <StackPanel Classes="expandedOnly">
                                <!-- 密码分组（右侧 + 按钮新建根分组，每项支持右键新建子分组 / 重命名 / 删除） -->
                                <Grid ColumnDefinitions="*, Auto" Margin="8,14,4,4">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_Groups}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="subtle" Width="22" Height="22" MinHeight="22" Padding="0"
                                            ToolTip.Tip="新建分组" Command="{Binding AddRootGroupCommand}">
                                        <PathIcon Data="{StaticResource IconAdd}" Width="11" Height="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Button>
                                </Grid>
                                <TreeView ItemsSource="{Binding RootGroups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent" BorderThickness="0">
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem" x:DataType="vm:GroupItemViewModel">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.Styles>
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                            <Grid ColumnDefinitions="18, *, Auto" Height="{DynamicResource DensityNavItemHeight}" Background="Transparent"
                                                  DragDrop.AllowDrop="True"
                                                  DragDrop.DragOver="GroupItem_DragOver"
                                                  DragDrop.Drop="GroupItem_Drop">
                                                <Grid.ContextMenu>
                                                    <helpers:GlassContextMenu>
                                                        <MenuItem Header="新建子分组..."
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddSubGroupCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconAdd}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="重命名 / 编辑备注..."
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameGroupCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconEdit}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="上移分组"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveGroupUpCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="下移分组"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveGroupDownCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="按名称排序子分组"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortSubGroupsCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <Separator />
                                                        <MenuItem Header="删除分组"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteGroupCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </helpers:GlassContextMenu>
                                                </Grid.ContextMenu>
                                                <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" Margin="4,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding EntryCount}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            </Grid>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <Expander Header="标签" Margin="4,8,4,0" HorizontalAlignment="Stretch">
                                <ItemsControl ItemsSource="{Binding AllTags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Classes="subtle" Padding="8,3" MinHeight="24" Margin="2"
                                                    Background="{DynamicResource BadgePillBackgroundBrush}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectTagCommand}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="11.5" Foreground="{DynamicResource BadgePillForegroundBrush}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 固定钉在底部分割线上方的「回收站 (N)」（合并为单 TextBlock 保证基线 100% 对齐） -->
                        <Button Grid.Row="2" ToolTip.Tip="回收站" AutomationProperties.Name="回收站" Classes="navItem" Classes.active="{Binding IsRecycleBinSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Height="34" Margin="12,2,12,6"
                                Command="{Binding SelectSectionCommand}" CommandParameter="RecycleBin">
                            <Grid ColumnDefinitions="6, 26, Auto">
                                <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                        HorizontalAlignment="Left" IsVisible="{Binding IsRecycleBinSelected}" />
                                <PathIcon Grid.Column="1" Data="{StaticResource IconTrash}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{Binding RecycleBinCount, StringFormat='回收站 ({0})'}"
                                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Grid.Row="3" Background="{DynamicResource DividerBrush}" />

                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="8,8,8,12">
                            <Button Classes="subtle" HorizontalAlignment="Stretch" Height="40" Padding="12,0" HorizontalContentAlignment="Left"
                                    Command="{Binding OpenSettingsCommandCommand}" ToolTip.Tip="设置" AutomationProperties.Name="设置">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" />
                                    <TextBlock Classes="expandedOnly" Text="{DynamicResource Str_SettingsTitle}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 垂直分割线 1（macOS 下直通窗口顶部！） -->
                <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

                <!-- 右侧主内容区：安全审计仪表盘 或 中栏列表 + 右栏详情 -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*,28">
                    <Border IsVisible="{Binding IsWindowsOrLinux}" Height="52" Background="{DynamicResource ListPaneBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                            <StackPanel IsVisible="{Binding !IsAuditViewActive}" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="accent" Command="{Binding AddEntryCommand}" Padding="12,0" AutomationProperties.Name="新建">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                                        <TextBlock Text="新建" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="subtle" Command="{Binding SaveVaultCommand}" ToolTip.Tip="保存密码库 (Ctrl+S)" AutomationProperties.Name="保存密码库">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                                        <TextBlock Classes="wideOnly" Text="保存" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button IsVisible="{Binding IsAuditViewActive}" Command="{Binding RefreshAuditCommand}" HorizontalAlignment="Left" Content="重新检查" />
                            <Button Grid.Column="1" Classes="subtle chromeCommand" ToolTip.Tip="更多密码库命令" AutomationProperties.Name="更多密码库命令">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="打开密码库" Command="{Binding OpenAnotherVaultCommand}" />
                                        <MenuItem Header="高级搜索" Command="{Binding OpenAdvancedSearchAsyncCommandCommand}" />
                                        <MenuItem Header="数据库设置" Command="{Binding OpenDatabaseSettingsAsyncCommandCommand}" />
                                        <MenuItem Header="密码库维护工具" Command="{Binding OpenDatabaseMaintenanceAsyncCommandCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <PathIcon Data="{StaticResource IconMore}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" IsVisible="{Binding IsAuditViewActive}" RowDefinitions="Auto,*" Background="{DynamicResource ListPaneBackgroundBrush}">
                        <Border Height="48" Padding="12,0" IsVisible="{Binding IsMacOS}"
                                Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="TitleBar_PointerPressed">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button HorizontalAlignment="Left" Command="{Binding RefreshAuditCommand}" Content="重新检查" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="subtle chromeCommand" Command="{Binding SaveVaultCommand}" ToolTip.Tip="保存密码库 (⌘S)" AutomationProperties.Name="保存密码库">
                                        <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                                    </Button>
                                    <Button Classes="subtle chromeCommand" Command="{Binding OpenPasswordGeneratorCommandCommand}"
                                            ToolTip.Tip="密码生成器 (⌘G)" AutomationProperties.Name="密码生成器">
                                        <PathIcon Data="{StaticResource IconGenerator}" Width="16" Height="16" />
                                    </Button>
                                    <Button Classes="subtle chromeCommand" Command="{Binding LockVaultCommand}"
                                            ToolTip.Tip="锁定密码库 (⌘L)" AutomationProperties.Name="锁定密码库">
                                        <PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" Padding="28">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="安全审计" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AuditCheckedDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Border Background="{DynamicResource AttentionBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="12,10">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                        <PathIcon Data="{StaticResource IconWarning}" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="{Binding AuditAffectedCount, StringFormat='发现 {0} 个需要处理的条目'}"
                                                       FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Text="同一条目可能出现在多个风险类别中。" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock Text="按风险查看" FontSize="20" FontWeight="SemiBold" />
                                <TabControl Classes="compactTabs">
                                    <TabItem Header="{Binding AuditWeakEntries.Count, StringFormat='弱密码 ({0})'}">
                                        <Border Classes="fluentCard" Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding AuditWeakEntries}" ItemTemplate="{StaticResource AuditFindingTemplate}" />
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="{Binding AuditReusedEntries.Count, StringFormat='重复密码 ({0})'}">
                                        <Border Classes="fluentCard" Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding AuditReusedEntries}" ItemTemplate="{StaticResource AuditFindingTemplate}" />
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="{Binding AuditExpiringEntries.Count, StringFormat='已过期或即将过期 ({0})'}">
                                        <Border Classes="fluentCard" Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding AuditExpiringEntries}" ItemTemplate="{StaticResource AuditFindingTemplate}" />
                                        </Border>
                                    </TabItem>
                                    <TabItem Header="{Binding TotpCount, StringFormat='动态验证码 ({0} 个已配置)'}">
                                        <StackPanel Spacing="8" Margin="0,12,0,0">
                                            <TextBlock Text="未配置动态验证码的登录条目" FontWeight="SemiBold" />
                                            <Border Classes="fluentCard">
                                                <ItemsControl ItemsSource="{Binding AuditNo2FaEntries}" ItemTemplate="{StaticResource AuditFindingTemplate}" />
                                            </Border>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 中栏条目列表 + 右栏详情面板 -->
                    <Grid x:Name="EntryWorkspace" Grid.Row="1" IsVisible="{Binding !IsAuditViewActive}" ColumnDefinitions="344,1,*">
                        <!-- PANE 2: 中栏条目列表（macOS 顶部直接内置搜索框 + 新建条目按钮，对应画板 02） -->
                        <Border Grid.Column="0" x:Name="EntryPane" Background="{DynamicResource ListPaneBackgroundBrush}">
                            <Grid RowDefinitions="Auto, Auto, Auto, *">
                                <Border Grid.Row="0" IsVisible="{Binding IsMacOS}" Height="48" Padding="12,0"
                                        Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                        chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="TitleBar_PointerPressed">
                                    <Grid ColumnDefinitions="*,10,Auto" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBox x:Name="MacGlobalSearchBox" Text="{Binding SearchQuery}" PlaceholderText="搜索当前密码库"
                                                     AutomationProperties.Name="搜索当前密码库" Padding="34,0,58,0" Height="32" KeyDown="Search_KeyDown" GotFocus="Search_FocusChanged" LostFocus="Search_FocusChanged" TextChanged="Search_TextChanged" />
                                            <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Foreground="{DynamicResource SecondaryTextBrush}"
                                                      HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                                            <Border Background="{DynamicResource SidebarItemHoverBackgroundBrush}" CornerRadius="3" Padding="6,2"
                                                    IsVisible="{Binding !HasSearchQuery}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding SearchShortcutHint}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </Border>
                                            <Button Classes="subtle chromeCommand" HorizontalAlignment="Right" IsVisible="{Binding HasSearchQuery}"
                                                    Click="ClearSearch_Click" ToolTip.Tip="清除搜索" AutomationProperties.Name="清除搜索"><PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" /></Button>
                                            <Popup x:Name="MacSearchPopup" PlacementTarget="{Binding #MacGlobalSearchBox}" Placement="BottomEdgeAlignedLeft"
                                                   VerticalOffset="4" ShouldUseOverlayLayer="True">
                                                <Border Width="{Binding #MacGlobalSearchBox.Bounds.Width}" Background="{DynamicResource DetailBackgroundBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="当前密码库中的匹配" Margin="8,4" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <ListBox x:Name="MacSearchSuggestions" MaxHeight="228" Background="Transparent"
                                                                 ItemTemplate="{StaticResource SearchSuggestionTemplate}" Tapped="SearchSuggestion_Tapped"
                                                                 KeyDown="Search_KeyDown" LostFocus="Search_FocusChanged" AutomationProperties.Name="搜索建议" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <Button Grid.Column="2" Classes="accent chromeCommand" Command="{Binding AddEntryCommand}"
                                                ToolTip.Tip="新建 (⌘N)" AutomationProperties.Name="新建">
                                            <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,12,12,8">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentFilterTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding FilteredEntries.Count, StringFormat='{}{0} 个条目'}" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button IsVisible="{Binding IsRecycleBinSelected}" IsEnabled="{Binding HasRecycleBinItems}"
                                                Foreground="{DynamicResource DangerBrush}" Command="{Binding EmptyRecycleBinCommand}" Content="清空回收站" />
                                        <Button Classes="subtle chromeCommand" Command="{Binding ToggleSortOrderCommand}"
                                                ToolTip.Tip="{Binding SortButtonLabel}" AutomationProperties.Name="切换条目排序">
                                            <PathIcon Data="{StaticResource IconSort}" Width="16" Height="16" />
                                        </Button>
                                        <Button Classes="subtle chromeCommand" Command="{Binding OpenAdvancedSearchAsyncCommandCommand}"
                                                ToolTip.Tip="高级搜索" AutomationProperties.Name="高级搜索">
                                            <PathIcon Data="{StaticResource IconFilter}" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 多选批量操作条（选中 2 条及以上时自动显示） -->
                                <Border Grid.Row="2" Classes="fluentCard" Margin="12,0,12,6" Padding="10,6"
                                        IsVisible="{Binding HasMultipleSelectedEntries}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="{Binding SelectedEntriesCount, StringFormat='已选 {0} 项'}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrandEmeraldBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Height="24" MinHeight="24" Padding="8,0" FontSize="11.5" Content="{DynamicResource Str_BatchMove}" Command="{Binding BatchMoveEntriesCommand}" />
                                            <Button Height="24" MinHeight="24" Padding="8,0" FontSize="11.5" Content="{DynamicResource Str_BatchFav}" Command="{Binding BatchFavoriteEntriesCommand}" />
                                            <Button Height="24" MinHeight="24" Padding="8,0" FontSize="11.5" Foreground="{DynamicResource DangerBrush}" Content="{DynamicResource Str_BatchDelete}" Command="{Binding BatchDeleteEntriesCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 条目列表（支持单选、Cmd/Ctrl 多选批量操作、右键快捷菜单与拖拽到分组树） -->
                                <ListBox Grid.Row="3" x:Name="EntryListBox" Classes="entryList workspaceList"
                                         Tapped="EntryList_Tapped" KeyDown="EntryList_KeyDown"
                                         SelectionMode="Multiple"
                                         SelectionChanged="EntryListBox_SelectionChanged"
                                         ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry}"
                                         Background="Transparent" BorderThickness="0" Padding="10,2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="entryCard" Height="{DynamicResource DensityRowHeight}"
                                                    PointerPressed="EntryCard_PointerPressed"
                                                    PointerMoved="EntryCard_PointerMoved">
                                                <Border.ContextMenu>
                                                    <helpers:GlassContextMenu>
                                                        <MenuItem Header="复制用户名"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyEntryUserNameCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="复制密码"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyEntryPasswordCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconKey}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="复制动态验证码 (TOTP)" IsVisible="{Binding HasTotp}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyEntryTotpCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconClock}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="打开网址" IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenEntryUrlCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconLink}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="复制网址" IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyEntryUrlCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconGlobe}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="执行自动输入 (Auto-Type)"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PerformAutoTypeCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconKeyboard}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="编辑条目..."
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconEdit}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="克隆条目"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DuplicateEntryCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="移动到分组..."
                                                                  IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveEntryToGroupCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconFolder}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="收藏 / 取消收藏"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFavoriteEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconStar}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="快捷设置过期时间"
                                                                  IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}">
                                                            <MenuItem Header="立即设为过期"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickExpireNowCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="设为永不过期"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickExpireNeverCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="30 天后过期"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickExpireIn30DaysCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="90 天后过期"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickExpireIn90DaysCommand}"
                                                                      CommandParameter="{Binding}" />
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="从回收站还原"
                                                                  IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RestoreEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconRefresh}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="删除 / 移入回收站"
                                                                  IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="永久删除"
                                                                  IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PermanentlyDeleteEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </helpers:GlassContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="12, Auto, *, Auto" Margin="0,0,12,0">
                                                    <!-- 选中态左侧 3×24px 品牌指示条 -->
                                                    <Border Grid.Column="0" Classes="entryIndicator" Width="3" Height="24" CornerRadius="2"
                                                            Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center" />

                                                    <Border Grid.Column="1" Classes="entryAvatar" Width="{DynamicResource DensityAvatarSize}" Height="{DynamicResource DensityAvatarSize}"
                                                            CornerRadius="6" Background="{DynamicResource BadgePillBackgroundBrush}" VerticalAlignment="Center" Margin="4,0,10,0" ClipToBounds="True">
                                                        <Panel>
                                                            <PathIcon Data="{Binding StandardIcon}" Width="20" Height="20" IsVisible="{Binding HasStandardIcon}"
                                                                      Foreground="{DynamicResource BadgePillForegroundBrush}" />
                                                            <TextBlock Classes="entryAvatarText" Text="{Binding Initials}" FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{DynamicResource BadgePillForegroundBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       IsVisible="{Binding ShowInitials}" />
                                                            <Image Source="{Binding CustomIconBitmap}" Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasCustomIcon}" />
                                                        </Panel>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource DensityFontSizeBody}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding UserName}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource IconStar}" Width="16" Height="16" IsVisible="{Binding IsFavorite}"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <PathIcon Data="{StaticResource IconClock}" Width="16" Height="16" IsVisible="{Binding HasTotp}"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <TextBlock Text="{Binding ExpiryBadge}" FontSize="12" Foreground="{DynamicResource WarningBrush}"
                                                                   IsVisible="{Binding HasExpiryBadge}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border x:Name="EntryDivider" Grid.Column="1" Background="{DynamicResource DividerBrush}" />

                        <Grid x:Name="EntryDetail" Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource DetailBackgroundBrush}">
                            <Border Grid.Row="0" Height="48" Padding="24,0" IsVisible="{Binding IsMacOS}" Background="Transparent"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                    chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="TitleBar_PointerPressed">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding SelectedEntry.GroupPath}" Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button Classes="subtle chromeCommand" AutomationProperties.Name="保存密码库 (⌘S)" ToolTip.Tip="保存密码库 (⌘S)" Command="{Binding SaveVaultCommand}" ><PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" /></Button>
                                        <Button Classes="subtle chromeCommand" AutomationProperties.Name="密码生成器 (⌘G)" ToolTip.Tip="密码生成器 (⌘G)" Command="{Binding OpenPasswordGeneratorCommandCommand}" ><PathIcon Data="{StaticResource IconGenerator}" Width="16" Height="16" /></Button>
                                        <Button Classes="subtle chromeCommand" AutomationProperties.Name="锁定密码库 (⌘L)" ToolTip.Tip="锁定密码库 (⌘L)" Command="{Binding LockVaultCommand}" ><PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" /></Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Panel x:Name="DetailSelectionRegion" Grid.Row="1">
                            <!-- 空状态 -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                        IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNull}}">
                                <PathIcon Data="{StaticResource IconShield}" Width="40" Height="40" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.5" />
                                <TextBlock Text="选择一条记录查看详情，或点击「新建」添加。" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="320" />
                            </StackPanel>

                            <!-- 详情主体 -->
                            <ScrollViewer Grid.Row="1" Padding="28,18,28,24" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="16" MaxWidth="740">
                                    <TextBlock IsVisible="{Binding IsWindowsOrLinux}" Text="{Binding SelectedEntry.GroupPath}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <!-- 条目头图与标题 -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Grid ColumnDefinitions="48,*" ColumnSpacing="12">
                                        <Border Width="48" Height="48" CornerRadius="8" Background="{DynamicResource BadgePillBackgroundBrush}" ClipToBounds="True">
                                            <Panel>
                                                <PathIcon Data="{Binding SelectedEntry.StandardIcon}" Width="28" Height="28"
                                                          Foreground="{DynamicResource BadgePillForegroundBrush}" IsVisible="{Binding SelectedEntry.HasStandardIcon}" />
                                                <TextBlock Text="{Binding SelectedEntry.Initials}" FontSize="20" FontWeight="Bold"
                                                           Foreground="{DynamicResource BadgePillForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding SelectedEntry.ShowInitials}" />
                                                <Image Source="{Binding SelectedEntry.CustomIconBitmap}" Stretch="UniformToFill"
                                                       IsVisible="{Binding SelectedEntry.HasCustomIcon}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Text="{Binding SelectedEntry.Title}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedEntry.EntryKind}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Command="{Binding EditSelectedEntryCommand}" ToolTip.Tip="编辑" AutomationProperties.Name="编辑">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Data="{StaticResource IconEdit}" Width="16" Height="16" />
                                                    <TextBlock Text="编辑" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="subtle chromeCommand" AutomationProperties.Name="收藏 / 取消收藏" ToolTip.Tip="收藏 / 取消收藏" Command="{Binding ToggleFavoriteSelectedCommand}" ><PathIcon Data="{StaticResource IconStar}" Width="16" Height="16" /></Button>
                                            <Button Classes="subtle chromeCommand" ToolTip.Tip="更多条目操作" AutomationProperties.Name="更多条目操作">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="执行自动输入 (Auto-Type)" Command="{Binding PerformAutoTypeCommand}" />
                                                        <MenuItem Header="编辑与历史" Command="{Binding EditSelectedEntryCommand}" />
                                                        <MenuItem Header="从回收站还原" Command="{Binding RestoreSelectedEntryCommand}" IsVisible="{Binding IsRecycleBinSelected}" />
                                                        <MenuItem Header="移到回收站" Click="MoveSelectedToRecycleBin_Click" IsVisible="{Binding !IsRecycleBinSelected}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                <PathIcon Data="{StaticResource IconMore}" Width="16" Height="16" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <TextBlock Text="登录信息" FontSize="20" FontWeight="SemiBold" />

                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12" Margin="12,8,8,8" MinHeight="40">
                                                <PathIcon Data="{StaticResource IconPerson}" Width="20" Height="20" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource Str_UserName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <SelectableTextBlock Text="{Binding SelectedEntry.UserName}" FontSize="14" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="subtle chromeCommand" VerticalAlignment="Center"
                                                        ToolTip.Tip="复制用户名" AutomationProperties.Name="复制用户名" Command="{Binding CopyUserNameCommand}">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource IconCopy}" Width="16" Height="16" IsVisible="{Binding !IsUserNameCopied}" />
                                                        <PathIcon Data="{StaticResource IconCheck}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsUserNameCopied}" />
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12" Margin="12,8,8,8" MinHeight="40">
                                                <PathIcon Data="{StaticResource IconKey}" Width="20" Height="20" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{DynamicResource Str_Password}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding SelectedEntry.DisplayedPassword}" FontFamily="Consolas,Menlo,monospace" FontSize="14" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                    <Button x:Name="PasswordRevealButton" Classes="subtle chromeCommand" ToolTip.Tip="按住查看密码"
                                                            AutomationProperties.Name="按住查看密码">
                                                        <PathIcon Data="{StaticResource IconEye}" Width="16" Height="16" />
                                                    </Button>
                                                    <Button Classes="subtle chromeCommand" Command="{Binding CopyPasswordCommand}" ToolTip.Tip="复制密码" AutomationProperties.Name="复制密码">
                                                        <Panel>
                                                            <PathIcon Data="{StaticResource IconCopy}" Width="16" Height="16" IsVisible="{Binding !IsPasswordCopied}" />
                                                            <PathIcon Data="{StaticResource IconCheck}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsPasswordCopied}" />
                                                        </Panel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel IsVisible="{Binding SelectedEntry.Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                                <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12" Margin="12,8,8,8" MinHeight="40">
                                                    <PathIcon Data="{StaticResource IconGlobe}" Width="20" Height="20" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{DynamicResource Str_Url}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <SelectableTextBlock Text="{Binding SelectedEntry.Url}" FontSize="14" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                        <Button Classes="subtle chromeCommand" Click="OpenUrl_Click" ToolTip.Tip="打开网站" AutomationProperties.Name="打开网站">
                                                            <PathIcon Data="{StaticResource IconLink}" Width="16" Height="16" />
                                                        </Button>
                                                        <Button Classes="subtle chromeCommand" Command="{Binding CopyEntryUrlCommand}" CommandParameter="{Binding SelectedEntry}"
                                                                ToolTip.Tip="复制网址" AutomationProperties.Name="复制网址">
                                                            <PathIcon Data="{StaticResource IconCopy}" Width="16" Height="16" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="12" IsVisible="{Binding SelectedEntry.HasTotp}">
                                        <TextBlock Text="{DynamicResource Str_TotpLabel}" FontSize="20" FontWeight="SemiBold" />
                                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8,8,12">
                                            <Grid ColumnDefinitions="20,*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto">
                                                <PathIcon Data="{StaticResource IconClock}" Width="20" Height="20" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding SelectedEntry.TotpFormatted}" FontFamily="Consolas,Menlo,monospace" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedEntry.TotpRemaining, StringFormat='剩余 {0} 秒'}"
                                                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Button Grid.Column="2" Classes="subtle chromeCommand" Command="{Binding CopyTotpCommand}"
                                                        ToolTip.Tip="复制动态验证码" AutomationProperties.Name="复制动态验证码">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource IconCopy}" Width="16" Height="16" IsVisible="{Binding !IsTotpCopied}" />
                                                        <PathIcon Data="{StaticResource IconCheck}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsTotpCopied}" />
                                                    </Panel>
                                                </Button>
                                                <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding SelectedEntry.TotpProgress}"
                                                             Height="3" Margin="0,4,0,0" HorizontalAlignment="Stretch" Foreground="{DynamicResource AccentButtonBackgroundBrush}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                            <TextBlock Text="备注" FontSize="20" FontWeight="SemiBold" />
                                            <SelectableTextBlock Text="{Binding SelectedEntry.Notes}" FontSize="14" LineHeight="20" TextWrapping="Wrap"
                                                                 IsVisible="{Binding SelectedEntry.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.DisplayTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="6" LineSpacing="6" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="8,4" Background="{DynamicResource SidebarItemHoverBackgroundBrush}">
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.CustomFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="140, *, Auto" Margin="0,3">
                                                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                            <SelectableTextBlock Grid.Column="1" Text="{Binding DisplayValue}" FontSize="13" VerticalAlignment="Center" />
                                                            <Button Grid.Column="2" Classes="subtle" Width="28" Height="28" MinHeight="28" Padding="0"
                                                                    ToolTip.Tip="复制自定义字段"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyCustomFieldCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.Attachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Padding="10,6" Margin="0,4,0,0" HorizontalAlignment="Left"
                                                                Background="{DynamicResource CardSubtleBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6"
                                                                ToolTip.Tip="点击导出解密后的附件到本地"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportAttachmentCommand}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <PathIcon Data="{StaticResource IconAttach}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="12.5" VerticalAlignment="Center" />
                                                                <PathIcon Data="{StaticResource IconExport}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <TextBlock Text="{Binding SelectedEntry.UpdatedDisplay}" FontSize="12" HorizontalAlignment="Right" ToolTip.Tip="{Binding SelectedEntry.FooterMeta}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                            </Panel>
                            <StackPanel x:Name="SearchDetailsPlaceholder" Grid.Row="1" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="12" IsVisible="False" MaxWidth="360" Margin="24">
                                <PathIcon Data="{StaticResource IconSearch}" Width="28" Height="28" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock x:Name="SearchResultMessage" TextAlignment="Center" TextWrapping="Wrap"
                                           FontSize="20" FontWeight="SemiBold" />
                                <Button x:Name="ClearEmptySearchButton" Click="ClearSearch_Click" Content="清除搜索" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource ListPaneBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconUnlock}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding VaultDisplayName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="· 已解锁" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding VaultSaveStatus}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 右下角安全剪贴板 Toast（对齐画板 02 / 03 / 12：右下角悬浮 + 圆形成功图标 + 底部 2px 进度条） -->
            <Border Classes="toastCard" Padding="14,10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28"
                    IsVisible="{Binding IsToastVisible}" IsHitTestVisible="False">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="16" Height="16" CornerRadius="8" Background="#189A58">
                            <PathIcon Data="{StaticResource IconCheck}" Width="9" Height="9" Foreground="White" />
                        </Border>
                        <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource ToastForegroundBrush}" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Height="2" CornerRadius="1" Background="#189A58" Opacity="0.85" />
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="DialogSmoke" Grid.RowSpan="2" Background="#4D000000" IsVisible="False" IsHitTestVisible="False" />
    </Grid>
</Window>
