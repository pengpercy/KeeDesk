<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Compact Density Tokens (Fluent 2 · 4px grid) -->
    <x:Double x:Key="DensityRowHeight">44</x:Double>
    <x:Double x:Key="DensityNavItemHeight">40</x:Double>
    <x:Double x:Key="DensityControlHeight">28</x:Double>
    <x:Double x:Key="DensityAvatarSize">28</x:Double>
    <x:Double x:Key="DensityFontSizeTitle">16</x:Double>
    <x:Double x:Key="DensityFontSizeBody">14</x:Double>
    <x:Double x:Key="DensityFontSizeCaption">12</x:Double>
    <Thickness x:Key="DensityCardPadding">10,8</Thickness>
    <Thickness x:Key="DensityItemMargin">0,1</Thickness>
    <Thickness x:Key="DensityContainerPadding">10</Thickness>
    <x:Double x:Key="DensityItemSpacing">4</x:Double>
    <CornerRadius x:Key="DensityCardRadius">6</CornerRadius>
</ResourceDictionary>
