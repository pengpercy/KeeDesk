<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.AdvancedSearchWindow"
        Title="{DynamicResource Str_AdvancedSearch}"
        Width="510" Height="528"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Styles>
        <Style Selector="CheckBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBox#QueryBox">
            <Setter Property="PlaceholderText" Value="{DynamicResource Str_SimpleSearchExample}" />
        </Style>
        <Style Selector="TextBox#QueryBox.regexSearch">
            <Setter Property="PlaceholderText" Value="{DynamicResource Str_RegexSearchExample}" />
        </Style>
        <Style Selector="TextBox#QueryBox.xpathSearch">
            <Setter Property="PlaceholderText" Value="{DynamicResource Str_XPathSearchExample}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, 1, Auto">
        <Border Grid.Row="0" Padding="24,40,24,10" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBar_PointerPressed">
            <TextBlock Text="{DynamicResource Str_AdvancedSearch}" FontSize="18" FontWeight="SemiBold" />
        </Border>

        <ScrollViewer Grid.Row="1" x:Name="SearchFormScroll" ClipToBounds="True"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="8" Margin="24,4,24,6">
                <StackPanel x:Name="ProfilesPanel" Spacing="6">
                    <TextBlock Text="{DynamicResource Str_SearchProfiles}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <ComboBox x:Name="ProfileBox" Height="32" HorizontalAlignment="Stretch"
                                  PlaceholderText="{DynamicResource Str_ChooseSearchProfile}" AutomationProperties.Name="{DynamicResource Str_SearchProfiles}" />
                        <Button Grid.Column="1" Classes="subtle chromeCommand" Click="ShowSaveProfile_Click"
                                ToolTip.Tip="{DynamicResource Str_SaveSearchProfile}" AutomationProperties.Name="{DynamicResource Str_SaveSearchProfile}">
                            <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                        </Button>
                        <Button Grid.Column="2" x:Name="DeleteProfileButton" Classes="subtle chromeCommand" Click="DeleteProfile_Click"
                                ToolTip.Tip="{DynamicResource Str_DeleteSearchProfile}" AutomationProperties.Name="{DynamicResource Str_DeleteSearchProfile}">
                            <PathIcon Data="{StaticResource IconTrash}" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="ProfileEditor" IsVisible="False" Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                            <TextBox x:Name="ProfileNameBox" Height="32" MaxLength="80" KeyDown="ProfileNameBox_KeyDown"
                                     PlaceholderText="{DynamicResource Str_SearchProfileName}" AutomationProperties.Name="{DynamicResource Str_SearchProfileName}" />
                            <Button Grid.Column="1" Height="32" Content="{DynamicResource Str_Cancel}" Click="CancelProfile_Click" />
                            <Button Grid.Column="2" Height="32" Content="{DynamicResource Str_Save}" Click="SaveProfile_Click" />
                        </Grid>
                        <TextBlock Text="{DynamicResource Str_SearchProfileOverwriteHint}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="ProfileErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                               TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Text="{DynamicResource Str_SearchTerm}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox x:Name="QueryBox" Height="34" KeyDown="QueryBox_KeyDown"
                                 AutomationProperties.Name="{DynamicResource Str_SearchTerm}" />
                        <ComboBox Grid.Column="1" x:Name="ModeBox" Classes="localizedOptions" Height="34" MinWidth="112" SelectedIndex="0"
                                  AutomationProperties.Name="{DynamicResource Str_SearchMode}">
                            <ComboBoxItem Content="{DynamicResource Str_SimpleSearchMode}" />
                            <ComboBoxItem Content="{DynamicResource Str_RegexSearchMode}" />
                            <ComboBoxItem Content="XPath" />
                        </ComboBox>
                    </Grid>
                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                               TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>

                <Border Classes="fluentCard" Padding="14,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Str_SearchFields}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <UniformGrid Columns="3">
                            <CheckBox x:Name="ChkTitle" Content="{DynamicResource Str_Title}" IsChecked="True" />
                            <CheckBox x:Name="ChkUser" Content="{DynamicResource Str_UserName}" IsChecked="True" />
                            <CheckBox x:Name="ChkPass" Content="{DynamicResource Str_Password}" IsChecked="False" />
                            <CheckBox x:Name="ChkUrl" Content="{DynamicResource Str_URL}" IsChecked="True" />
                            <CheckBox x:Name="ChkNotes" Content="{DynamicResource Str_Notes}" IsChecked="True" />
                            <CheckBox x:Name="ChkTags" Content="{DynamicResource Str_Tags}" IsChecked="True" />
                            <CheckBox x:Name="ChkCustom" Content="{DynamicResource Str_CustomFields}" IsChecked="True" />
                            <CheckBox x:Name="ChkUuid" Content="UUID" IsChecked="False" />
                            <CheckBox x:Name="ChkHistory" Content="{DynamicResource Str_History}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Classes="fluentCard" Padding="14,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource Str_MatchingOptions}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="ChkCase" Content="{DynamicResource Str_MatchCase}" />
                            <CheckBox x:Name="ChkIncludeBin" Content="{DynamicResource Str_IncludeRecycleBinEntries}" />
                            <CheckBox x:Name="ChkExcludeExpired" Content="{DynamicResource Str_ExcludeExpiredEntries}" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,12">
            <Button Width="84" Height="34" Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" />
            <Button Classes="accent" Height="34" Padding="18,0" Content="{DynamicResource Str_Find}" Click="Search_Click" />
        </StackPanel>
    </Grid>
</Window>
