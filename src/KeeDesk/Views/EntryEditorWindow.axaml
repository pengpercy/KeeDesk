<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KeeDesk.Controls"
        xmlns:helpers="using:KeeDesk.Helpers"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.EntryEditorWindow"
        Title="{DynamicResource Str_New}"
        Width="656" Height="754"
        MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.Styles>
        <Style Selector="CalendarDatePicker.entryExpiry">
            <Setter Property="Template">
                <ControlTemplate>
                    <DataValidationErrors>
                        <Border x:Name="DateFieldSurface" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <Grid ColumnDefinitions="*,30">
                                <TextBox x:Name="PART_TextBox" Classes="compositeInput" Background="Transparent" BorderThickness="0"
                                         MinHeight="0" FontSize="13" Padding="8,0" PlaceholderText="{TemplateBinding PlaceholderText}" />
                                <Button x:Name="PART_Button" Grid.Column="1" Classes="subtle" Focusable="False"
                                        Width="30" MinWidth="0" MinHeight="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                        AutomationProperties.Name="{DynamicResource Str_OpenCalendar}" ToolTip.Tip="{DynamicResource Str_OpenCalendar}">
                                    <PathIcon Data="{StaticResource IconCalendar}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Button>
                                <controls:TextInputFocusIndicator x:Name="DateFocusIndicator" Grid.ColumnSpan="2" Height="2"
                                                                  VerticalAlignment="Bottom" CornerRadius="0,0,4,4"
                                                                  IsInputFocused="{TemplateBinding IsKeyboardFocusWithin}" IsHitTestVisible="False"
                                                                  Background="{DynamicResource AccentButtonBackgroundBrush}" RenderTransformOrigin="50%,50%" />
                                <Popup x:Name="PART_Popup" PlacementTarget="{TemplateBinding}" Placement="BottomEdgeAlignedLeft"
                                       VerticalOffset="4" IsLightDismissEnabled="True" ShouldUseOverlayLayer="True">
                                    <controls:PickerSurface x:Name="CalendarSurface">
                                        <Calendar x:Name="PART_Calendar" Classes="entryCalendar"
                                                  FirstDayOfWeek="{TemplateBinding FirstDayOfWeek}" IsTodayHighlighted="{TemplateBinding IsTodayHighlighted}"
                                                  SelectedDate="{TemplateBinding SelectedDate, Mode=TwoWay}" DisplayDate="{TemplateBinding DisplayDate}"
                                                  DisplayDateStart="{TemplateBinding DisplayDateStart}" DisplayDateEnd="{TemplateBinding DisplayDateEnd}" />
                                    </controls:PickerSurface>
                                </Popup>
                            </Grid>
                        </Border>
                    </DataValidationErrors>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CalendarDatePicker[IsDropDownOpen=True].entryExpiry /template/ controls|TextInputFocusIndicator#DateFocusIndicator">
            <Setter Property="IsInputFocused" Value="True" />
        </Style>
        <Style Selector="CalendarDatePicker.entryExpiry:pointerover /template/ Border#DateFieldSurface">
            <Setter Property="BorderBrush" Value="{DynamicResource StandardButtonHoverBorderBrush}" />
        </Style>
        <Style Selector="CalendarDatePicker.entryExpiry:disabled /template/ Border#DateFieldSurface">
            <Setter Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlDisabledBorderBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, 1, Auto">
        <!-- 顶部 Header（支持拖动） -->
        <Border Grid.Row="0" Padding="20,38,20,10" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Grid.Column="0" x:Name="DialogHeading" Text="{DynamicResource Str_New}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            chrome:WindowDecorationProperties.ElementRole="User">
                    <ComboBox x:Name="TemplateCombo" Classes="localizedOptions" Height="28" MinHeight="28" FontSize="12" SelectionChanged="TemplateCombo_Changed">
                        <ComboBoxItem Content="{DynamicResource Str_TemplateWebsiteLogin}" Tag="Login" />
                        <ComboBoxItem Content="{DynamicResource Str_TemplateBankCard}" Tag="Bank" />
                        <ComboBoxItem Content="{DynamicResource Str_TemplateAPIKey}" Tag="ApiKey" />
                        <ComboBoxItem Content="{DynamicResource Str_TemplateSecureNote}" Tag="Note" />
                    </ComboBox>

                    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,0" Height="28">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TargetGroupLabel" Text="{DynamicResource Str_CommonAccounts}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="HistoryToggleBtn" Height="28" MinHeight="28" Padding="10,0" IsVisible="False"
                            Click="ToggleHistoryPanel_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource IconHistory}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="HistoryBtnText" Text="{DynamicResource Str_History0}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体滚动区 / 独立历史快照视图 -->
        <Grid Grid.Row="1">
            <Border x:Name="HistoryOverlayPanel" IsVisible="False" Margin="20,4,20,14" Classes="fluentCard" Padding="16">
                <Grid RowDefinitions="Auto, *, Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{DynamicResource Str_EntryHistory}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Str_KeeDeskSavesASnapshotWithEachChange}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Height="28" MinHeight="28" FontSize="12" Content="{DynamicResource Str_BackToEditing}" Click="ToggleHistoryPanel_Click" />
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="HistoryListBox" Background="Transparent" />
                    <Button Grid.Row="2" Classes="accent" Height="32" Content="{DynamicResource Str_RestoreSelectedVersion}" HorizontalAlignment="Right" Margin="0,10,0,0" Click="RestoreHistory_Click" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="MainFormScroll" Padding="20,4,20,14">
                <StackPanel Spacing="10">
                    <!-- ========== Card 1：核心凭证卡片（精致 32px 控件高度） ========== -->
                    <Border Classes="fluentCard" Padding="16,14">
                        <StackPanel Spacing="11">
                            <!-- 标题与图标 + 收藏开关 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Str_TitleRequired}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Grid ColumnDefinitions="32, 8, *, 8, Auto">
                                    <Button Grid.Column="0" x:Name="IconBadgeBtn" Width="32" Height="32" MinHeight="32" Padding="0" CornerRadius="6"
                                            Background="{DynamicResource BadgePillBackgroundBrush}" BorderThickness="0" ClipToBounds="True"
                                            AutomationProperties.Name="{DynamicResource Str_SetEntryIcon}"
                                            ToolTip.Tip="{DynamicResource Str_ChooseAnIconFromAWebsiteLocal}">
                                        <Button.Flyout>
                                            <helpers:GlassMenuFlyout FlyoutPresenterClasses="workspaceMenu compactMenu" Placement="BottomEdgeAlignedLeft">
                                                <MenuItem Header="{DynamicResource Str_FetchWebsiteIcon}" ToolTip.Tip="{DynamicResource Str_GetIconFromWebsiteOrEmailDomain}" Click="AutoFetchFavicon_Click">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource IconGlobe}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{DynamicResource Str_ChooseImageOrBuiltInIcon}" ToolTip.Tip="{DynamicResource Str_ChooseALocalImageImageURLOr}" Click="PickIcon_Click">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource IconFolder}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Str_RestoreDefaultLetterIcon}" Click="ResetLetterIcon_Click">
                                                    <MenuItem.Icon>
                                                        <PathIcon Data="{StaticResource IconRefresh}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </helpers:GlassMenuFlyout>
                                        </Button.Flyout>
                                        <Panel>
                                            <TextBlock x:Name="IconBadgeText" Text="KP" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgePillForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border CornerRadius="6" ClipToBounds="True" IsVisible="{Binding #IconBadgeImage.IsVisible}">
                                                <Image x:Name="IconBadgeImage" Stretch="UniformToFill" IsVisible="False" />
                                            </Border>
                                        </Panel>
                                    </Button>
                                    <TextBox Grid.Column="2" x:Name="TitleBox" Height="32" PlaceholderText="{DynamicResource Str_ExampleCloudConsoleCompanyGitLab}" TextChanged="TitleBox_TextChanged" />
                                    <ToggleButton Grid.Column="4" x:Name="FavoriteToggle" Classes="chipToggle" Height="32" Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconStar}" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock x:Name="FavoriteToggleText" Text="{DynamicResource Str_Favorite}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>
                            </StackPanel>

                            <!-- 双列：用户名（含插入字段引用） & 网址 -->
                            <Grid ColumnDefinitions="*, 12, *">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{DynamicResource Str_UserName}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Grid ColumnDefinitions="*, 4, Auto">
                                        <TextBox Grid.Column="0" x:Name="UserNameBox" Height="32" PlaceholderText="{DynamicResource Str_EnterAUsernameOrREF}" />
                                        <Button Grid.Column="2" Classes="subtle" Width="30" Height="32" MinHeight="32" Padding="0"
                                                ToolTip.Tip="{DynamicResource Str_InsertFieldReferenceREF}" Click="InsertUserNameRef_Click">
                                            <PathIcon Data="{StaticResource IconLink}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{DynamicResource Str_Website}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Grid>
                                        <TextBox x:Name="UrlBox" Height="32" Padding="30,5,10,5" PlaceholderText="https://example.com/login" />
                                        <PathIcon Data="{StaticResource IconGlobe}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 密码 + 显隐 + 引用 + 生成密码 + 实时强度条 -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="{DynamicResource Str_Password}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Grid ColumnDefinitions="*, 6, Auto, 4, Auto, 6, Auto">
                                    <TextBox Grid.Column="0" x:Name="PasswordBox" Height="32" PasswordChar="•" FontFamily="Consolas,Menlo,monospace"
                                             PlaceholderText="{DynamicResource Str_EnterAPasswordOrGenerateOne}" TextChanged="PasswordBox_TextChanged" />
                                    <Button Grid.Column="2" Height="32" MinHeight="32" Width="34" Padding="0" ToolTip.Tip="{DynamicResource Str_ShowOrHidePassword}" Click="TogglePasswordVisibility_Click">
                                        <PathIcon Data="{StaticResource IconEye}" Width="14" Height="14" />
                                    </Button>
                                    <Button Grid.Column="4" Classes="subtle" Height="32" MinHeight="32" Width="30" Padding="0" ToolTip.Tip="{DynamicResource Str_InsertPasswordReferenceREFP}" Click="InsertPasswordRef_Click">
                                        <PathIcon Data="{StaticResource IconLink}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Button>
                                    <Button Grid.Column="6" Classes="accent" Height="32" MinHeight="32" Padding="11,0" Click="GeneratePassword_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconShield}" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Str_GeneratePassword}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnDefinitions="170, 12, *">
                                    <ProgressBar Grid.Column="0" x:Name="StrengthBar" Minimum="0" Maximum="1" Value="0" MinWidth="0" Width="170" Height="4" CornerRadius="2" Foreground="{DynamicResource BrandEmeraldBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" x:Name="StrengthText" Text="{DynamicResource Str_PasswordStrengthWaitingForInput}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>

                            <!-- TOTP 动态验证码 -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Str_VerificationCodeSecretOptional}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <Grid ColumnDefinitions="*, 6, Auto">
                                    <TextBox Grid.Column="0" x:Name="TotpBox" Height="32" PasswordChar="•" FontFamily="Consolas,Menlo,monospace" FontSize="12.5"
                                             PlaceholderText="{DynamicResource Str_PasteAnOtpauthURLOrBase32Secret}" TextChanged="TotpBox_TextChanged" />
                                    <Border Grid.Column="2" x:Name="TotpPreviewBadge" IsVisible="False" Background="{DynamicResource BadgePillBackgroundBrush}" CornerRadius="4" Padding="10,0" Height="32">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource IconClock}" Width="12" Height="12" Foreground="{DynamicResource BadgePillForegroundBrush}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="TotpPreviewText" FontFamily="Consolas,Menlo,monospace" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource BadgePillForegroundBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ========== Card 2：备注、内联自定义字段与附件 ========== -->
                    <Expander HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Str_NotesCustomFieldsAndAttachments}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="NotesSummary" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <TextBox x:Name="NotesBox" TextChanged="NotesBox_TextChanged" AcceptsReturn="True" TextWrapping="Wrap" Height="58" VerticalContentAlignment="Top" Padding="10,7"
                                     PlaceholderText="{DynamicResource Str_EnterSecurityQuestionsRecoveryCodesOrAccount}" />

                            <StackPanel x:Name="CustomFieldsSection" IsVisible="False" Spacing="4">
                                <TextBlock Text="{DynamicResource Str_CustomFieldsOneNameValuePerLine}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBox x:Name="CustomFieldsBox" AcceptsReturn="True" TextWrapping="Wrap" Height="68" VerticalContentAlignment="Top" Padding="10,7"
                                         FontFamily="Consolas,Menlo,monospace" FontSize="12" PlaceholderText="API_Token=*ghp_xxxxxxxx" />
                            </StackPanel>

                            <StackPanel x:Name="AttachmentsSection" IsVisible="False" Spacing="4">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="{DynamicResource Str_EncryptedAttachments}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="subtle" Height="22" MinHeight="22" Padding="6,0" FontSize="11" Content="{DynamicResource Str_RemoveSelected}" Click="RemoveAttachment_Click" />
                                </Grid>
                                <ListBox x:Name="AttachmentsListBox" MaxHeight="76" Background="{DynamicResource CardSubtleBackgroundBrush}" CornerRadius="4" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Height="28" MinHeight="28" Padding="10,0" Click="ShowCustomFields_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconAdd}" Width="11" Height="11" Foreground="{DynamicResource BrandEmeraldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_AddCustomField}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Height="28" MinHeight="28" Padding="10,0" Click="AddAttachment_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconAttach}" Width="11" Height="11" Foreground="{DynamicResource BrandEmeraldBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_AddAttachment}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- ========== Expander 1：到期时间与标签 ========== -->
                    <Expander HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto, *" Margin="0,2">
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardSubtleBackgroundBrush}" Margin="0,0,10,0">
                                    <PathIcon Data="{StaticResource IconClock}" Width="13" Height="13" Foreground="{DynamicResource BrandEmeraldBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{DynamicResource Str_ExpirationAndTags}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ExpanderTagsSummary" Text="{DynamicResource Str_NeverExpiresNoTags}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Str_TagsSeparatedBySemicolonsOrCommas}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBox x:Name="TagsBox" Height="32" PlaceholderText="{DynamicResource Str_ExampleWorkProductionFinance}" TextChanged="UpdateExpanderSummaries" />
                            </StackPanel>
                            <CheckBox x:Name="ExpiresCheck" Content="{DynamicResource Str_SetAnExpirationDateForThisEntry}" FontSize="12.5" IsCheckedChanged="UpdateExpanderSummaries" />
                            <WrapPanel ItemSpacing="6" LineSpacing="6">
                                <CalendarDatePicker x:Name="ExpiryPicker" Classes="entryExpiry" Width="146" Height="32" MinHeight="32" SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd"
                                                    PlaceholderText="{DynamicResource Str_ChooseExpirationDate}" SelectedDateChanged="ExpiryPicker_Changed" />
                                <Button Height="32" MinHeight="32" FontSize="12" Content="{DynamicResource Str_1Month}" Click="ExpiryPreset_Click" Tag="30" />
                                <Button Height="32" MinHeight="32" FontSize="12" Content="{DynamicResource Str_3Months}" Click="ExpiryPreset_Click" Tag="90" />
                                <Button Height="32" MinHeight="32" FontSize="12" Content="{DynamicResource Str_1Year}" Click="ExpiryPreset_Click" Tag="365" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>

                    <!-- ========== Expander 2：自动输入与 KDBX 高级属性 ========== -->
                    <Expander HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto, *" Margin="0,2">
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="{DynamicResource CardSubtleBackgroundBrush}" Margin="0,0,10,0">
                                    <PathIcon Data="{StaticResource IconKeyboard}" Width="13" Height="13" Foreground="{DynamicResource BrandEmeraldBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{DynamicResource Str_AutoTypeAndAdvancedKDBXOptions}" FontSize="12.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ExpanderAdvancedSummary" Text="{DynamicResource Str_InheritTheGroupSKeySequencePassword}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>
                        <StackPanel Spacing="10" Margin="2,6">
                            <CheckBox x:Name="AutoTypeEnabledCheck" Content="{DynamicResource Str_EnableAutoTypeForThisEntry}" FontSize="12.5" IsChecked="True" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Str_DefaultKeySequenceLeaveBlankToInherit}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBox x:Name="AutoTypeSeqBox" Height="32" FontFamily="Consolas,Menlo,monospace" PlaceholderText="{}{USERNAME}{TAB}{PASSWORD}{ENTER}" />
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{DynamicResource Str_AutoTypeAssociations}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="subtle chromeCommand" Click="AddAutoTypeAssociation_Click"
                                            ToolTip.Tip="{DynamicResource Str_AddAutoTypeAssociation}" AutomationProperties.Name="{DynamicResource Str_AddAutoTypeAssociation}">
                                        <PathIcon Data="{StaticResource IconAdd}" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <StackPanel x:Name="AutoTypeAssociationRows" Spacing="6" />
                                <TextBlock x:Name="AutoTypeAssociationError" IsVisible="False" Text="{DynamicResource Str_AutoTypeAssociationMissingTitle}"
                                           Foreground="{DynamicResource DangerBrush}" FontSize="11.5" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock x:Name="AutoTypeObfuscationNotice" Text="{DynamicResource Str_AutoTypeRequiresObfuscation}"
                                       IsVisible="False" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Border Height="1" Background="{DynamicResource DividerBrush}" />
                            <CheckBox x:Name="QualityCheckBox" Content="{DynamicResource Str_IncludeInPasswordQualityChecksKDBX4}" FontSize="12.5" IsChecked="True" />
                            <StackPanel Spacing="4">
                                <TextBlock Text="{DynamicResource Str_OverrideURLOptional}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBox x:Name="OverrideUrlBox" Height="32" PlaceholderText="{DynamicResource Str_ExampleCmdSshUSERNAMEURL}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />

        <!-- 固定底部 Footer（使用标准软盘保存图标 IconSave） -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="20,12">
            <CheckBox Grid.Column="0" x:Name="AutoCopyAfterSaveCheck" Content="{DynamicResource Str_CopyPasswordAfterSaving}" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{DynamicResource Str_Cancel}" IsCancel="True" Click="Cancel_Click" MinWidth="76" Height="32" MinHeight="32" />
                <Button x:Name="SaveButton" Classes="accent" Click="Save_Click" MinWidth="108" Height="32" MinHeight="32">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource IconSave}" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock x:Name="SaveButtonText" Text="{DynamicResource Str_CreateEntry}" FontSize="12.5" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
