<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeeDesk.Views.RecycleEntryDialog"
        Title="{DynamicResource Str_MoveToRecycleBin}"
        Width="436" SizeToContent="Height" CanResize="False"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <StackPanel>
        <StackPanel Margin="24" Spacing="12">
            <TextBlock x:Name="Prompt" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{DynamicResource Str_YouCanRestoreThisEntryFromThe}" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource DividerBrush}" />
        <Border Padding="24,18" Background="{DynamicResource CardSubtleBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" MinWidth="90" IsCancel="True" Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" />
                <Button MinWidth="123" Content="{DynamicResource Str_MoveToRecycleBin}" Click="Confirm_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
