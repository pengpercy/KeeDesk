<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeeDesk.Views.RecycleEntryDialog"
        Title="移到回收站"
        Width="436" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <StackPanel>
        <StackPanel Margin="24" Spacing="12">
            <TextBlock x:Name="Prompt" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="你可以在回收站中恢复此条目。" Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource DividerBrush}" />
        <Border Padding="24,18" Background="{DynamicResource CardSubtleBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" MinWidth="90" IsCancel="True" Content="取消" Click="Cancel_Click" />
                <Button MinWidth="123" Content="移到回收站" Click="Confirm_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
