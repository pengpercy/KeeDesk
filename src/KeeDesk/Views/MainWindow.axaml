<Window xmlns="https://github.com/avaloniaui"
        xmlns:services="using:KeeDesk.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:KeeDesk.ViewModels"
        xmlns:controls="using:KeeDesk.Controls"
        xmlns:helpers="using:KeeDesk.Helpers"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="KeeDesk"
        Icon="/Assets/Branding/app_ico.ico"
        Width="1080" Height="720"
        MinWidth="720" MinHeight="640"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="48"
        DragDrop.AllowDrop="True"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <!-- macOS 原生顶部菜单栏（文件 / 条目 / 工具 / 视图） -->
    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="{DynamicResource Str_File}">
                <NativeMenu>
                    <NativeMenuItem Header="{DynamicResource Str_OpenAnotherVaultInNewTab}" Gesture="Cmd+O" Command="{Binding OpenAnotherVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_OpenRemoteVault}" Gesture="Shift+Cmd+O" Command="{Binding OpenRemoteVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_CloudDriveOpen}" Command="{Binding OpenCloudDriveCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_OpenCloudVault}" Command="{Binding OpenCloudVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_NewVault}" Gesture="Shift+Cmd+N" Command="{Binding CreateNewVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_SaveVault}" Gesture="Cmd+S" Command="{Binding SaveVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_CloudDriveUpload}" Command="{Binding UploadCloudDriveCopyCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_SaveAs}" Gesture="Shift+Cmd+S" Command="{Binding SaveVaultAsCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_VaultSettingsAndMasterKey2}" Command="{Binding OpenDatabaseSettingsAsyncCommandCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_VaultMaintenance2}" Command="{Binding OpenDatabaseMaintenanceAsyncCommandCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_MergeSyncAnotherVault}" Command="{Binding MergeDatabaseCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_SyncWithLocalVaultMenu}" Command="{Binding SynchronizeVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_SyncRemoteVault}" Command="{Binding SynchronizeRemoteVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_CloudDriveSync}" Command="{Binding SynchronizeCloudDriveCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_SyncCloudVault}" Command="{Binding SynchronizeCloudVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_GenerateKeyFileKeyx}" Command="{Binding GenerateKeyFileCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_ImportCSVGenericChromeBitwarden1Password}" Command="{Binding ImportCsvCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_MigrationImport}" Command="{Binding ImportVaultMigrationCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_ImportKeePass2XXML}" Command="{Binding ImportKeePassXmlCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_ImportLegacyKdb}" Command="{Binding ImportLegacyKdbCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_ExportCSV}" Command="{Binding ExportCsvCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_ExportKeePass2XXML}" Command="{Binding ExportKeePassXmlCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_ExportVaultStylesheet}" Command="{Binding ExportVaultStylesheetCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_PrintVault}" Gesture="Cmd+P" Command="{Binding PrintVaultCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_GenerateHTMLEmergencySheet}" Command="{Binding ExportEmergencySheetCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_CloseCurrentVaultTab}" Command="{Binding CloseVaultTabCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_LockAllVaults}" Gesture="Cmd+L" Command="{Binding LockVaultCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{DynamicResource Str_Entries}">
                <NativeMenu>
                    <NativeMenuItem Header="{DynamicResource Str_New}" Gesture="Cmd+N" Command="{Binding AddEntryCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_EditSelectedEntry}" Gesture="Cmd+E" Command="{Binding EditSelectedEntryCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_DuplicateSelectedEntry}" Gesture="Cmd+D" Command="{Binding DuplicateEntryCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_ToggleFavorite}" Command="{Binding ToggleFavoriteSelectedCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_CopyUsername}" Gesture="Cmd+B" Command="{Binding CopyUserNameCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_CopyPassword}" Gesture="Shift+Cmd+C" Command="{Binding CopyPasswordCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_CopyVerificationCode}" Gesture="Shift+Cmd+T" Command="{Binding CopyTotpCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_OpenURLInBrowser}" Gesture="Cmd+U" Command="{Binding OpenEntryUrlCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_PerformAutoType}" Command="{Binding PerformAutoTypeCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_RestoreSelectedEntry}" Command="{Binding RestoreSelectedEntryCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_DeleteMoveToRecycleBin}" Command="{Binding DeleteSelectedEntryCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_EmptyRecycleBin}" Command="{Binding EmptyRecycleBinCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{DynamicResource Str_Tools}">
                <NativeMenu>
                    <NativeMenuItem Header="{DynamicResource Str_NewRootGroup}" Command="{Binding AddRootGroupCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_PasswordGenerator}" Gesture="Cmd+G" Command="{Binding OpenPasswordGeneratorCommandCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_SecurityAuditDashboard}" Command="{Binding SelectSectionCommand}" CommandParameter="SecurityAudit" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{DynamicResource Str_Search}">
                <NativeMenu>
                    <NativeMenuItem Header="{DynamicResource Str_QuickSearch}" Gesture="Cmd+K" Command="{Binding FocusSearchCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_AdvancedSearch}" Gesture="Cmd+F" Command="{Binding OpenAdvancedSearchAsyncCommandCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_ExpiredEntries}" Command="{Binding ShowQuickFilterCommand}" CommandParameter="Expired" />
                    <NativeMenuItem Header="{DynamicResource Str_ExpiresWithin7Days}" Command="{Binding ShowQuickFilterCommand}" CommandParameter="Expiring7" />
                    <NativeMenuItem Header="{DynamicResource Str_ExpiresWithin30Days}" Command="{Binding ShowQuickFilterCommand}" CommandParameter="Expiring30" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_RecentlyModifiedEntries}" Command="{Binding ShowQuickFilterCommand}" CommandParameter="LastModified" />
                    <NativeMenuItem Header="{DynamicResource Str_LargeEntriesAndAttachments}" Command="{Binding ShowQuickFilterCommand}" CommandParameter="Large" />
                    <NativeMenuItem Header="{DynamicResource Str_FindSimilarPasswords}" Command="{Binding ScanSimilarPasswordsCommand}" />
                </NativeMenu>
            </NativeMenuItem>
            <NativeMenuItem Header="{DynamicResource Str_View}">
                <NativeMenu>
                    <NativeMenuItem Header="{DynamicResource Str_SearchPlaceholder}" Gesture="Cmd+K" Command="{Binding FocusSearchCommand}" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_AllEntries2}" Command="{Binding SelectSectionCommand}" CommandParameter="AllEntries" />
                    <NativeMenuItem Header="{DynamicResource Str_Favorites2}" Command="{Binding SelectSectionCommand}" CommandParameter="Favorites" />
                    <NativeMenuItem Header="{DynamicResource Str_VerificationCodes2FA}" Command="{Binding SelectSectionCommand}" CommandParameter="TotpOnly" />
                    <NativeMenuItemSeparator />
                    <NativeMenuItem Header="{DynamicResource Str_ChangeUIDensityCompactStandardSpacious}" Command="{Binding CycleDensityCommand}" />
                    <NativeMenuItem Header="{DynamicResource Str_ToggleSortOrder}" Command="{Binding ToggleSortOrderCommand}" />
                </NativeMenu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.Resources>
        <DataTemplate x:Key="VaultSwitcherLabel" x:DataType="vm:VaultTabSession">
            <Grid ColumnDefinitions="*,14" ColumnSpacing="8">
                <TextBlock Classes="vaultOptionName" Classes.current="{Binding IsActive}" Text="{Binding DisplayName}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <PathIcon Grid.Column="1" Data="{StaticResource IconCheck}" Width="12" Height="12"
                          Foreground="{DynamicResource AccentTextBrush}" IsVisible="{Binding IsActive}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="VaultSwitcherIcon" x:DataType="vm:VaultTabSession">
            <Border Classes="vaultIconBadge" Classes.current="{Binding IsActive}" Width="22" Height="22" CornerRadius="5">
                <PathIcon Data="{StaticResource IconDatabase}" Width="12" Height="12" />
            </Border>
        </DataTemplate>
        <helpers:GlassMenuFlyout x:Key="VaultSwitcherMenu" Placement="BottomEdgeAlignedLeft" VerticalOffset="4"
                                 FlyoutPresenterClasses="workspaceMenu compactMenu vaultSwitcher">
            <Separator />
            <MenuItem Header="{DynamicResource Str_OpenAnotherVault}" Command="{Binding OpenAnotherVaultCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderOpen}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Str_CloseCurrentVault}" Command="{Binding CloseVaultTabCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" Foreground="{DynamicResource SecondaryTextBrush}" /></MenuItem.Icon>
            </MenuItem>
        </helpers:GlassMenuFlyout>
        <helpers:GlassMenuFlyout x:Key="SidebarSettingsMenu" Placement="TopEdgeAlignedLeft" VerticalOffset="-4"
                                 FlyoutPresenterClasses="workspaceMenu compactMenu">
            <MenuItem Header="{DynamicResource Str_Settings2}" Command="{Binding OpenSettingsCommandCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconSettings}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem>
                <MenuItem.Header>
                    <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                        <DynamicResource ResourceKey="Str_AppThemeFormat" />
                        <Binding Path="CurrentThemeLabel" />
                    </MultiBinding>
                </MenuItem.Header>
                <MenuItem.Icon><PathIcon Data="{StaticResource IconPanel}" /></MenuItem.Icon>
                <MenuItem Header="{DynamicResource Str_FollowSystem}" Command="{Binding SetThemeModeCommand}" CommandParameter="Default" />
                <MenuItem Header="{DynamicResource Str_Light}" Command="{Binding SetThemeModeCommand}" CommandParameter="Light" />
                <MenuItem Header="{DynamicResource Str_Dark}" Command="{Binding SetThemeModeCommand}" CommandParameter="Dark" />
            </MenuItem>
            <MenuItem>
                <MenuItem.Header>
                    <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                        <DynamicResource ResourceKey="Str_UIDensityFormat" />
                        <Binding Path="CurrentDensityLabel" />
                    </MultiBinding>
                </MenuItem.Header>
                <MenuItem.Icon><PathIcon Data="{StaticResource IconSort}" /></MenuItem.Icon>
                <MenuItem Header="{DynamicResource Str_Compact}" Command="{Binding SetDensityCommand}" CommandParameter="Compact" />
                <MenuItem Header="{DynamicResource Str_Standard}" Command="{Binding SetDensityCommand}" CommandParameter="Normal" />
                <MenuItem Header="{DynamicResource Str_Spacious}" Command="{Binding SetDensityCommand}" CommandParameter="Comfortable" />
            </MenuItem>
            <Separator />
            <MenuItem Header="{DynamicResource Str_CheckForUpdates3}" Command="{Binding CheckForUpdatesCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="{DynamicResource Str_AboutKeeDesk}" Command="{Binding OpenAboutAsyncCommandCommand}">
                <MenuItem.Icon><PathIcon Data="{StaticResource IconInfo}" /></MenuItem.Icon>
            </MenuItem>
        </helpers:GlassMenuFlyout>
        <DataTemplate x:Key="SearchSuggestionTemplate" x:DataType="vm:EntryItemViewModel">
            <StackPanel Spacing="2" Margin="4,2">
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding UserName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="AuditFindingTemplate" x:DataType="vm:EntryItemViewModel">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12,7">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding UserName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding GroupPath}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="subtle" Content="{DynamicResource Str_OpenEntry}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).JumpToAuditEntryCommand}"
                            CommandParameter="{Binding}" Click="AuditEntry_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>
        <Style Selector=":is(Window)">
            <Setter Property="Background" Value="{DynamicResource WorkspaceBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Window).mica">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.desktopTitleSurface">
            <Setter Property="Background" Value="{DynamicResource TitleBarBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Window).mica Border.desktopTitleSurface">
            <Setter Property="Background" Value="{DynamicResource MicaTintBrush}" />
        </Style>
        <Style Selector="Border#WorkspaceSidebar">
            <Setter Property="Background" Value="{DynamicResource SidebarBackgroundBrush}" />
        </Style>
        <Style Selector=":is(Window).mica Border#WorkspaceSidebar">
            <Setter Property="Background" Value="{DynamicResource MicaTintBrush}" />
        </Style>
        <Style Selector="Expander.disclosure">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <ToggleButton Classes="disclosureHeader" Content="{TemplateBinding Header}"
                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                        <controls:ExpanderContentSlide IsExpanded="{TemplateBinding IsExpanded}">
                            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
                        </controls:ExpanderContentSlide>
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.disclosureHeader">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="32" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" Background="{TemplateBinding Background}"
                                      CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.disclosureHeader:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBackgroundBrush}" />
        </Style>
        <Style Selector="ToggleButton.disclosureHeader:pressed">
            <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="Expander.unlockOptions /template/ ToggleButton.disclosureHeader">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Expander.sidebarTags /template/ ToggleButton.disclosureHeader">
            <Setter Property="Height" Value="{DynamicResource DensityNavItemHeight}" />
        </Style>
        <Style Selector="PathIcon.disclosureChevron">
            <Setter Property="RenderTransform" Value="rotate(-90deg)" />
        </Style>
        <Style Selector="Expander.disclosure:expanded PathIcon.disclosureChevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
        </Style>
        <Style Selector="TextBlock.keyDisclosureLabel">
            <Setter Property="Text" Value="{DynamicResource Str_UseAKeyFile}" />
        </Style>
        <Style Selector="Expander.unlockOptions:expanded TextBlock.keyDisclosureLabel">
            <Setter Property="Text" Value="{DynamicResource Str_KeyFile}" />
        </Style>
        <Style Selector="Grid#UnlockStage Button.welcomeAction">
            <Setter Property="Height" Value="36" />
        </Style>
        <Style Selector="Button.welcomeRailAction">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.welcomeRailAction TextBlock">
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid#UnlockStage Button.unlockAction, Grid#UnlockStage TextBox.unlockField">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="StackPanel.welcomeForm">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="StackPanel.welcomeForm.hasVault">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,96,0,0" />
        </Style>
        <Style Selector="ListBox.recentList ListBoxItem:selected Border.entryIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBox.recentList ListBoxItem">
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="ListBox.recentList ListBoxItem Border.entryCard">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="ListBox.recentList ListBoxItem:focus-within Button.recentRemoveBtn">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Button.chromeBack">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="47" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.vaultPicker">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBackgroundBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style Selector="Button.sidebarSettings">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector=":is(Window).rail Border#WorkspaceSidebar Button.sidebarSettings">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="PathIcon.settingsGear">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.sidebarSettings:pointerover PathIcon.settingsGear">
            <Setter Property="RenderTransform" Value="rotate(40deg)" />
        </Style>
        <Style Selector="Button.sidebarSettings:flyout-open PathIcon.settingsGear">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="PathIcon.toastIcon">
            <Setter Property="Data" Value="{StaticResource IconInfo}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="PathIcon.toastIcon.success">
            <Setter Property="Data" Value="{StaticResource IconCheckCircle}" />
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="PathIcon.toastIcon.error">
            <Setter Property="Data" Value="{StaticResource IconWarning}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.vaultTitle">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.detailCommand">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.vaultTab.active">
            <Setter Property="Background" Value="{DynamicResource ListPaneBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="6,6,0,0" />
        </Style>
        <Style Selector=":is(Control).compactOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window).compactChrome :is(Control).compactOnly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(Window).compactChrome StackPanel#DesktopVaultTabs, :is(Window).compactChrome :is(Control).wideOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Control).compactExpandedOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window).compactChrome:not(.rail) :is(Control).compactExpandedOnly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(Control).railOnly, :is(Window).rail :is(Control).expandedOnly">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector=":is(Window).rail :is(Control).railOnly">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector=":is(Window).rail Border#WorkspaceSidebar Button.navItem">
            <Setter Property="Padding" Value="5,0" />
        </Style>
    </Window.Styles>

    <Grid x:Name="PresentationRoot" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Height="48" IsVisible="{Binding !UsesLeftWindowChrome}" Classes="desktopTitleSurface"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="WindowDragRegion_PointerPressed">
            <Grid ColumnDefinitions="*,Auto,*">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button x:Name="WorkspaceBackButton" Classes="subtle chromeBack" IsVisible="False" Click="WorkspaceBack_Click"
                            ToolTip.Tip="{DynamicResource Str_Back}" AutomationProperties.Name="{DynamicResource Str_Back}"
                            chrome:WindowDecorationProperties.ElementRole="User">
                        <PathIcon Data="{StaticResource IconBack}" Width="16" Height="16" />
                    </Button>
                    <controls:BrandLogo Width="20" Height="20" Margin="16,0,0,0" />
                    <TextBlock x:Name="DesktopWelcomeTitle" Text="KeeDesk" FontSize="14" Margin="4,0,0,0" VerticalAlignment="Center" />
                    <Panel x:Name="DesktopVaultPanel" IsVisible="False" chrome:WindowDecorationProperties.ElementRole="User">
                    <StackPanel x:Name="DesktopVaultTabs" Classes="wideOnly" Orientation="Horizontal" Spacing="4">
                        <Button Classes="subtle chromeCommand" Click="ToggleSidebar_Click" ToolTip.Tip="{DynamicResource Str_ToggleSidebar}" AutomationProperties.Name="{DynamicResource Str_ToggleSidebar}">
                            <PathIcon Data="{StaticResource IconPanel}" Width="16" Height="16" />
                        </Button>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxWidth="292">
                            <ItemsControl ItemsSource="{Binding OpenVaults}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VaultTabSession">
                                        <Border Classes="vaultTab" Classes.active="{Binding IsActive}" Width="144">
                                            <Grid ColumnDefinitions="*,28">
                                                <Button Classes="subtle" Padding="8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SwitchVaultTabCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding DisplayName}">
                                                    <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                                        <PathIcon Data="{StaticResource IconVault}" Width="16" Height="16" />
                                                        <TextBlock Grid.Column="1" Classes="vaultTitle" Text="{Binding DisplayName}" />
                                                    </Grid>
                                                </Button>
                                                <Button Grid.Column="1" Classes="subtle" Width="28" MinWidth="0" Padding="0"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CloseVaultTabCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="{DynamicResource Str_CloseVault}" AutomationProperties.Name="{DynamicResource Str_CloseVault}">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Classes="subtle chromeCommand" Command="{Binding OpenAnotherVaultCommand}" ToolTip.Tip="{DynamicResource Str_OpenAnotherVault2}" AutomationProperties.Name="{DynamicResource Str_OpenAnotherVault2}">
                            <PathIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="DesktopVaultPicker" Classes="subtle vaultPicker compactOnly" Width="144"
                            ToolTip.Tip="{Binding VaultDisplayName}" AutomationProperties.Name="{DynamicResource Str_SwitchVaults}"
                            Flyout="{StaticResource VaultSwitcherMenu}">
                        <Grid ColumnDefinitions="14,*,12" ColumnSpacing="6">
                            <PathIcon Data="{StaticResource IconDatabase}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock Grid.Column="1" Classes="vaultTitle" Text="{Binding VaultDisplayName}" FontWeight="SemiBold" />
                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>
                    </Button>
                    </Panel>
                </StackPanel>
                <Border x:Name="DesktopSearchSlot" Grid.Column="1" Width="360" VerticalAlignment="Center" IsVisible="False"
                        chrome:WindowDecorationProperties.ElementRole="User">
                    <Grid>
                        <TextBox x:Name="WinGlobalSearchBox" Text="{Binding SearchQuery}" PlaceholderText="{DynamicResource Str_SearchThisVault}"
                                 AutomationProperties.Name="{DynamicResource Str_SearchThisVault}" Padding="34,0,58,0" Height="32" KeyDown="Search_KeyDown" GotFocus="Search_FocusChanged" LostFocus="Search_FocusChanged" TextChanged="Search_TextChanged" />
                        <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Foreground="{DynamicResource SecondaryTextBrush}"
                                  HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <Border Background="{DynamicResource SidebarItemHoverBackgroundBrush}" CornerRadius="3" Padding="6,2"
                                IsVisible="{Binding !HasSearchQuery}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False">
                            <TextBlock Text="{Binding SearchShortcutHint}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Border>
                        <Button Classes="subtle chromeCommand" HorizontalAlignment="Right" IsVisible="{Binding HasSearchQuery}"
                                Click="ClearSearch_Click" ToolTip.Tip="{DynamicResource Str_ClearSearch}" AutomationProperties.Name="{DynamicResource Str_ClearSearch}"><PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" /></Button>
                        <Popup x:Name="WinSearchPopup" PlacementTarget="{Binding #WinGlobalSearchBox}" Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="4" ShouldUseOverlayLayer="True">
                            <Border Width="{Binding #WinGlobalSearchBox.Bounds.Width}" Background="{DynamicResource DetailBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{DynamicResource Str_MatchesInThisVault}" Margin="8,4" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <ListBox x:Name="WinSearchSuggestions" MaxHeight="228" Background="Transparent"
                                             ItemTemplate="{StaticResource SearchSuggestionTemplate}" Tapped="SearchSuggestion_Tapped"
                                             KeyDown="Search_KeyDown" LostFocus="Search_FocusChanged" AutomationProperties.Name="{DynamicResource Str_SearchSuggestions}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
                <StackPanel x:Name="DesktopCommands" Grid.Column="2" IsVisible="False" Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,192,0"
                            chrome:WindowDecorationProperties.ElementRole="User">
                    <Button Classes="subtle chromeCommand" AutomationProperties.Name="{DynamicResource Str_PasswordGenerator2}" ToolTip.Tip="{DynamicResource Str_PasswordGenerator2}" Command="{Binding OpenPasswordGeneratorCommandCommand}" ><PathIcon Data="{StaticResource IconGenerator}" Width="16" Height="16" /></Button>
                    <Button Classes="subtle chromeCommand" AutomationProperties.Name="{DynamicResource Str_LockVaultCtrlL}" ToolTip.Tip="{DynamicResource Str_LockVaultCtrlL}" Command="{Binding LockVaultCommand}" ><PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" /></Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="UnlockStage" ColumnDefinitions="Auto,1,*">
                <Border Grid.Column="0" Width="216" Background="{DynamicResource SidebarBackgroundBrush}"
                        PointerPressed="WindowDragRegion_PointerPressed">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <!-- macOS 顶部 48px 交通灯安全拖动区 -->
                        <Border Grid.Row="0" Height="48" IsVisible="{Binding UsesLeftWindowChrome}" Background="Transparent"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                                PointerPressed="WindowDragRegion_PointerPressed" />

                        <StackPanel Grid.Row="1" Margin="16,16,16,0" Spacing="4">
                            <TextBlock Text="{DynamicResource Str_Vaults}" Margin="4,0,4,8" FontSize="18" LineHeight="26"
                                       FontWeight="SemiBold" AutomationProperties.HeadingLevel="1" />
                            <Button Classes="subtle welcomeRailAction" Command="{Binding BrowseVaultFileCommand}"
                                    AutomationProperties.Name="{DynamicResource Str_OpenFile}">
                                <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_OpenFile}" />
                                </Grid>
                            </Button>
                            <Button Classes="subtle welcomeRailAction" Command="{Binding CreateNewVaultCommand}"
                                    AutomationProperties.Name="{DynamicResource Str_NewVault2}">
                                <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_NewVault2}" />
                                </Grid>
                            </Button>
                            <Button x:Name="WelcomeLocationsButton" Classes="subtle welcomeRailAction"
                                    ToolTip.Tip="{DynamicResource Str_VaultLocations}" AutomationProperties.Name="{DynamicResource Str_WelcomeVaultLocations}">
                                <Button.Flyout>
                                    <helpers:GlassMenuFlyout FlyoutPresenterClasses="workspaceMenu compactMenu" Placement="BottomEdgeAlignedLeft" VerticalOffset="4">
                                        <MenuItem Header="{DynamicResource Str_CloudDriveOpen}" Command="{Binding OpenCloudDriveCommand}" />
                                        <MenuItem Header="{DynamicResource Str_OpenCloudVault}" Command="{Binding OpenCloudVaultCommand}" />
                                        <MenuItem Header="{DynamicResource Str_OpenRemoteVault}" Command="{Binding OpenRemoteVaultCommand}" />
                                    </helpers:GlassMenuFlyout>
                                </Button.Flyout>
                                <Grid ColumnDefinitions="16,*,10" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconGlobe}" Width="16" Height="16" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_WelcomeVaultLocations}" />
                                    <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="10" Height="10"
                                              Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="16,24,16,12">
                            <TextBlock Text="{DynamicResource Str_RecentVaults2}" Margin="4,0,4,8" FontSize="12" LineHeight="18"
                                       FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"
                                       AutomationProperties.HeadingLevel="2" />
                            <ListBox Grid.Row="1" Classes="entryList workspaceList recentList" ItemsSource="{Binding RecentVaults}" SelectedItem="{Binding SelectedRecentVault}"
                                     IsVisible="{Binding HasRecentVaults}" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="{DynamicResource Str_RecentVaults2}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="entryCard" MinHeight="48" Padding="0,5">
                                            <Border.ContextMenu>
                                                <helpers:GlassContextMenu>
                                                    <MenuItem Header="{DynamicResource Str_RemoveFromRecents}"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentVaultCommand}"
                                                              CommandParameter="{Binding}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="{DynamicResource Str_ClearAllRecentVaults}"
                                                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearRecentVaultsCommand}">
                                                        <MenuItem.Icon>
                                                            <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </helpers:GlassContextMenu>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="6,24,*,Auto">
                                                <Border Grid.Column="0" Classes="entryIndicator" Width="3" Height="20" CornerRadius="2"
                                                        Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <PathIcon Grid.Column="1" Data="{StaticResource IconVault}" Width="16" Height="16"
                                                          Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,4,0" ToolTip.Tip="{Binding FileName}">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" LineHeight="18"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding FileName}" FontSize="11" LineHeight="16" Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="3" Classes="subtle recentRemoveBtn" Width="24" Height="24" MinHeight="0" Padding="0" Margin="0,0,4,0"
                                                        VerticalAlignment="Center" ToolTip.Tip="{DynamicResource Str_RemoveFromRecentsKeepTheLocalFile}"
                                                        AutomationProperties.Name="{DynamicResource Str_RemoveFromRecents}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveRecentVaultCommand}"
                                                        CommandParameter="{Binding}">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Grid.Row="1" Margin="4,2,4,0" IsVisible="{Binding !HasRecentVaults}"
                                       Text="{DynamicResource Str_NoRecentlyOpenedVaults}" FontSize="12" LineHeight="18"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>

                        <StackPanel Grid.Row="3" Spacing="4" Margin="16,0,16,12">
                            <Button Classes="subtle welcomeRailAction" Command="{Binding OpenDemoVaultCommand}"
                                    AutomationProperties.Name="{DynamicResource Str_OpenDemoVault}">
                                <Grid ColumnDefinitions="16,*" ColumnSpacing="8">
                                    <PathIcon Data="{StaticResource IconBook}" Width="16" Height="16" />
                                    <TextBlock Grid.Column="1" Text="{DynamicResource Str_OpenDemoVault}" />
                                </Grid>
                            </Button>
                            <Border Height="1" Margin="0,4" Background="{DynamicResource DividerBrush}" />
                            <Button x:Name="WelcomeSettingsButton" Classes="subtle sidebarSettings" Flyout="{StaticResource SidebarSettingsMenu}"
                                    Padding="10,0" FontSize="13" FontWeight="Normal"
                                    ToolTip.Tip="{DynamicResource Str_SettingsTitle}" AutomationProperties.Name="{DynamicResource Str_SettingsTitle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Classes="settingsGear" Data="{StaticResource IconSettings}" Width="16" Height="16" />
                                    <TextBlock Text="{DynamicResource Str_SettingsTitle}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 直通顶部的 1px 垂直分割线 -->
                <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

                <!-- 右侧纯净解锁主表单区 -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource ListPaneBackgroundBrush}">
                    <!-- 右侧顶部透明拖动区 -->
                    <Border Grid.Row="0" Height="48" IsVisible="{Binding UsesLeftWindowChrome}" Background="Transparent"
                            chrome:WindowDecorationProperties.ElementRole="TitleBar"
                            PointerPressed="WindowDragRegion_PointerPressed" />

                    <ScrollViewer Grid.Row="1" Padding="32,24,32,56" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <StackPanel Classes="welcomeForm" Classes.hasVault="{Binding HasUnlockVault}" MaxWidth="400"
                                        Spacing="24">
                                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                                    <Border x:Name="UnlockBadge" Width="44" Height="44" CornerRadius="8" VerticalAlignment="Top"
                                            Background="{DynamicResource BadgePillBackgroundBrush}">
                                        <PathIcon Data="{StaticResource IconLock}" Width="20" Height="20" Foreground="{DynamicResource AccentTextBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding UnlockVaultHeading}" FontSize="22" LineHeight="30"
                                                   FontWeight="SemiBold" AutomationProperties.HeadingLevel="1" />
                                        <TextBlock Text="{Binding UnlockVaultFileName}" IsVisible="{Binding HasUnlockVault}"
                                                   FontSize="12" LineHeight="18" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UnlockVaultFileName}" />
                                        <TextBlock Text="{DynamicResource Str_WelcomeChooseVault}" IsVisible="{Binding !HasUnlockVault}"
                                                   FontSize="13" LineHeight="19" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel IsVisible="{Binding !HasUnlockVault}" Spacing="12">
                                    <Button Classes="accent unlockAction" HorizontalAlignment="Left" Command="{Binding BrowseVaultFileCommand}"
                                            AutomationProperties.Name="{DynamicResource Str_OpenFile}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <PathIcon Data="{StaticResource IconFolderOpen}" Width="16" Height="16" />
                                            <TextBlock Text="{DynamicResource Str_OpenFile}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{DynamicResource Str_DropAKdbxFileHereToOpen}" FontSize="12" LineHeight="18"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasUnlockVault}" Spacing="12">
                                    <!-- 主密码（解锁失败时触发 macOS 风格水平微颤动画） -->
                                    <StackPanel x:Name="UnlockPasswordContainer" Spacing="4">
                                        <TextBlock Text="{DynamicResource Str_MasterPassword2}" FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBox x:Name="UnlockPasswordBox" Classes="unlockField" Text="{Binding UnlockMasterPassword}" PasswordChar="•"
                                                 AutomationProperties.Name="{DynamicResource Str_MasterPassword2}" PlaceholderText="{DynamicResource Str_EnterMasterPassword}" KeyDown="UnlockPassword_KeyDown" IsEnabled="{Binding !IsUnlocking}" />
                                        <TextBlock Text="{Binding UnlockError}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   IsVisible="{Binding UnlockError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <Expander x:Name="UnlockKeyOptions" Classes="disclosure unlockOptions" HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="{DynamicResource Str_UseAKeyFile}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Classes="disclosureChevron" Data="{StaticResource IconChevronDown}" Width="12" Height="12" />
                                                <TextBlock Classes="keyDisclosureLabel" FontSize="14" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Expander.Header>
                                        <Border Height="44" Margin="0,4,0,0" Padding="12,0,3,0" CornerRadius="4"
                                                Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="20,*,Auto,Auto,Auto" ColumnSpacing="6">
                                                <PathIcon Data="{StaticResource IconKey}" Width="20" Height="20" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding UnlockKeyFileDisplay}" FontSize="14" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UnlockKeyFileDisplay}" />
                                                <Button Grid.Column="2" Classes="welcomeAction subtle" Width="32" Padding="0" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{DynamicResource Str_RemoveSelectedKeyFile}" ToolTip.Tip="{DynamicResource Str_RemoveSelectedKeyFile}"
                                                        IsVisible="{Binding HasUnlockKeyFile}" Command="{Binding ClearKeyFileCommand}">
                                                    <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                                                </Button>
                                                <Button Grid.Column="3" Classes="welcomeAction" MinWidth="78" Content="{DynamicResource Str_Browse2}" VerticalAlignment="Center"
                                                        AutomationProperties.Name="{DynamicResource Str_BrowseForKeyFile}" Command="{Binding BrowseKeyFileCommand}" />
                                                <Button Grid.Column="4" Classes="welcomeAction subtle" MinWidth="92" Content="{DynamicResource Str_GenerateKeyx}" VerticalAlignment="Center"
                                                        ToolTip.Tip="{DynamicResource Str_GenerateANewXMLV20Key}" Command="{Binding GenerateKeyFileCommand}" />
                                            </Grid>
                                        </Border>
                                    </Expander>

                                    <!-- Windows 专属：使用当前 Windows 用户账户（DPAPI，100% 互通原版 KeePass 2.x） -->
                                    <CheckBox Content="{DynamicResource Str_UseWindowsUserAccountDPAPI}" FontSize="14"
                                              IsVisible="{Binding IsWindows}"
                                              IsChecked="{Binding UnlockUseWindowsUserAccount}" />

                                    <!-- macOS 专属：启用 Touch ID 快速解锁（主密码安全托管于 macOS 钥匙串） -->
                                    <CheckBox Content="{DynamicResource Str_EnableQuickUnlockWithTouchID}" FontSize="14" ToolTip.Tip="{DynamicResource Str_UnlockCredentialsAreStoredInTheMacOS}"
                                              IsVisible="{Binding CanEnableTouchId}"
                                              IsChecked="{Binding RememberForTouchId}" />

                                    <!-- 通栏解锁主按钮 + Touch ID 快速解锁 + 丝滑解密进度条 -->
                                    <StackPanel Spacing="8" Margin="0,4,0,0">
                                        <Button Classes="accent unlockAction" HorizontalAlignment="Stretch" Command="{Binding UnlockVaultCommand}" IsEnabled="{Binding !IsUnlocking}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{DynamicResource Str_UnlockVault}" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding !IsUnlocking}" />
                                                <TextBlock Text="{DynamicResource Str_DecryptingVault}" FontSize="14" FontWeight="SemiBold" IsVisible="{Binding IsUnlocking}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="unlockAction" HorizontalAlignment="Stretch"
                                                Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                                                IsVisible="{Binding CanUnlockWithTouchId}" IsEnabled="{Binding !IsUnlocking}"
                                                Command="{Binding UnlockWithTouchIdCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <PathIcon Data="{StaticResource IconShield}" Width="14" Height="14" Foreground="{DynamicResource BrandEmeraldBrush}" />
                                                <TextBlock Text="{DynamicResource Str_UseTouchID}" FontSize="14" FontWeight="Medium" />
                                            </StackPanel>
                                        </Button>
                                        <ProgressBar IsIndeterminate="True" Height="2" HorizontalAlignment="Stretch"
                                                     Foreground="{DynamicResource AccentButtonBackgroundBrush}"
                                                     IsVisible="{Binding IsUnlocking}" />
                                    </StackPanel>

                                    <TextBlock Text="{DynamicResource Str_UnlockOnThisDeviceYourFilesStay}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Grid x:Name="WorkspaceStage" IsVisible="False" ColumnDefinitions="Auto, 1, *" ClipToBounds="True">
                <Border x:Name="WorkspaceSidebar" Grid.Column="0" Width="240" PointerPressed="WindowDragRegion_PointerPressed">
                    <Grid RowDefinitions="Auto, *, Auto, 1, Auto">
                        <Border Height="48" IsVisible="{Binding UsesLeftWindowChrome}" Background="Transparent"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="WindowDragRegion_PointerPressed">
                            <Grid ColumnDefinitions="Auto,*">
                                <Border Width="{Binding LeftCaptionPadding}" />
                                <Border Grid.Column="1" Margin="4,0,16,0" VerticalAlignment="Center">
                                    <Button x:Name="MacVaultPicker" Classes="subtle vaultPicker" HorizontalAlignment="Stretch" IsVisible="{Binding IsUnlocked}"
                                            ToolTip.Tip="{Binding VaultDisplayName}" AutomationProperties.Name="{DynamicResource Str_SwitchVaults}"
                                            Flyout="{StaticResource VaultSwitcherMenu}" chrome:WindowDecorationProperties.ElementRole="User">
                                        <Grid ColumnDefinitions="14,*,12" ColumnSpacing="6">
                                            <PathIcon Data="{StaticResource IconDatabase}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Column="1" Classes="vaultTitle" Text="{Binding VaultDisplayName}" FontWeight="SemiBold" />
                                            <PathIcon Grid.Column="2" Data="{StaticResource IconChevronDown}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Grid>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" Padding="8,12">
                            <StackPanel Spacing="0">
                                <Button Classes="subtle chromeCommand compactExpandedOnly" HorizontalAlignment="Left"
                                        Click="ToggleSidebar_Click" ToolTip.Tip="{DynamicResource Str_ToggleSidebar}" AutomationProperties.Name="{DynamicResource Str_ToggleSidebar}">
                                    <PathIcon Data="{StaticResource IconPanel}" Width="16" Height="16" />
                                </Button>
                                <Button Classes="navItem" Classes.active="{Binding IsAllEntriesSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        Command="{Binding SelectSectionCommand}" CommandParameter="AllEntries" ToolTip.Tip="{DynamicResource Str_AllEntries}" AutomationProperties.Name="{DynamicResource Str_AllEntries}">
                                    <Grid ColumnDefinitions="6, 26, *, Auto">
                                        <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsAllEntriesSelected}" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconVault}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{DynamicResource Str_AllEntries}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" />
                                        <TextBlock Classes="expandedOnly" Grid.Column="3" Text="{Binding AllCount}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Button>

                                <Button Classes="navItem" Classes.active="{Binding IsFavoritesSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        Command="{Binding SelectSectionCommand}" CommandParameter="Favorites" ToolTip.Tip="{DynamicResource Str_Favorites}" AutomationProperties.Name="{DynamicResource Str_Favorites}">
                                    <Grid ColumnDefinitions="6, 26, *, Auto">
                                        <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsFavoritesSelected}" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconStar}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{DynamicResource Str_Favorites}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" />
                                        <TextBlock Classes="expandedOnly" Grid.Column="3" Text="{Binding FavoritesCount}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Button>

                                <Button Classes="navItem" Classes.active="{Binding IsTotpSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        Command="{Binding SelectSectionCommand}" CommandParameter="TotpOnly" ToolTip.Tip="{DynamicResource Str_Totp2Fa}" AutomationProperties.Name="{DynamicResource Str_Totp2Fa}">
                                    <Grid ColumnDefinitions="6, 26, *, Auto">
                                        <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsTotpSelected}" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconClock}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{DynamicResource Str_Totp2Fa}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" />
                                        <TextBlock Classes="expandedOnly" Grid.Column="3" Text="{Binding TotpCount}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    </Grid>
                                </Button>

                                <Button Classes="navItem" Classes.active="{Binding IsAuditSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        Command="{Binding SelectSectionCommand}" CommandParameter="SecurityAudit" ToolTip.Tip="{DynamicResource Str_SecurityAudit}" AutomationProperties.Name="{DynamicResource Str_SecurityAudit}">
                                    <Grid ColumnDefinitions="6, 26, *, Auto">
                                        <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                HorizontalAlignment="Left" IsVisible="{Binding IsAuditSelected}" />
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconShield}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="2" Classes="navLabel expandedOnly" Text="{DynamicResource Str_SecurityAudit}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <Button Classes="navItem railOnly" Click="ToggleSidebar_Click"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="{DynamicResource DensityNavItemHeight}"
                                        ToolTip.Tip="{DynamicResource Str_ExpandVaultGroups}" AutomationProperties.Name="{DynamicResource Str_ExpandVaultGroups}">
                                    <Grid ColumnDefinitions="6,26,*">
                                        <PathIcon Grid.Column="1" Data="{StaticResource IconFolder}" Width="16" Height="16" />
                                    </Grid>
                                </Button>
                                <StackPanel Classes="expandedOnly">
                                <!-- 密码分组（右侧 + 按钮新建根分组，每项支持右键新建子分组 / 重命名 / 删除） -->
                                <Grid ColumnDefinitions="*, Auto" Margin="8,14,4,4">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_Groups}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="subtle" Width="22" Height="22" MinHeight="22" Padding="0"
                                            ToolTip.Tip="{DynamicResource Str_NewGroup}" Command="{Binding AddRootGroupCommand}">
                                        <PathIcon Data="{StaticResource IconAdd}" Width="11" Height="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Button>
                                </Grid>
                                <TreeView ItemsSource="{Binding RootGroups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent" BorderThickness="0">
                                    <TreeView.Styles>
                                        <Style Selector="TreeViewItem" x:DataType="vm:GroupItemViewModel">
                                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </TreeView.Styles>
                                    <TreeView.ItemTemplate>
                                        <TreeDataTemplate ItemsSource="{Binding Children}">
                                            <Grid ColumnDefinitions="18, *, Auto" Height="{DynamicResource DensityNavItemHeight}" Background="Transparent"
                                                  DragDrop.AllowDrop="True"
                                                  DragDrop.DragOver="GroupItem_DragOver"
                                                  DragDrop.Drop="GroupItem_Drop">
                                                <Grid.ContextMenu>
                                                    <helpers:GlassContextMenu Classes="workspaceMenu compactMenu">
                                                        <MenuItem Header="{DynamicResource Str_NewSubgroup}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AddSubGroupCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconAdd}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_RenameEditNotes}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RenameGroupCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconEdit}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Str_MoveGroupUp}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveGroupUpCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconChevronDown}" RenderTransform="rotate(180deg)" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_MoveGroupDown}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveGroupDownCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconChevronDown}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_SortSubgroupsByName}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SortSubGroupsCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconSort}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Str_DeleteGroup}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteGroupCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconTrash}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </helpers:GlassContextMenu>
                                                </Grid.ContextMenu>
                                                <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource DensityFontSizeBody}" VerticalAlignment="Center" Margin="4,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding EntryCount}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            </Grid>
                                        </TreeDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>

                                <Border Height="1" Margin="8,4" Background="{DynamicResource DividerBrush}" />
                                <Expander x:Name="SidebarTagOptions" Classes="disclosure sidebarTags" HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="{DynamicResource Str_Tags}">
                                    <Expander.Header>
                                        <Grid ColumnDefinitions="6,26,*,16">
                                            <PathIcon Grid.Column="1" Data="{StaticResource IconTag}" Width="16" Height="16" />
                                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_Tags}" FontSize="{DynamicResource DensityFontSizeBody}"
                                                       VerticalAlignment="Center" />
                                            <PathIcon Grid.Column="3" Classes="disclosureChevron" Data="{StaticResource IconChevronDown}"
                                                      Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding AllTags}" Margin="12,0,12,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Classes="subtle" Padding="8,3" MinHeight="24" Margin="2"
                                                        Background="{DynamicResource BadgePillBackgroundBrush}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectTagCommand}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="{Binding StringFormat='#{0}'}" FontSize="11.5" Foreground="{DynamicResource BadgePillForegroundBrush}" />
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 固定钉在底部分割线上方的「回收站 (N)」（合并为单 TextBlock 保证基线 100% 对齐） -->
                        <Button Grid.Row="2" ToolTip.Tip="{DynamicResource Str_RecycleBin}" AutomationProperties.Name="{DynamicResource Str_RecycleBin}" Classes="navItem" Classes.active="{Binding IsRecycleBinSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Height="{DynamicResource DensityNavItemHeight}" Margin="8,2,8,6"
                                Command="{Binding SelectSectionCommand}" CommandParameter="RecycleBin">
                            <Grid ColumnDefinitions="6,26,*">
                                <Border Grid.Column="0" Width="3" Height="18" CornerRadius="2" Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                        HorizontalAlignment="Left" IsVisible="{Binding IsRecycleBinSelected}" />
                                <PathIcon Grid.Column="1" Data="{StaticResource IconTrash}" Width="16" Height="16" />
                                <TextBlock Grid.Column="2" Classes="navLabel expandedOnly"
                                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                            <DynamicResource ResourceKey="Str_RecycleBinFormat" />
                                            <Binding Path="RecycleBinCount" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Grid>
                        </Button>

                        <Border Grid.Row="3" Background="{DynamicResource DividerBrush}" />

                        <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="8,8,8,12">
                            <Button x:Name="WorkspaceSettingsButton" Classes="subtle sidebarSettings" Flyout="{StaticResource SidebarSettingsMenu}"
                                    ToolTip.Tip="{DynamicResource Str_SettingsTitle}" AutomationProperties.Name="{DynamicResource Str_SettingsTitle}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <PathIcon Classes="settingsGear" Data="{StaticResource IconSettings}" Width="16" Height="16" />
                                    <TextBlock Classes="expandedOnly" Text="{DynamicResource Str_SettingsTitle}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 垂直分割线 1（macOS 下直通窗口顶部！） -->
                <Border Grid.Column="1" Background="{DynamicResource DividerBrush}" />

                <!-- 右侧主内容区：安全审计仪表盘 或 中栏列表 + 右栏详情 -->
                <Grid Grid.Column="2" RowDefinitions="Auto,*,28">
                    <Border IsVisible="{Binding !UsesLeftWindowChrome}" Height="52" Background="{DynamicResource ListPaneBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                            <StackPanel IsVisible="{Binding !IsAuditViewActive}" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Classes="accent" Command="{Binding AddEntryCommand}" Padding="12,0" AutomationProperties.Name="{DynamicResource Str_New}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                                        <TextBlock Text="{DynamicResource Str_New}" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="subtle" Command="{Binding SaveVaultCommand}" ToolTip.Tip="{DynamicResource Str_SaveVaultCtrlS}" AutomationProperties.Name="{DynamicResource Str_SaveVault}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                                        <TextBlock Classes="wideOnly" Text="{DynamicResource Str_Save}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button IsVisible="{Binding IsAuditViewActive}" Command="{Binding RefreshAuditCommand}" HorizontalAlignment="Left" Content="{DynamicResource Str_ScanAgain}" />
                            <Button Grid.Column="1" Classes="subtle chromeCommand" ToolTip.Tip="{DynamicResource Str_MoreVaultCommands}" AutomationProperties.Name="{DynamicResource Str_MoreVaultCommands}">
                                <Button.Flyout>
                                    <helpers:GlassMenuFlyout FlyoutPresenterClasses="workspaceMenu compactMenu" Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="{DynamicResource Str_OpenVault}" InputGesture="Ctrl+O" Command="{Binding OpenAnotherVaultCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderOpen}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_OpenRemoteVault}" Command="{Binding OpenRemoteVaultCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconGlobe}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_CloudDriveOpen}" Command="{Binding OpenCloudDriveCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconGlobe}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_OpenCloudVault}" Command="{Binding OpenCloudVaultCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconFolderOpen}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_SaveAs}" Command="{Binding SaveVaultAsCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconSave}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_CloudDriveUpload}" Command="{Binding UploadCloudDriveCopyCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconSave}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_AdvancedSearch2}" Command="{Binding OpenAdvancedSearchAsyncCommandCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconSearch}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_DatabaseSettings}" Command="{Binding OpenDatabaseSettingsAsyncCommandCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconSettings}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Str_VaultMaintenance}" Command="{Binding OpenDatabaseMaintenanceAsyncCommandCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_MergeSyncAnotherVault}" Command="{Binding MergeDatabaseCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconMerge}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_SyncWithLocalVaultMenu}" Command="{Binding SynchronizeVaultCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_SyncRemoteVault}" Command="{Binding SynchronizeRemoteVaultCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconGlobe}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_CloudDriveSync}" Command="{Binding SynchronizeCloudDriveCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_SyncCloudVault}" Command="{Binding SynchronizeCloudVaultCommand}">
                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{DynamicResource Str_MigrationImport}" Command="{Binding ImportVaultMigrationCommand}" />
                                        <MenuItem Header="{DynamicResource Str_PrintVault}" Command="{Binding PrintVaultCommand}" />
                                    </helpers:GlassMenuFlyout>
                                </Button.Flyout>
                                <PathIcon Data="{StaticResource IconMore}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" IsVisible="{Binding IsAuditViewActive}" RowDefinitions="Auto,*" Background="{DynamicResource ListPaneBackgroundBrush}">
                        <Border Height="48" Padding="12,0" IsVisible="{Binding UsesLeftWindowChrome}"
                                Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="WindowDragRegion_PointerPressed">
                            <Grid ColumnDefinitions="*,Auto">
                                <Button HorizontalAlignment="Left" Command="{Binding RefreshAuditCommand}" Content="{DynamicResource Str_ScanAgain}"
                                        chrome:WindowDecorationProperties.ElementRole="User" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                            chrome:WindowDecorationProperties.ElementRole="User">
                                    <Button Classes="subtle chromeCommand" Command="{Binding SaveVaultCommand}"  AutomationProperties.Name="{DynamicResource Str_SaveVault}">
                                        <ToolTip.Tip>
                                            <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                <DynamicResource ResourceKey="Str_SaveVaultSFormat" />
                                                <Binding Path="ShortcutModifier" />
                                            </MultiBinding>
                                        </ToolTip.Tip>
                                        <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                                    </Button>
                                    <Button Classes="subtle chromeCommand" Command="{Binding OpenPasswordGeneratorCommandCommand}"
                                             AutomationProperties.Name="{DynamicResource Str_PasswordGenerator2}">
                                        <ToolTip.Tip>
                                            <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                <DynamicResource ResourceKey="Str_PasswordGeneratorGFormat" />
                                                <Binding Path="ShortcutModifier" />
                                            </MultiBinding>
                                        </ToolTip.Tip>
                                        <PathIcon Data="{StaticResource IconGenerator}" Width="16" Height="16" />
                                    </Button>
                                    <Button Classes="subtle chromeCommand" Command="{Binding LockVaultCommand}"
                                             AutomationProperties.Name="{DynamicResource Str_LockVault2}">
                                        <ToolTip.Tip>
                                            <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                <DynamicResource ResourceKey="Str_LockVaultLFormat" />
                                                <Binding Path="ShortcutModifier" />
                                            </MultiBinding>
                                        </ToolTip.Tip>
                                        <PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" Padding="28">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{DynamicResource Str_SecurityAudit}" FontSize="28" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AuditCheckedDisplay}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Border Background="{DynamicResource AttentionBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="12,10">
                                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                        <PathIcon Data="{StaticResource IconWarning}" Width="18" Height="18" Foreground="{DynamicResource WarningBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock
                                                       FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                        <DynamicResource ResourceKey="Str_EntriesNeedAttentionFormat" />
                                                        <Binding Path="AuditAffectedCount" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock Text="{DynamicResource Str_AnEntryCanAppearInMultipleRisk}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Classes="fluentCard" Padding="12,10">
                                    <StackPanel Spacing="8">
                                        <WrapPanel Orientation="Horizontal">
                                            <Button Content="{DynamicResource Str_FindSimilarPasswords}" Command="{Binding ScanSimilarPasswordsCommand}"
                                                    IsVisible="{Binding !ScanSimilarPasswordsCommand.IsRunning}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ScanSimilarPasswordsCommand.IsRunning}">
                                                <TextBlock Text="{DynamicResource Str_ScanningSimilarPasswords}" VerticalAlignment="Center"
                                                           AutomationProperties.LiveSetting="Polite" />
                                                <Button Classes="subtle" Content="{DynamicResource Str_Cancel}" Command="{Binding ScanSimilarPasswordsCancelCommand}" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <StackPanel IsVisible="{Binding HasSimilarPasswordScanResult}">
                                            <TextBlock Text="{DynamicResource Str_NoSimilarPasswords}" IsVisible="{Binding IsSimilarPasswordScanEmpty}"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" AutomationProperties.LiveSetting="Polite" />
                                            <ListBox ItemsSource="{Binding AuditSimilarPasswords}" IsVisible="{Binding !IsSimilarPasswordScanEmpty}"
                                                     MaxHeight="284" Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     AutomationProperties.Name="{DynamicResource Str_FindSimilarPasswords}">
                                                <ListBox.Styles>
                                                    <Style Selector="ListBoxItem">
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    </Style>
                                                </ListBox.Styles>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SimilarPasswordPairViewModel">
                                                        <StackPanel>
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,4">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                                        <DynamicResource ResourceKey="Str_PasswordSimilarityFormat" />
                                                                        <Binding Path="Similarity" />
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <ContentControl Content="{Binding First}" ContentTemplate="{StaticResource AuditFindingTemplate}" />
                                                            <ContentControl Content="{Binding Second}" ContentTemplate="{StaticResource AuditFindingTemplate}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{DynamicResource Str_ViewByRisk}" FontSize="20" FontWeight="SemiBold" />
                                <TabControl Classes="compactTabs">
                                    <TabItem>
                                        <TabItem.Header>
                                            <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                <DynamicResource ResourceKey="Str_WeakPasswordsFormat" />
                                                <Binding Path="AuditWeakEntries.Count" />
                                            </MultiBinding>
                                        </TabItem.Header>
                                        <Border Classes="fluentCard" Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding AuditWeakEntries}" ItemTemplate="{StaticResource AuditFindingTemplate}" />
                                        </Border>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                <DynamicResource ResourceKey="Str_ReusedPasswordsFormat" />
                                                <Binding Path="AuditReusedEntries.Count" />
                                            </MultiBinding>
                                        </TabItem.Header>
                                        <Border Classes="fluentCard" Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding AuditReusedEntries}" ItemTemplate="{StaticResource AuditFindingTemplate}" />
                                        </Border>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                <DynamicResource ResourceKey="Str_ExpiredOrExpiringFormat" />
                                                <Binding Path="AuditExpiringEntries.Count" />
                                            </MultiBinding>
                                        </TabItem.Header>
                                        <Border Classes="fluentCard" Margin="0,12,0,0">
                                            <ItemsControl ItemsSource="{Binding AuditExpiringEntries}" ItemTemplate="{StaticResource AuditFindingTemplate}" />
                                        </Border>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                <DynamicResource ResourceKey="Str_VerificationCodesConfiguredFormat" />
                                                <Binding Path="TotpCount" />
                                            </MultiBinding>
                                        </TabItem.Header>
                                        <StackPanel Spacing="8" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource Str_SignInEntriesWithoutVerificationCodes}" FontWeight="SemiBold" />
                                            <Border Classes="fluentCard">
                                                <ItemsControl ItemsSource="{Binding AuditNo2FaEntries}" ItemTemplate="{StaticResource AuditFindingTemplate}" />
                                            </Border>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 中栏条目列表 + 右栏详情面板 -->
                    <Grid x:Name="EntryWorkspace" Grid.Row="1" IsVisible="{Binding !IsAuditViewActive}" ColumnDefinitions="344,1,*">
                        <!-- PANE 2: 中栏条目列表（macOS 顶部直接内置搜索框 + 新建条目按钮，对应画板 02） -->
                        <Border Grid.Column="0" x:Name="EntryPane" Background="{DynamicResource ListPaneBackgroundBrush}">
                            <Grid RowDefinitions="Auto, Auto, Auto, *">
                                <Border Grid.Row="0" IsVisible="{Binding UsesLeftWindowChrome}" Height="48" Padding="12,0"
                                        Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                        chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="WindowDragRegion_PointerPressed">
                                    <Grid ColumnDefinitions="*,10,Auto" VerticalAlignment="Center">
                                        <Grid chrome:WindowDecorationProperties.ElementRole="User">
                                            <TextBox x:Name="MacGlobalSearchBox" Text="{Binding SearchQuery}" PlaceholderText="{DynamicResource Str_SearchThisVault}"
                                                     AutomationProperties.Name="{DynamicResource Str_SearchThisVault}" Padding="34,0,58,0" Height="32" KeyDown="Search_KeyDown" GotFocus="Search_FocusChanged" LostFocus="Search_FocusChanged" TextChanged="Search_TextChanged" />
                                            <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16" Foreground="{DynamicResource SecondaryTextBrush}"
                                                      HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                                            <Border Background="{DynamicResource SidebarItemHoverBackgroundBrush}" CornerRadius="3" Padding="6,2"
                                                    IsVisible="{Binding !HasSearchQuery}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False">
                                                <TextBlock Text="{Binding SearchShortcutHint}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </Border>
                                            <Button Classes="subtle chromeCommand" HorizontalAlignment="Right" IsVisible="{Binding HasSearchQuery}"
                                                    Click="ClearSearch_Click" ToolTip.Tip="{DynamicResource Str_ClearSearch}" AutomationProperties.Name="{DynamicResource Str_ClearSearch}"><PathIcon Data="{StaticResource IconClose}" Width="16" Height="16" /></Button>
                                            <Popup x:Name="MacSearchPopup" PlacementTarget="{Binding #MacGlobalSearchBox}" Placement="BottomEdgeAlignedLeft"
                                                   VerticalOffset="4" ShouldUseOverlayLayer="True">
                                                <Border Width="{Binding #MacGlobalSearchBox.Bounds.Width}" Background="{DynamicResource DetailBackgroundBrush}"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{DynamicResource Str_MatchesInThisVault}" Margin="8,4" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <ListBox x:Name="MacSearchSuggestions" MaxHeight="228" Background="Transparent"
                                                                 ItemTemplate="{StaticResource SearchSuggestionTemplate}" Tapped="SearchSuggestion_Tapped"
                                                                 KeyDown="Search_KeyDown" LostFocus="Search_FocusChanged" AutomationProperties.Name="{DynamicResource Str_SearchSuggestions}" />
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <Button Grid.Column="2" Classes="accent chromeCommand" Command="{Binding AddEntryCommand}"
                                                AutomationProperties.Name="{DynamicResource Str_New}"
                                                chrome:WindowDecorationProperties.ElementRole="User">
                                            <ToolTip.Tip>
                                                <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                    <DynamicResource ResourceKey="Str_NewNFormat" />
                                                    <Binding Path="ShortcutModifier" />
                                                </MultiBinding>
                                            </ToolTip.Tip>
                                            <PathIcon Data="{StaticResource IconAdd}" Width="16" Height="16" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="20,12,12,8">
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentFilterTitle}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                    <DynamicResource ResourceKey="Str_EntriesFormat" />
                                                    <Binding Path="FilteredEntries.Count" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                                        <Button IsVisible="{Binding IsRecycleBinSelected}" IsEnabled="{Binding HasRecycleBinItems}"
                                                Foreground="{DynamicResource DangerBrush}" Command="{Binding EmptyRecycleBinCommand}" Content="{DynamicResource Str_EmptyRecycleBin}" />
                                        <Button Classes="subtle chromeCommand" Command="{Binding ToggleSortOrderCommand}"
                                                ToolTip.Tip="{Binding SortButtonLabel}" AutomationProperties.Name="{DynamicResource Str_SortEntries}">
                                            <PathIcon Data="{StaticResource IconSort}" Width="16" Height="16" />
                                        </Button>
                                        <Button Classes="subtle chromeCommand" Command="{Binding OpenAdvancedSearchAsyncCommandCommand}"
                                                ToolTip.Tip="{DynamicResource Str_AdvancedSearch2}" AutomationProperties.Name="{DynamicResource Str_AdvancedSearch2}">
                                            <PathIcon Data="{StaticResource IconFilter}" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 多选批量操作条（选中 2 条及以上时自动显示） -->
                                <Border Grid.Row="2" Classes="fluentCard" Margin="12,0,12,6" Padding="10,6"
                                        IsVisible="{Binding HasMultipleSelectedEntries}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrandEmeraldBrush}" VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                    <DynamicResource ResourceKey="Str_SelectedFormat" />
                                                    <Binding Path="SelectedEntriesCount" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Height="24" MinHeight="24" Padding="8,0" FontSize="11.5" Content="{DynamicResource Str_BatchMove}" Command="{Binding BatchMoveEntriesCommand}" />
                                            <Button Height="24" MinHeight="24" Padding="8,0" FontSize="11.5" Content="{DynamicResource Str_BatchFav}" Command="{Binding BatchFavoriteEntriesCommand}" />
                                            <Button Height="24" MinHeight="24" Padding="8,0" FontSize="11.5" Foreground="{DynamicResource DangerBrush}" Content="{DynamicResource Str_BatchDelete}" Command="{Binding BatchDeleteEntriesCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 条目列表（支持单选、Cmd/Ctrl 多选批量操作、右键快捷菜单与拖拽到分组树） -->
                                <ListBox Grid.Row="3" x:Name="EntryListBox" Classes="entryList workspaceList"
                                         Tapped="EntryList_Tapped" KeyDown="EntryList_KeyDown"
                                         SelectionMode="Multiple"
                                         SelectionChanged="EntryListBox_SelectionChanged"
                                         ItemsSource="{Binding FilteredEntries}" SelectedItem="{Binding SelectedEntry}"
                                         Background="Transparent" BorderThickness="0" Padding="10,2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Classes="entryCard" Height="{DynamicResource DensityRowHeight}"
                                                    PointerPressed="EntryCard_PointerPressed"
                                                    PointerMoved="EntryCard_PointerMoved">
                                                <Border.ContextMenu>
                                                    <helpers:GlassContextMenu Classes="workspaceMenu compactMenu">
                                                        <MenuItem Header="{DynamicResource Str_CopyUsername}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyEntryUserNameCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconCopy}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_CopyPassword}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyEntryPasswordCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconKey}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_CopyVerificationCodeTOTP}" IsVisible="{Binding HasTotp}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyEntryTotpCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconClock}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_OpenURL}" IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenEntryUrlCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconLink}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_CopyURL}" IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyEntryUrlCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconGlobe}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_PerformAutoType}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PerformAutoTypeCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconKeyboard}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Str_EditEntry}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).EditEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconEdit}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_ViewHistory}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ViewEntryHistoryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconHistory}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_DuplicateEntry}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DuplicateEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconCopy}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_MoveToGroup}"
                                                                  IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).MoveEntryToGroupCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconFolder}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_ToggleFavorite}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFavoriteEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconStar}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_ExpirationPresets}"
                                                                  IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconClock}" /></MenuItem.Icon>
                                                            <MenuItem Header="{DynamicResource Str_ExpireNow}"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickExpireNowCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="{DynamicResource Str_NeverExpire}"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickExpireNeverCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <Separator />
                                                            <MenuItem Header="{DynamicResource Str_ExpiresIn30Days}"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickExpireIn30DaysCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="{DynamicResource Str_ExpiresIn90Days}"
                                                                      Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickExpireIn90DaysCommand}"
                                                                      CommandParameter="{Binding}" />
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="{DynamicResource Str_RestoreFromRecycleBin}"
                                                                  IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RestoreEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconRefresh}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_MoveToRecycleBin}"
                                                                  IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}"
                                                                  CommandParameter="{Binding}" Click="MoveEntryToRecycleBin_Click">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconTrash}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_DeletePermanently}"
                                                                  IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsRecycleBinSelected}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PermanentlyDeleteEntryCommand}"
                                                                  CommandParameter="{Binding}">
                                                            <MenuItem.Icon>
                                                                <PathIcon Data="{StaticResource IconTrash}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </helpers:GlassContextMenu>
                                                </Border.ContextMenu>
                                                <Grid ColumnDefinitions="12, Auto, *, Auto" Margin="0,0,12,0">
                                                    <!-- 选中态左侧 3×24px 品牌指示条 -->
                                                    <Border Grid.Column="0" Classes="entryIndicator" Width="3" Height="24" CornerRadius="2"
                                                            Background="{DynamicResource SystemControlHighlightAccentBrush}"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center" />

                                                    <Border Grid.Column="1" Classes="entryAvatar" Width="{DynamicResource DensityAvatarSize}" Height="{DynamicResource DensityAvatarSize}"
                                                            CornerRadius="6" Background="{DynamicResource BadgePillBackgroundBrush}" VerticalAlignment="Center" Margin="4,0,10,0" ClipToBounds="True">
                                                        <Panel>
                                                            <PathIcon Data="{Binding StandardIcon}" Width="20" Height="20" IsVisible="{Binding HasStandardIcon}"
                                                                      Foreground="{DynamicResource BadgePillForegroundBrush}" />
                                                            <TextBlock Classes="entryAvatarText" Text="{Binding Initials}" FontWeight="SemiBold" FontSize="12"
                                                                       Foreground="{DynamicResource BadgePillForegroundBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       IsVisible="{Binding ShowInitials}" />
                                                            <Image Source="{Binding CustomIconBitmap}" Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasCustomIcon}" />
                                                        </Panel>
                                                    </Border>

                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{DynamicResource DensityFontSizeBody}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding UserName}" FontSize="{DynamicResource DensityFontSizeCaption}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource IconStar}" Width="16" Height="16" IsVisible="{Binding IsFavorite}"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <PathIcon Data="{StaticResource IconClock}" Width="16" Height="16" IsVisible="{Binding HasTotp}"
                                                                  Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <TextBlock Text="{Binding ExpiryBadge}" FontSize="12" Foreground="{DynamicResource WarningBrush}"
                                                                   IsVisible="{Binding HasExpiryBadge}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border x:Name="EntryDivider" Grid.Column="1" Background="{DynamicResource DividerBrush}" />

                        <Grid x:Name="EntryDetail" Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource DetailBackgroundBrush}">
                            <Border Grid.Row="0" Height="48" Padding="20,0" IsVisible="{Binding UsesLeftWindowChrome}" Background="Transparent"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                                    chrome:WindowDecorationProperties.ElementRole="TitleBar" PointerPressed="WindowDragRegion_PointerPressed">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding SelectedEntry.GroupPath}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                                                chrome:WindowDecorationProperties.ElementRole="User">
                                        <Button Classes="subtle chromeCommand" AutomationProperties.Name="{DynamicResource Str_SaveVault}" Command="{Binding SaveVaultCommand}">
                                            <ToolTip.Tip>
                                                <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                    <DynamicResource ResourceKey="Str_SaveVaultSFormat" />
                                                    <Binding Path="ShortcutModifier" />
                                                </MultiBinding>
                                            </ToolTip.Tip>
                                            <PathIcon Data="{StaticResource IconSave}" Width="16" Height="16" />
                                        </Button>
                                        <Button Classes="subtle chromeCommand" AutomationProperties.Name="{DynamicResource Str_PasswordGenerator2}" Command="{Binding OpenPasswordGeneratorCommandCommand}">
                                            <ToolTip.Tip>
                                                <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                    <DynamicResource ResourceKey="Str_PasswordGeneratorGFormat" />
                                                    <Binding Path="ShortcutModifier" />
                                                </MultiBinding>
                                            </ToolTip.Tip>
                                            <PathIcon Data="{StaticResource IconGenerator}" Width="16" Height="16" />
                                        </Button>
                                        <Button Classes="subtle chromeCommand" AutomationProperties.Name="{DynamicResource Str_LockVault2}" Command="{Binding LockVaultCommand}">
                                            <ToolTip.Tip>
                                                <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                    <DynamicResource ResourceKey="Str_LockVaultLFormat" />
                                                    <Binding Path="ShortcutModifier" />
                                                </MultiBinding>
                                            </ToolTip.Tip>
                                            <PathIcon Data="{StaticResource IconLock}" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Panel x:Name="DetailSelectionRegion" Grid.Row="1">
                            <!-- 空状态 -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6"
                                        IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNull}}">
                                <PathIcon Data="{StaticResource IconShield}" Width="28" Height="28" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.5" />
                                <TextBlock Text="{DynamicResource Str_SelectAnEntryToViewItsDetails}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" MaxWidth="320" />
                            </StackPanel>

                            <!-- 详情主体 -->
                            <ScrollViewer Grid.Row="1" Padding="20,12,20,16" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding SelectedEntry, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="9" MaxWidth="720">
                                    <TextBlock IsVisible="{Binding !UsesLeftWindowChrome}" Text="{Binding SelectedEntry.GroupPath}" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                    <!-- 条目头图与标题 -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Grid ColumnDefinitions="36,*" ColumnSpacing="9">
                                        <Border Width="36" Height="36" CornerRadius="6" Background="{DynamicResource BadgePillBackgroundBrush}" ClipToBounds="True">
                                            <Panel>
                                                <PathIcon Data="{Binding SelectedEntry.StandardIcon}" Width="20" Height="20"
                                                          Foreground="{DynamicResource BadgePillForegroundBrush}" IsVisible="{Binding SelectedEntry.HasStandardIcon}" />
                                                <TextBlock Text="{Binding SelectedEntry.Initials}" FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource BadgePillForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           IsVisible="{Binding SelectedEntry.ShowInitials}" />
                                                <Image Source="{Binding SelectedEntry.CustomIconBitmap}" Stretch="UniformToFill"
                                                       IsVisible="{Binding SelectedEntry.HasCustomIcon}" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding SelectedEntry.Title}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SelectedEntry.EntryKind}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <Button Command="{Binding EditSelectedEntryCommand}" Height="28" MinHeight="28" Padding="8,0" FontSize="12" ToolTip.Tip="{DynamicResource Str_Edit}" AutomationProperties.Name="{DynamicResource Str_Edit}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" />
                                                    <TextBlock Text="{DynamicResource Str_Edit}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="subtle detailCommand" AutomationProperties.Name="{DynamicResource Str_ToggleFavorite}" ToolTip.Tip="{DynamicResource Str_ToggleFavorite}" Command="{Binding ToggleFavoriteSelectedCommand}" ><PathIcon Data="{StaticResource IconStar}" Width="14" Height="14" /></Button>
                                            <Button Classes="subtle detailCommand" ToolTip.Tip="{DynamicResource Str_MoreEntryActions}" AutomationProperties.Name="{DynamicResource Str_MoreEntryActions}">
                                                <Button.Flyout>
                                                    <helpers:GlassMenuFlyout FlyoutPresenterClasses="workspaceMenu compactMenu" Placement="BottomEdgeAlignedRight">
                                                        <MenuItem Header="{DynamicResource Str_CopyUsername}" Command="{Binding CopyUserNameCommand}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconCopy}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_ViewHistory}" Command="{Binding ViewEntryHistoryCommand}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconHistory}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_RestoreFromRecycleBin}" Command="{Binding RestoreSelectedEntryCommand}" IsVisible="{Binding IsRecycleBinSelected}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconRefresh}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="{DynamicResource Str_MoveToRecycleBin}" Click="MoveEntryToRecycleBin_Click" IsVisible="{Binding !IsRecycleBinSelected}">
                                                            <MenuItem.Icon><PathIcon Data="{StaticResource IconTrash}" /></MenuItem.Icon>
                                                        </MenuItem>
                                                    </helpers:GlassMenuFlyout>
                                                </Button.Flyout>
                                                <PathIcon Data="{StaticResource IconMore}" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <TextBlock Text="{DynamicResource Str_SignInDetails}" FontSize="16" FontWeight="SemiBold" />

                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8" Margin="9,4,6,4" MinHeight="34">
                                                <PathIcon Data="{StaticResource IconPerson}" Width="15" Height="15" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Str_UserName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <SelectableTextBlock Text="{Binding SelectedEntry.UserName}" FontSize="13" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Classes="subtle detailCommand" VerticalAlignment="Center"
                                                        ToolTip.Tip="{DynamicResource Str_CopyUsername}" AutomationProperties.Name="{DynamicResource Str_CopyUsername}" Command="{Binding CopyUserNameCommand}">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" IsVisible="{Binding !IsUserNameCopied}" />
                                                        <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsUserNameCopied}" />
                                                    </Panel>
                                                </Button>
                                            </Grid>
                                            <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8" Margin="9,4,6,4" MinHeight="34">
                                                <PathIcon Data="{StaticResource IconKey}" Width="15" Height="15" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource Str_Password}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding SelectedEntry.DisplayedPassword}" FontFamily="Consolas,Menlo,monospace" FontSize="13" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                                    <Button x:Name="PasswordRevealButton" Classes="subtle detailCommand" ToolTip.Tip="{DynamicResource Str_HoldToRevealPassword}"
                                                            AutomationProperties.Name="{DynamicResource Str_HoldToRevealPassword}">
                                                        <PathIcon Data="{StaticResource IconEye}" Width="14" Height="14" />
                                                    </Button>
                                                    <Button Classes="subtle detailCommand" Command="{Binding CopyPasswordCommand}" ToolTip.Tip="{DynamicResource Str_CopyPassword}" AutomationProperties.Name="{DynamicResource Str_CopyPassword}">
                                                        <Panel>
                                                            <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" IsVisible="{Binding !IsPasswordCopied}" />
                                                            <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsPasswordCopied}" />
                                                        </Panel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel IsVisible="{Binding SelectedEntry.Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                                <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8" Margin="9,4,6,4" MinHeight="34">
                                                    <PathIcon Data="{StaticResource IconGlobe}" Width="15" Height="15" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Str_Url}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <SelectableTextBlock Text="{Binding SelectedEntry.Url}" FontSize="13" Foreground="{DynamicResource AccentTextBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                                        <Button Classes="subtle detailCommand" Click="OpenUrl_Click" ToolTip.Tip="{DynamicResource Str_OpenWebsite}" AutomationProperties.Name="{DynamicResource Str_OpenWebsite}">
                                                            <PathIcon Data="{StaticResource IconLink}" Width="14" Height="14" />
                                                        </Button>
                                                        <Button Classes="subtle detailCommand" Command="{Binding CopyEntryUrlCommand}" CommandParameter="{Binding SelectedEntry}"
                                                                ToolTip.Tip="{DynamicResource Str_CopyURL}" AutomationProperties.Name="{DynamicResource Str_CopyURL}">
                                                            <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="6" IsVisible="{Binding SelectedEntry.HasTotp}">
                                        <TextBlock Text="{DynamicResource Str_TotpLabel}" FontSize="16" FontWeight="SemiBold" />
                                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,5,6,7">
                                            <Grid ColumnDefinitions="16,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                                                <PathIcon Data="{StaticResource IconClock}" Width="15" Height="15" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding SelectedEntry.TotpFormatted}" FontFamily="Consolas,Menlo,monospace" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1"
                                                               FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding Converter="{x:Static services:LocalizationService.FormatConverter}">
                                                                <DynamicResource ResourceKey="Str_SRemainingFormat" />
                                                                <Binding Path="SelectedEntry.TotpRemaining" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </Grid>
                                                <Button Grid.Column="2" Classes="subtle detailCommand" Command="{Binding CopyTotpCommand}"
                                                        ToolTip.Tip="{DynamicResource Str_CopyVerificationCode}" AutomationProperties.Name="{DynamicResource Str_CopyVerificationCode}">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" IsVisible="{Binding !IsTotpCopied}" />
                                                        <PathIcon Data="{StaticResource IconCheck}" Width="14" Height="14" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsTotpCopied}" />
                                                    </Panel>
                                                </Button>
                                                <Border x:Name="TotpProgressTrack" Grid.Row="1" Grid.Column="1" Height="2" Margin="0,2,0,0"
                                                        CornerRadius="1" ClipToBounds="True" Background="{DynamicResource DividerBrush}">
                                                    <Border x:Name="TotpProgressFill" CornerRadius="1" RenderTransformOrigin="0%,50%"
                                                            Background="{DynamicResource AccentButtonBackgroundBrush}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Spacing="5" IsVisible="{Binding SelectedEntry.HasAnnotations}">
                                            <TextBlock Text="{DynamicResource Str_Notes}" FontSize="16" FontWeight="SemiBold" />
                                            <SelectableTextBlock Text="{Binding SelectedEntry.Notes}" FontSize="13" LineHeight="18" TextWrapping="Wrap"
                                                                 IsVisible="{Binding SelectedEntry.Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.DisplayTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="4" Padding="6,2" Background="{DynamicResource SidebarItemHoverBackgroundBrush}">
                                                            <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.CustomFields}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="2*, 3*, Auto" ColumnSpacing="8" Margin="0,1">
                                                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12.5" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                                            <SelectableTextBlock Grid.Column="1" Text="{Binding DisplayValue}" FontSize="13" VerticalAlignment="Center" />
                                                            <Button Grid.Column="2" Classes="subtle" Width="28" Height="28" MinHeight="28" Padding="0"
                                                                    ToolTip.Tip="{DynamicResource Str_CopyCustomFields}"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyCustomFieldCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding SelectedEntry.Attachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,3,0,0" HorizontalAlignment="Left" CornerRadius="6"
                                                                Background="{DynamicResource CardSubtleBackgroundBrush}"
                                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <Button Classes="subtle" Padding="8,0" Height="28" MinHeight="28"
                                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        ToolTip.Tip="{Binding FileName}" AutomationProperties.Name="{Binding DisplayLabel}"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PreviewAttachmentCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="13,*" ColumnSpacing="6">
                                                                        <PathIcon Data="{StaticResource IconAttach}" Width="13" Height="13" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayLabel}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                                <Button Grid.Column="1" Classes="subtle" Width="28" Height="28" MinHeight="28" Padding="0"
                                                                        ToolTip.Tip="{DynamicResource Str_ExportADecryptedCopyOfTheAttachment}"
                                                                        AutomationProperties.Name="{DynamicResource Str_ExportADecryptedCopyOfTheAttachment}"
                                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ExportAttachmentCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <PathIcon Data="{StaticResource IconExport}" Width="12" Height="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" />
                                    <TextBlock Text="{Binding SelectedEntry.UpdatedDisplay}" FontSize="12" HorizontalAlignment="Right" ToolTip.Tip="{Binding SelectedEntry.FooterMeta}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </ScrollViewer>
                            </Panel>
                            <StackPanel x:Name="SearchDetailsPlaceholder" Grid.Row="1" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Spacing="12" IsVisible="False" MaxWidth="360" Margin="24">
                                <PathIcon Data="{StaticResource IconSearch}" Width="24" Height="24" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock x:Name="SearchResultMessage" TextAlignment="Center" TextWrapping="Wrap"
                                           FontSize="16" FontWeight="SemiBold" />
                                <Button x:Name="ClearEmptySearchButton" Click="ClearSearch_Click" Content="{DynamicResource Str_ClearSearch}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource ListPaneBackgroundBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource IconUnlock}" Width="14" Height="14" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding VaultDisplayName}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{DynamicResource Str_Unlocked}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding VaultSaveStatus}" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <controls:ToastPresence x:Name="ToastCard" Padding="12" MinHeight="44" MaxWidth="380"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,0,16,40"
                    IsShown="{Binding IsToastVisible}" IsHitTestVisible="False">
                <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                    <PathIcon Classes="toastIcon" Classes.success="{Binding IsToastSuccess}" Classes.error="{Binding IsToastError}" />
                    <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" FontSize="14"
                               Foreground="{DynamicResource ToastForegroundBrush}" VerticalAlignment="Center" LineHeight="20"
                               TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Grid>
            </controls:ToastPresence>
        </Grid>
        <Grid x:Name="UnlockCurtain" Grid.RowSpan="2" IsVisible="False" Background="Transparent" ClipToBounds="True" Focusable="True"
              AutomationProperties.AccessibilityView="Raw">
            <Border x:Name="UnlockVeil" Background="{DynamicResource ListPaneBackgroundBrush}" Opacity="0" />
            <Grid x:Name="UnlockEmblem" Width="144" Height="144" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="UnlockHalo" Width="118" Height="118" Fill="{DynamicResource BadgePillBackgroundBrush}" Opacity="0" />
                <Ellipse x:Name="UnlockRing" Width="96" Height="96" Stroke="{DynamicResource AccentButtonBackgroundBrush}" StrokeThickness="1" Opacity="0" />
                <Border x:Name="UnlockEmblemTile" Width="44" Height="44" CornerRadius="8"
                        Background="{DynamicResource BadgePillBackgroundBrush}">
                    <Panel>
                        <PathIcon x:Name="UnlockClosedGlyph" Data="{StaticResource IconLock}" Width="20" Height="20"
                                  Foreground="{DynamicResource AccentTextBrush}" />
                        <PathIcon x:Name="UnlockOpenGlyph" Data="{StaticResource IconUnlock}" Width="20" Height="20" Opacity="0"
                                  Foreground="{DynamicResource AccentTextBrush}" />
                    </Panel>
                </Border>
            </Grid>
        </Grid>
        <Border x:Name="DialogSmoke" Grid.RowSpan="2" Background="#4D000000" IsVisible="False" IsHitTestVisible="False" />
    </Grid>
</Window>
