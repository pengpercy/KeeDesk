<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.VaultUnlockPromptWindow"
        Title="解锁待合并的密码库"
        Width="440" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid RowDefinitions="Auto, *, 1, Auto">
        <Border Grid.Row="0" Padding="24,36,24,10" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBar_PointerPressed">
            <StackPanel Spacing="4">
                <TextBlock x:Name="DialogHeading" Text="合并 / 同步其他密码库" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="FilePathLabel" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="12" Margin="24,6,24,16">
            <StackPanel Spacing="6">
                <TextBlock Text="目标密码库主密码" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox x:Name="PasswordBox" Height="36" PasswordChar="•" PlaceholderText="请输入目标密码库的主密码..." KeyDown="PasswordBox_KeyDown" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="密钥文件（可选）" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Grid ColumnDefinitions="*, 8, Auto">
                    <TextBox Grid.Column="0" x:Name="KeyFileBox" Height="34" IsReadOnly="True" PlaceholderText="未使用密钥文件" />
                    <Button Grid.Column="2" Height="34" Padding="12,0" Content="浏览..." Click="BrowseKeyFile_Click" />
                </Grid>
            </StackPanel>

            <CheckBox x:Name="UseWindowsUserAccountCheck" Content="使用 Windows 用户账户（DPAPI）" FontSize="12.5" IsVisible="False" />

            <ProgressBar x:Name="UnlockProgress" IsIndeterminate="True" Height="2"
                         Foreground="{DynamicResource AccentButtonBackgroundBrush}" IsVisible="False" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,12">
            <Button x:Name="CancelBtn" Width="84" Height="34" Content="取消" Click="Cancel_Click" />
            <Button x:Name="MergeBtn" Classes="accent" Height="34" Padding="16,0" Content="解密并合并" Click="Merge_Click" />
        </StackPanel>
    </Grid>
</Window>
