<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.VaultUnlockPromptWindow"
        Title="{DynamicResource Str_UnlockVaultToMerge}"
        Width="440" Height="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid RowDefinitions="Auto, *, 1, Auto">
        <Border Grid.Row="0" Padding="24,36,24,10" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBar_PointerPressed">
            <StackPanel Spacing="4">
                <TextBlock x:Name="DialogHeading" Text="{DynamicResource Str_MergeSyncAnotherVault2}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="FilePathLabel" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Spacing="12" Margin="24,6,24,16">
            <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Str_TargetVaultMasterPassword}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox x:Name="PasswordBox" Height="36" PasswordChar="•" PlaceholderText="{DynamicResource Str_EnterTheTargetVaultSMasterPassword}" KeyDown="PasswordBox_KeyDown" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Str_KeyFileOptional2}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Grid ColumnDefinitions="*, 8, Auto">
                    <TextBox Grid.Column="0" x:Name="KeyFileBox" Height="34" IsReadOnly="True" PlaceholderText="{DynamicResource Str_NoKeyFile}" />
                    <Button Grid.Column="2" Height="34" Padding="12,0" Content="{DynamicResource Str_Browse}" Click="BrowseKeyFile_Click" />
                </Grid>
            </StackPanel>

            <CheckBox x:Name="UseWindowsUserAccountCheck" Content="{DynamicResource Str_UseWindowsUserAccountDPAPI}" FontSize="12.5" IsVisible="False" />

            <ProgressBar x:Name="UnlockProgress" IsIndeterminate="True" Height="2"
                         Foreground="{DynamicResource AccentButtonBackgroundBrush}" IsVisible="False" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,12">
            <Button x:Name="CancelBtn" Width="84" Height="34" Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" />
            <Button x:Name="MergeBtn" Classes="accent" Height="34" Padding="16,0" Content="{DynamicResource Str_DecryptAndMerge}" Click="Merge_Click" />
        </StackPanel>
    </Grid>
</Window>
