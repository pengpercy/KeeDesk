<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.PasswordGeneratorWindow"
        Title="{DynamicResource Str_PasswordGenerator2}"
        Width="520" Height="570"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid RowDefinitions="Auto, *, 1, Auto">
        <Border Grid.Row="0" Padding="24,36,24,8" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBar_PointerPressed">
            <TextBlock Text="{DynamicResource Str_PasswordGenerator2}" FontSize="20" FontWeight="SemiBold" />
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,8,24,16">
        <StackPanel Spacing="12">
            <!-- 密码预览卡片 -->
            <Border Classes="fluentCard" Padding="18,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource Str_GeneratedPassword}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <SelectableTextBlock x:Name="PreviewText" FontFamily="Consolas,Menlo,monospace"
                                             FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="subtle chromeCommand" Click="Regenerate_Click"
                                ToolTip.Tip="{DynamicResource Str_Regenerate}" AutomationProperties.Name="{DynamicResource Str_Regenerate}">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*, 12, Auto">
                        <ProgressBar Grid.Column="0" x:Name="StrengthBar" Minimum="0" Maximum="1" Height="4" HorizontalAlignment="Stretch" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" x:Name="StrengthText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 模式切换 -->
            <TabControl Classes="compactTabs" x:Name="ModeTabs" SelectionChanged="ModeChanged">
                <TabItem Header="{DynamicResource Str_RandomPassword}">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{DynamicResource Str_PasswordLength}" VerticalAlignment="Center" FontSize="13.5" />
                            <TextBlock Grid.Column="1" x:Name="LengthLabel" Text="20" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />
                        </Grid>
                        <Slider x:Name="LengthSlider" Minimum="8" Maximum="64" Value="20" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderChanged" />
                        <UniformGrid Columns="2">
                            <CheckBox x:Name="UpperCheck" Content="{DynamicResource Str_UppercaseLettersAZ}" IsChecked="True" IsCheckedChanged="CheckChanged" />
                            <CheckBox x:Name="LowerCheck" Content="{DynamicResource Str_LowercaseLettersAZ}" IsChecked="True" IsCheckedChanged="CheckChanged" />
                            <CheckBox x:Name="DigitsCheck" Content="{DynamicResource Str_Digits09}" IsChecked="True" IsCheckedChanged="CheckChanged" />
                            <CheckBox x:Name="SpecialCheck" Content="{DynamicResource Str_Symbols}" IsChecked="True" IsCheckedChanged="CheckChanged" />
                        </UniformGrid>
                        <CheckBox x:Name="ExcludeLookAlikeCheck" Content="{DynamicResource Str_ExcludeAmbiguousCharacters0O1L}" IsChecked="True" IsCheckedChanged="CheckChanged" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{DynamicResource Str_Passphrase}">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="{DynamicResource Str_WordCount}" VerticalAlignment="Center" FontSize="13.5" />
                            <TextBlock Grid.Column="1" x:Name="WordCountLabel" Text="{DynamicResource Str_5Words}" FontWeight="SemiBold" />
                        </Grid>
                        <Slider x:Name="WordSlider" Minimum="3" Maximum="10" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderChanged" />
                        <CheckBox x:Name="CapWordsCheck" Content="{DynamicResource Str_CapitalizeFirstLetter}" IsChecked="True" IsCheckedChanged="CheckChanged" />
                        <CheckBox x:Name="AppendNumCheck" Content="{DynamicResource Str_AppendARandomNumber}" IsChecked="True" IsCheckedChanged="CheckChanged" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{DynamicResource Str_CustomPattern}">
                    <StackPanel Spacing="10" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource Str_PatternUUppercaseLLowercaseDDigit}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBox x:Name="PatternBox" Text="uullddss-uullddss" FontFamily="Consolas,Menlo,monospace" TextChanged="PatternChanged" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="{DynamicResource Str_BatchGeneration}">
                    <StackPanel Spacing="8" Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource Str_Generate10RandomPasswordsAtOnce}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" />
                        <TextBox x:Name="BatchListBox" Height="220" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas,Menlo,monospace" FontSize="12.5" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />

        <Border Grid.Row="3" Padding="24,18" Background="{DynamicResource CardSubtleBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="CancelButton" Width="106" Content="{DynamicResource Str_Close}" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="AcceptButton" Classes="accent" Width="130" Content="{DynamicResource Str_CopyPassword}" Click="Accept_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
