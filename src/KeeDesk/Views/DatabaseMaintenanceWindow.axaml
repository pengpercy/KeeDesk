<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.DatabaseMaintenanceWindow"
        Title="{DynamicResource Str_VaultMaintenance}"
        Width="580" Height="560"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="44"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid RowDefinitions="Auto, *, 1, Auto">
        <Border Grid.Row="0" Padding="24,38,24,10" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBar_PointerPressed">
            <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource Str_VaultMaintenance}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Str_CleanUpOldHistoryDuplicateEntriesEmpty}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="24,6,24,18">
            <StackPanel Spacing="14">
                <!-- 统计概览 -->
                <UniformGrid Columns="4" Rows="1">
                    <Border Classes="fluentCard" Padding="12" Margin="0,0,6,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource Str_TotalEntries}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="StatEntries" Text="0" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Classes="fluentCard" Padding="12" Margin="3,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource Str_HistorySnapshot}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="StatHistory" Text="0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandEmeraldBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="fluentCard" Padding="12" Margin="3,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource Str_DeletedItemRecords}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="StatDeleted" Text="0" FontSize="20" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <Border Classes="fluentCard" Padding="12" Margin="6,0,0,0">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{DynamicResource Str_AttachmentSize}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBlock x:Name="StatAttachments" Text="0 KB" FontSize="18" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 历史版本清理 -->
                <Border Classes="fluentCard" Padding="16,14">
                    <Grid ColumnDefinitions="*, 12, Auto">
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_RemoveOldHistorySnapshots}" FontSize="13.5" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_DeleteSnapshotsOlderThan}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                <NumericUpDown x:Name="HistoryDaysNum" Minimum="0" Maximum="3650" Value="365" FormatString="0" Width="100" Height="28" />
                                <TextBlock Text="{DynamicResource Str_Days0ClearsAllSnapshots}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Height="32" Padding="14,0" Content="{DynamicResource Str_CleanUpNow}" VerticalAlignment="Center" Click="PurgeHistory_Click" />
                    </Grid>
                </Border>

                <!-- 其他维护操作 -->
                <Border Classes="fluentCard" Padding="16,14">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_RemoveExactDuplicateEntries}" FontSize="13.5" FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource Str_KeepTheNewestEntryWhenTitleUsername}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Height="30" Padding="12,0" Content="{DynamicResource Str_ScanAndCleanUp}" Click="DeleteDuplicates_Click" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_RemoveEmptyGroups}" FontSize="13.5" FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource Str_RemoveGroupsWithNoEntriesOrSubgroups}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Height="30" Padding="12,0" Content="{DynamicResource Str_RemoveEmptyGroups}" Click="DeleteEmptyGroups_Click" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_ClearDeletedObjectMetadataDeletedObjects}" FontSize="13.5" FontWeight="Medium" />
                                <TextBlock Text="{DynamicResource Str_RemoveDeletionTrackingRecordsToReduceThe}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Height="30" Padding="12,0" Content="{DynamicResource Str_ClearRecords}" Click="ClearDeletedObjects_Click" />
                        </Grid>

                        <Border Height="1" Background="{DynamicResource DividerBrush}" />

                        <Grid ColumnDefinitions="*, Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str_RemoveUnusedCustomIcons}" FontSize="13.5" FontWeight="Medium" />
                                <TextBlock x:Name="UnusedIconsDesc" Text="{DynamicResource Str_RemoveCustomIconsUnusedByAnyEntry}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Height="30" Padding="12,0" Content="{DynamicResource Str_CleanUpIcons}" Click="DeleteUnusedIcons_Click" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="ResultText" FontSize="12.5" Foreground="{DynamicResource BrandEmeraldBrush}" IsVisible="False" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,12">
            <Button Classes="accent" Width="96" Height="34" Content="{DynamicResource Str_Done}" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
