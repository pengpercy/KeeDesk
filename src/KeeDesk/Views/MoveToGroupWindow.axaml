<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.MoveToGroupWindow"
        Title="{DynamicResource Str_MoveToGroup2}"
        Width="400" Height="440"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid RowDefinitions="Auto, *, 1, Auto">
        <Border Grid.Row="0" Padding="24,36,24,10" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBar_PointerPressed">
            <StackPanel Spacing="3">
                <TextBlock Text="{DynamicResource Str_MoveEntryToGroup}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="EntryTitleLabel" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <ListBox Grid.Row="1" x:Name="GroupListBox" Margin="18,4,18,14"
                 Background="{DynamicResource CardBackgroundBrush}"
                 BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8"
                 DoubleTapped="GroupListBox_DoubleTapped" />

        <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,12">
            <Button Width="84" Height="34" Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" />
            <Button Classes="accent" Height="34" Padding="16,0" Content="{DynamicResource Str_MoveToThisGroup}" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
