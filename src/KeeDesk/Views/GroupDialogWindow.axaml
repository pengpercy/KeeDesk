<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:Avalonia.Controls.Chrome;assembly=Avalonia.Controls"
        x:Class="KeeDesk.Views.GroupDialogWindow"
        Title="{DynamicResource Str_GroupSettings}"
        Width="420" Height="300"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full"
        ExtendClientAreaTitleBarHeightHint="40"
        Background="{DynamicResource WorkspaceBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Grid RowDefinitions="Auto, *, 1, Auto">
        <Border Grid.Row="0" Padding="24,36,24,10" Background="Transparent"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                PointerPressed="TitleBar_PointerPressed">
            <TextBlock x:Name="DialogHeading" Text="{DynamicResource Str_NewGroup}" FontSize="18" FontWeight="SemiBold" />
        </Border>

        <StackPanel Grid.Row="1" Spacing="12" Margin="24,4,24,16">
            <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Str_GroupName}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox x:Name="NameBox" Height="34" PlaceholderText="{DynamicResource Str_ExampleWorkAccountsCloudServers}" KeyDown="NameBox_KeyDown" />
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Text="{DynamicResource Str_NotesOptional}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox x:Name="NotesBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="{DynamicResource Str_DescribeThePurposeOfThisGroup}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" IsVisible="False" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource DividerBrush}" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="24,12">
            <Button Width="84" Height="34" Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" />
            <Button Classes="accent" Width="96" Height="34" Content="{DynamicResource Str_OK}" Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
