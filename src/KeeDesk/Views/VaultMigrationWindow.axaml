<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeeDesk.Views.VaultMigrationWindow"
        Title="{DynamicResource Str_MigrationImport}" Width="410" SizeToContent="Height"
        CanResize="False"
        Background="{DynamicResource WorkspaceBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <StackPanel Margin="22,18" Spacing="12">
        <TextBlock x:Name="SourceName" FontWeight="SemiBold" FontSize="16" />
        <TextBlock x:Name="Summary" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Height="34" IsCancel="True" Content="{DynamicResource Str_Cancel}" Click="Cancel_Click" />
            <Button Height="34" Classes="accent" IsDefault="True" Content="{DynamicResource Str_CsvConfirmImport}" Click="Import_Click" />
        </StackPanel>
    </StackPanel>
</Window>
