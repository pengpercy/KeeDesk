<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeeDesk.Views.AttachmentWindow"
        Title="{DynamicResource Str_AttachmentPreview}"
        Width="620" Height="440" MinWidth="400" MinHeight="300" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WorkspaceBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid RowDefinitions="Auto,*,Auto,1,Auto">
        <Grid Margin="20,16,20,12" ColumnDefinitions="32,*" ColumnSpacing="10">
            <Border Height="32" CornerRadius="6" Background="{DynamicResource CardSubtleBackgroundBrush}">
                <PathIcon Data="{StaticResource IconAttach}" Width="16" Height="16" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock x:Name="FileNameText" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FileSizeText" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>
        <Panel Grid.Row="1" Margin="20,0,20,12">
            <Border x:Name="ImagePanel" IsVisible="False" Classes="fluentCard" Padding="8">
                <Image x:Name="ImagePreview" Stretch="Uniform" StretchDirection="DownOnly" />
            </Border>
            <TextBox x:Name="TextPreview" IsVisible="False" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas, Menlo, monospace" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" TextChanged="TextPreview_Changed"
                     AutomationProperties.Name="{DynamicResource Str_AttachmentText}" />
            <TextBlock x:Name="StatusText" IsVisible="False" TextWrapping="Wrap" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
        </Panel>
        <TextBlock x:Name="EditErrorText" Grid.Row="2" Margin="20,0,20,12" IsVisible="False"
                   Text="{DynamicResource Str_AttachmentTextCannotEncode}" TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}" FontSize="12" />
        <Border Grid.Row="3" Background="{DynamicResource DividerBrush}" />
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20,12">
            <Button x:Name="CloseButton" Content="{DynamicResource Str_Close}" Height="34" Click="Close_Click" />
            <Button x:Name="CancelButton" IsVisible="False" Content="{DynamicResource Str_Cancel}" Height="34" Click="Close_Click" />
            <Button x:Name="EditButton" IsVisible="False" Height="34" Click="Edit_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconEdit}" Width="14" Height="14" />
                    <TextBlock Text="{DynamicResource Str_Edit}" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveButton" IsVisible="False" Height="34" Classes="accent" Click="Save_Click"
                    Content="{DynamicResource Str_Save}" />
        </StackPanel>
    </Grid>
</Window>
