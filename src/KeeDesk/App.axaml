                    <BoxShadows x:Key="PickerShadow">0 0 2 0 #1F000000, 0 8 16 0 #24000000</BoxShadows>
                    <SolidColorBrush x:Key="OptionCardSelectedBackgroundBrush" Color="#E8F0E8" />
