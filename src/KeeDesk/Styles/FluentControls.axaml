<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:KeeDesk.Controls">
    <!-- Entry cards own their hover, selected and focus visuals. -->
    <Styles.Resources>
        <ControlTheme x:Key="EntryCardListItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      TemplatedControl.IsTemplateFocusTarget="True"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
    <Style Selector="ListBox.entryList">
        <Setter Property="ItemContainerTheme" Value="{StaticResource EntryCardListItem}" />
    </Style>

    <Style Selector="TreeView.sidebarGroups TreeViewItem">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TreeView.sidebarGroups TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="TreeView.sidebarGroups TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
        <Setter Property="Margin" Value="8,0,6,0" />
    </Style>
    <Style Selector="TreeView.sidebarGroups TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBackgroundBrush}" />
    </Style>
    <Style Selector="TreeView.sidebarGroups TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBackgroundBrush}" />
    </Style>
    <Style Selector="TreeView.sidebarGroups TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource StandardButtonPressedBackgroundBrush}" />
    </Style>

    <!-- The popup owns the outer inset, so each rounded option can fill the available row. -->
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="{TemplateBinding MinHeight}" />
    </Style>
    <Style Selector="MenuItem:selected:not(:disabled) /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBackgroundBrush}" />
    </Style>
    <Style Selector="MenuItem:pressed:not(:disabled) /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource StandardButtonPressedBackgroundBrush}" />
    </Style>

    <Style Selector=":is(ComboBox) /template/ Rectangle#Pill">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ComboBoxItem">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="ComboBox:dropdownopen ComboBoxItem /template/ Border#LayoutRoot">
        <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover:not(:disabled) /template/ Border#LayoutRoot,
                     ComboBoxItem:selected:not(:disabled) /template/ Border#LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBackgroundBrush}" />
    </Style>
    <Style Selector="ComboBoxItem:pressed:not(:disabled) /template/ Border#LayoutRoot,
                     ComboBoxItem:selected:pointerover:not(:disabled) /template/ Border#LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource StandardButtonPressedBackgroundBrush}" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder, CalendarDatePicker[IsDropDownOpen=True] /template/ Border#PopupBorder">
        <Setter Property="Margin" Value="0" />
        <Setter Property="BackgroundSizing" Value="CenterBorder" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource FlyoutSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="{DynamicResource PickerShadow}" />
    </Style>
    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style Selector="ComboBox /template/ Popup#PART_Popup, CalendarDatePicker /template/ Popup#PART_Popup">
        <Setter Property="ShouldUseOverlayLayer" Value="True" />
    </Style>
    <Style Selector="CalendarDatePicker /template/ Popup#PART_Popup">
        <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
        <Setter Property="VerticalOffset" Value="4" />
    </Style>

    <Style Selector=":is(TextBox):focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}" />
    </Style>
    <Style Selector=":is(TextBox):focus:not(:error) /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
    </Style>
    <Style Selector="CalendarDatePicker:focus-within /template/ Border#Background">
        <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}" />
    </Style>
    <Style Selector="CalendarDatePicker:focus-within:not(:error) /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
    </Style>
    <Style Selector="ButtonSpinner:focus-within /template/ Border#BorderElement">
        <Setter Property="BorderThickness" Value="{TemplateBinding BorderThickness}" />
    </Style>
    <Style Selector="ButtonSpinner:focus-within:not(:error) /template/ Border#BorderElement">
        <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
    </Style>
    <Style Selector="controls|TextInputFocusIndicator">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundBrush}" />
    </Style>

    <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter,
                     Button.navItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:disabled PathIcon, ToggleButton.chipToggle:disabled PathIcon, MenuItem:disabled PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.chipToggle:disabled TextBlock, Button:disabled TextBlock.navLabel">
        <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.chipToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StandardButtonHoverBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StandardButtonHoverBorderBrush}" />
    </Style>
    <Style Selector="ToggleButton.chipToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StandardButtonPressedBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource StandardButtonPressedBorderBrush}" />
    </Style>
    <!-- WinUI Expander clips a vertical slide at the bottom of its header. -->
    <Style Selector="Expander:down:not(.disclosure)">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel MinWidth="{TemplateBinding MinWidth}" MaxWidth="{TemplateBinding MaxWidth}">
                    <ToggleButton x:Name="ExpanderHeader" MinHeight="{TemplateBinding MinHeight}"
                                  CornerRadius="{TemplateBinding CornerRadius}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                  Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                    <controls:ExpanderContentSlide IsExpanded="{TemplateBinding IsExpanded}">
                        <Border x:Name="ExpanderContent">
                            <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </controls:ExpanderContentSlide>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Expander:down:not(.disclosure) /template/ Border#ExpanderContent">
        <Setter Property="CornerRadius" Value="0,0,8,8" />
        <Setter Property="BorderThickness" Value="1,0,1,1" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:disabled /template/ Border#ToggleButtonBackground">
        <Setter Property="Background" Value="{DynamicResource ControlDisabledBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlDisabledBorderBrush}" />
    </Style>
    <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:disabled /template/ Border#ExpandCollapseChevronBorder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- WinUI applies elevation to the popup surface. Use Fluent 2 shadow16 for the shared cross-platform surface. -->
    <Style Selector="controls|PickerSurface">
        <Setter Property="Background" Value="{DynamicResource FlyoutSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BoxShadow" Value="{DynamicResource PickerShadow}" />
    </Style>
    <Style Selector="FlyoutPresenter.accentPalette">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Template">
            <ControlTemplate>
                <controls:PickerSurface x:Name="PaletteSurface" Padding="{TemplateBinding Padding}">
                    <ContentPresenter x:Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </controls:PickerSurface>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- The selection box caches item content, so observe localized labels directly. -->
    <Style Selector="ComboBox.localizedOptions /template/ ContentControl#ContentPresenter">
        <Setter Property="Content" Value="{CompiledBinding SelectedItem, RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter Property="ContentTemplate">
            <DataTemplate x:DataType="ComboBoxItem">
                <TextBlock Text="{CompiledBinding Content}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.compactTabs TabItem">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="TabControl.compactTabs TabItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="TabControl.compactTabs TabItem /template/ Border#PART_SelectedPipe">
        <Setter Property="Height" Value="3" />
        <Setter Property="CornerRadius" Value="1.5" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundBrush}" />
    </Style>
    <Style Selector="TabControl.compactTabs TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBackgroundBrush}" />
    </Style>
    <Style Selector="TabControl.compactTabs TabItem:pressed /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBackgroundBrush}" />
    </Style>
    <Style Selector="TabControl.compactTabs TabItem:disabled /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
    </Style>

    <!-- Fluent 2 transparent tabs keep the label centered above an overlaid indicator. -->
    <Style Selector="TabControl.auditTabs TabItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent" TemplatedControl.IsTemplateFocusTarget="True">
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontFamily="{TemplateBinding FontFamily}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                    <Border Name="SelectionIndicator" Height="3" CornerRadius="1.5"
                            Margin="{TemplateBinding Padding}" VerticalAlignment="Bottom"
                            IsHitTestVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.auditTabs TabItem:pointerover:not(:disabled), TabControl.auditTabs TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="TabControl.auditTabs TabItem:selected">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabControl.auditTabs TabItem:pointerover:not(:selected):not(:disabled) /template/ Border#SelectionIndicator">
        <Setter Property="Background" Value="{DynamicResource StandardButtonBorderBrush}" />
    </Style>
    <Style Selector="TabControl.auditTabs TabItem:selected /template/ Border#SelectionIndicator">
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundBrush}" />
    </Style>
    <Style Selector="TabControl.auditTabs TabItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
    </Style>
    <Style Selector="TabControl.auditTabs TabItem:selected:disabled /template/ Border#SelectionIndicator">
        <Setter Property="Background" Value="{DynamicResource ControlDisabledForegroundBrush}" />
    </Style>

    <Style Selector="ListBox:not(.entryList) ListBoxItem">
        <Setter Property="MinHeight" Value="{DynamicResource DensityControlHeight}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox:not(.entryList) ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource EntryRowHoverBackgroundBrush}" />
    </Style>
    <Style Selector="ListBox:not(.entryList) ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox:not(.entryList) ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource EntryRowSelectedBackgroundBrush}" />
    </Style>
    <Style Selector="ListBox:not(.entryList) ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter,
                     ListBox:not(.entryList) ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource StandardButtonPressedBackgroundBrush}" />
    </Style>
    <Style Selector="ListBox.entryList ListBoxItem:pressed Border.entryCard">
        <Setter Property="Background" Value="{DynamicResource EntryRowSelectedBackgroundBrush}" />
    </Style>
    <Style Selector="ListBox.entryList ListBoxItem:selected:pointerover Border.entryCard,
                     ListBox.entryList ListBoxItem:selected:pressed Border.entryCard">
        <Setter Property="Background" Value="{DynamicResource StandardButtonPressedBackgroundBrush}" />
    </Style>
    <Style Selector="ListBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ControlDisabledForegroundBrush}" />
    </Style>

    <Style Selector="Border.windowsSubmenuShadow">
        <Setter Property="BackgroundSizing" Value="CenterBorder" />
        <Setter Property="BoxShadow" Value="{DynamicResource PickerShadow}" />
    </Style>
    <Style Selector="Border.nativeSubmenuShadow">
        <!-- Avalonia positions the menu by its surface and adds the margin outside it. -->
        <Setter Property="Margin" Value="24,16,24,32" />
    </Style>
</Styles>
