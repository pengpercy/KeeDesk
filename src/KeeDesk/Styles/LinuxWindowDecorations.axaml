<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Avalonia.Controls.Chrome">
    <ControlTheme x:Key="LinuxCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource LinuxCaptionButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="(chrome:WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="CaptionFace"
                                  Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center">
                    <ContentPresenter.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.12" />
                        </Transitions>
                    </ContentPresenter.Transitions>
                </ContentPresenter>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="LinuxCaptionOnRight" TargetType="chrome:WindowDrawnDecorations">
        <Setter Property="DefaultTitleBarHeight" Value="40" />
        <!-- Avalonia uses the frame thickness for hit testing the resize grips. -->
        <Setter Property="DefaultFrameThickness" Value="5" />
        <Setter Property="DefaultShadowThickness" Value="0" />
        <Setter Property="Template">
            <WindowDrawnDecorationsTemplate>
                <chrome:WindowDrawnDecorationsContent>
                    <chrome:WindowDrawnDecorationsContent.Underlay>
                        <Panel x:Name="ChromeUnderlay">
                            <Panel x:Name="PART_TitleBar" VerticalAlignment="Top" Background="Transparent"
                                   Height="{TemplateBinding TitleBarHeight}" IsVisible="{TemplateBinding HasTitleBar}"
                                   chrome:WindowDecorationProperties.ElementRole="TitleBar" />
                        </Panel>
                    </chrome:WindowDrawnDecorationsContent.Underlay>
                    <chrome:WindowDrawnDecorationsContent.Overlay>
                        <Panel x:Name="ChromeOverlay">
                            <DockPanel x:Name="CaptionButtons" VerticalAlignment="Top"
                                       Height="{TemplateBinding TitleBarHeight}" IsVisible="{TemplateBinding HasTitleBar}"
                                       LastChildFill="False">
                                <Button x:Name="PART_CloseButton" Classes="linuxCaption"
                                        Theme="{StaticResource LinuxCaptionButton}" ToolTip.Tip="{DynamicResource Str_Close}"
                                        AutomationProperties.Name="{DynamicResource Str_Close}"
                                        chrome:WindowDecorationProperties.ElementRole="CloseButton">
                                    <Path Data="M 1.5,1.5 L 8.5,8.5 M 8.5,1.5 L 1.5,8.5" />
                                </Button>
                                <Button x:Name="PART_MinimizeButton" Classes="linuxCaption"
                                        Theme="{StaticResource LinuxCaptionButton}" ToolTip.Tip="{DynamicResource Str_Minimize}"
                                        AutomationProperties.Name="{DynamicResource Str_Minimize}"
                                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
                                    <Path Data="M 1.5,5.25 L 8.5,5.25" />
                                </Button>
                                <Button x:Name="PART_MaximizeButton" Classes="linuxCaption"
                                        Theme="{StaticResource LinuxCaptionButton}" ToolTip.Tip="{DynamicResource Str_Maximize}"
                                        AutomationProperties.Name="{DynamicResource Str_Maximize}"
                                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
                                    <Path x:Name="MaximizeGlyph"
                                          Data="M 2.2,1.5 H 7.8 A 0.7,0.7 0 0 1 8.5,2.2 V 7.8 A 0.7,0.7 0 0 1 7.8,8.5 H 2.2 A 0.7,0.7 0 0 1 1.5,7.8 V 2.2 A 0.7,0.7 0 0 1 2.2,1.5 Z" />
                                </Button>
                            </DockPanel>
                        </Panel>
                    </chrome:WindowDrawnDecorationsContent.Overlay>
                </chrome:WindowDrawnDecorationsContent>
            </WindowDrawnDecorationsTemplate>
        </Setter>
        <Style Selector="^ /template/ Button.linuxCaption">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption Path">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Stretch" Value="None" />
            <Setter Property="Stroke" Value="{DynamicResource LinuxCaptionGlyphBrush}" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="^ /template/ DockPanel#CaptionButtons">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MinimizeButton">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MaximizeButton">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption:pointerover">
            <Setter Property="Background" Value="{DynamicResource LinuxCaptionButtonHoverBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption:pressed">
            <Setter Property="Background" Value="{DynamicResource LinuxCaptionButtonPressedBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlFocusBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource LinuxCaptionCloseHoverBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton:pressed">
            <Setter Property="Background" Value="{DynamicResource LinuxCaptionClosePressedBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton:pointerover Path, ^ /template/ Button#PART_CloseButton:pressed Path">
            <Setter Property="Stroke" Value="White" />
        </Style>
        <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton, ^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:maximized /template/ Button#PART_MaximizeButton">
            <Setter Property="ToolTip.Tip" Value="{DynamicResource Str_Restore}" />
            <Setter Property="AutomationProperties.Name" Value="{DynamicResource Str_Restore}" />
        </Style>
        <Style Selector="^:maximized /template/ Path#MaximizeGlyph">
            <Setter Property="Data" Value="M 1.5,3.7 A 0.7,0.7 0 0 1 2.2,3 H 6.3 A 0.7,0.7 0 0 1 7,3.7 V 7.8 A 0.7,0.7 0 0 1 6.3,8.5 H 2.2 A 0.7,0.7 0 0 1 1.5,7.8 Z M 3.2,3 V 2.2 A 0.7,0.7 0 0 1 3.9,1.5 H 7.8 A 0.7,0.7 0 0 1 8.5,2.2 V 6.1 A 0.7,0.7 0 0 1 7.8,6.8 H 7" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="LinuxCaptionOnLeft" TargetType="chrome:WindowDrawnDecorations"
                  BasedOn="{StaticResource LinuxCaptionOnRight}">
        <Style Selector="^ /template/ DockPanel#CaptionButtons">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MinimizeButton">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Margin" Value="0,0,7,0" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MaximizeButton">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </ControlTheme>

    <Styles x:Key="LinuxWindowChromeStyles">
        <Style Selector="Window">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <Border Name="PART_TransparencyFallback" IsHitTestVisible="False" />
                        <Border x:Name="PART_LinuxWindowFrame"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                ClipToBounds="True">
                            <Panel>
                                <Panel Background="Transparent" Margin="{TemplateBinding WindowDecorationMargin}" />
                                <VisualLayerManager Name="PART_VisualLayerManager">
                                    <ContentPresenter Name="PART_ContentPresenter"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      Content="{TemplateBinding Content}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </VisualLayerManager>
                            </Panel>
                        </Border>
                        <Border x:Name="PART_LinuxWindowOutline"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Window.linuxCsd /template/ Border#PART_LinuxWindowOutline">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Window.linuxCsd:maximized /template/ Border#PART_LinuxWindowOutline,
                         Window.linuxCsd:fullscreen /template/ Border#PART_LinuxWindowOutline">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Styles>
</ResourceDictionary>
