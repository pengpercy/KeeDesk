<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Avalonia.Controls.Chrome">
    <ControlTheme x:Key="LinuxCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="(chrome:WindowDecorationProperties.ElementRole)" Value="DecorationsElement" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter x:Name="CaptionFace"
                                  Background="{TemplateBinding Background}"
                                  Foreground="{TemplateBinding Foreground}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Content="{TemplateBinding Content}"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="LinuxCaptionOnRight" TargetType="chrome:WindowDrawnDecorations">
        <Setter Property="DefaultTitleBarHeight" Value="40" />
        <Setter Property="DefaultFrameThickness" Value="1" />
        <Setter Property="DefaultShadowThickness" Value="8" />
        <Setter Property="Template">
            <WindowDrawnDecorationsTemplate>
                <chrome:WindowDrawnDecorationsContent>
                    <chrome:WindowDrawnDecorationsContent.Underlay>
                        <Panel x:Name="ChromeUnderlay">
                            <Border x:Name="ChromeFrame" BorderThickness="{TemplateBinding FrameThickness}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" IsHitTestVisible="False" />
                            <Panel x:Name="PART_TitleBar" VerticalAlignment="Top" Background="Transparent"
                                   Height="{TemplateBinding TitleBarHeight}" IsVisible="{TemplateBinding HasTitleBar}"
                                   chrome:WindowDecorationProperties.ElementRole="TitleBar" />
                        </Panel>
                    </chrome:WindowDrawnDecorationsContent.Underlay>
                    <chrome:WindowDrawnDecorationsContent.Overlay>
                        <Panel x:Name="ChromeOverlay">
                            <DockPanel x:Name="CaptionButtons" VerticalAlignment="Top"
                                       Height="{TemplateBinding TitleBarHeight}" IsVisible="{TemplateBinding HasTitleBar}"
                                       LastChildFill="False">
                                <Button x:Name="PART_CloseButton" Classes="linuxCaption"
                                        Theme="{StaticResource LinuxCaptionButton}" ToolTip.Tip="关闭"
                                        chrome:WindowDecorationProperties.ElementRole="CloseButton">
                                    <PathIcon Data="M1,0 L5,4 9,0 10,1 6,5 10,9 9,10 5,6 1,10 0,9 4,5 0,1 Z" />
                                </Button>
                                <Button x:Name="PART_MinimizeButton" Classes="linuxCaption"
                                        Theme="{StaticResource LinuxCaptionButton}" ToolTip.Tip="最小化"
                                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
                                    <PathIcon Data="M0,4.5 H10 V5.5 H0 Z" />
                                </Button>
                                <Button x:Name="PART_MaximizeButton" Classes="linuxCaption"
                                        Theme="{StaticResource LinuxCaptionButton}" ToolTip.Tip="最大化"
                                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
                                    <PathIcon x:Name="MaximizeGlyph" Data="M0,0 H10 V10 H0 Z M1,1 V9 H9 V1 Z" />
                                </Button>
                            </DockPanel>
                        </Panel>
                    </chrome:WindowDrawnDecorationsContent.Overlay>
                </chrome:WindowDrawnDecorationsContent>
            </WindowDrawnDecorationsTemplate>
        </Setter>
        <Style Selector="^:has-shadow /template/ Panel#ChromeUnderlay, ^:has-shadow /template/ Panel#ChromeOverlay">
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style Selector="^:has-shadow /template/ Border#ChromeFrame">
            <Setter Property="BoxShadow" Value="0 2 10 2 #80000000" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="^ /template/ DockPanel#CaptionButtons">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton">
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <Style Selector="^ /template/ PathIcon">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarItemHoverBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption:pressed">
            <Setter Property="Background" Value="{DynamicResource SidebarItemSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton:pointerover">
            <Setter Property="Background" Value="#E81123" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="^:not(:has-minimize) /template/ Button#PART_MinimizeButton, ^:not(:has-maximize) /template/ Button#PART_MaximizeButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:maximized /template/ Button#PART_MaximizeButton">
            <Setter Property="ToolTip.Tip" Value="还原" />
        </Style>
        <Style Selector="^:maximized /template/ PathIcon#MaximizeGlyph">
            <Setter Property="Data" Value="M2,0 H10 V8 H8 V10 H0 V2 H2 Z M3,1 V2 H8 V7 H9 V1 Z M1,3 V9 H7 V3 Z" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="LinuxCaptionOnLeft" TargetType="chrome:WindowDrawnDecorations"
                  BasedOn="{StaticResource LinuxCaptionOnRight}">
        <Style Selector="^ /template/ DockPanel#CaptionButtons">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Foreground" Value="#66000000" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Background" Value="#FF6159" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MinimizeButton">
            <Setter Property="Background" Value="#FFBD2E" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MaximizeButton">
            <Setter Property="Background" Value="#28C840" />
        </Style>
        <Style Selector="^ /template/ PathIcon">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
        </Style>
        <Style Selector="^ /template/ Button.linuxCaption:pointerover">
            <Setter Property="Foreground" Value="#66000000" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>
        <Style Selector="^ /template/ Button#PART_CloseButton:pointerover, ^ /template/ Button#PART_CloseButton:pressed">
            <Setter Property="Background" Value="#FF6159" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MinimizeButton:pointerover, ^ /template/ Button#PART_MinimizeButton:pressed">
            <Setter Property="Background" Value="#FFBD2E" />
        </Style>
        <Style Selector="^ /template/ Button#PART_MaximizeButton:pointerover, ^ /template/ Button#PART_MaximizeButton:pressed">
            <Setter Property="Background" Value="#28C840" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
