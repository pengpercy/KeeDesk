<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="using:Avalonia.Controls.Chrome">
    <Styles x:Key="WindowsWindowDecorations">
        <Style Selector="chrome|WindowDrawnDecorations:has-titlebar /template/ StackPanel#PART_OverlayPanel">
            <Setter Property="Spacing" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="chrome|WindowDrawnDecorations /template/ Button#PART_MinimizeButton,
                         chrome|WindowDrawnDecorations /template/ Button#PART_MaximizeButton,
                         chrome|WindowDrawnDecorations /template/ Button#PART_CloseButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="MinWidth" Value="46" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="chrome|WindowDrawnDecorations /template/ Button#PART_CloseButton">
            <Setter Property="Width" Value="47" />
            <Setter Property="MinWidth" Value="47" />
        </Style>

        <!-- Override the app-wide button states on the caption button's presenter. -->
        <Style Selector="Button#PART_CloseButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C" />
        </Style>
        <Style Selector="Button#PART_CloseButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A4261E" />
        </Style>
        <Style Selector="Button#PART_CloseButton:pointerover Path, Button#PART_CloseButton:pressed Path">
            <Setter Property="Fill" Value="White" />
        </Style>

        <!-- KeeDesk renders its own title in each window. -->
        <Style Selector="chrome|WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="chrome|WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Styles>
</ResourceDictionary>
